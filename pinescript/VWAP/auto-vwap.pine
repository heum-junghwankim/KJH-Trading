//@version=6
// explicit_plot_zorder=true: plot()/hline()/fill()의 z-order를 코드 "선언 순서"로 고정(먼저 선언=뒤, 나중 선언=앞). VWMA 50/100/200+fill을 나머지 plot보다 뒤로 두는 근거.
//  ⚠️ 기존 코드도 이미 "나중 선언=앞" 기본 거동에 부합하게 선언돼 있어(밴드1→밴드2→정역배열 fill→리본) 이 인자는 그 상대 순서를 명시 고정할 뿐 기존 z를 바꾸지 않는다.
//  ⚠️ 비정상 매수/매도는 이제 barcolor(캔들 몸통색)로 표시한다(CEO 지시 — 배경 bgcolor → barcolor 전환). barcolor는 이 인자와 무관하게 봉 몸통색을 바꾸며 밴드 fill과 레이어가 달라 공존한다.
//     (과거엔 비정상을 bgcolor 전체 화면 배경으로 칠했으나 CEO 지시로 캔들 몸통색 오버라이드로 이관 — 아래 "비정상 매수/매도 — 캔들 몸통색(barcolor)" 참조.)
//     plotshape/드로잉(label/table)은 이 인자 영향 밖(각자 상위 그룹 최전면 유지).
// behind_chart=true: 이 스크립트의 모든 시각 요소(plot/fill/bgcolor/plotshape/label/table)를 메인 캔들(차트 시리즈) 뒤에 그린다(CEO 지시 2026-10-16 — Sonar 배경을 캔들 뒤로).
//  ⚠️ 공식 문서상 기본값이 이미 true라 새로 추가한 인스턴스의 거동은 같고, 이 인자는 의도를 명시 고정한다. 스크립트 단위 설정이라 fill 하나만 골라 뒤로 보낼 수는 없다.
//  ⚠️ 선언부 시각 설정은 차트에 처음 로드될 때 한 번만 평가된다 → 이미 올려둔 인스턴스는 지표를 삭제 후 다시 추가하거나 상태줄 "More(⋯) > Visual order"에서 뒤로 보내야 반영된다.
//  ⚠️ explicit_plot_zorder와 충돌 없음: 그쪽은 스크립트 내부 plot/hline/fill 상호 순서, behind_chart는 스크립트 전체 ↔ 캔들 간 순서(서로 다른 축).
indicator(title="Auto VWAP", shorttitle="Auto VWAP", overlay=true, max_bars_back=1000, explicit_plot_zorder=true, behind_chart=true)

// VWAP 중앙선 표시 토글(CEO 지시 — 기본 ON). 켜면 pane에 VWAP 중앙선을 그리고(밴드2와 동일 1px·점선), 끄면 선을 숨긴다(값·색·계산 불변).
//  ▸ 밴드2(showBand_2)와 동일 패턴: display = 켜짐 ? (display.all − display.price_scale) : display.none. 흰색 가격축 라벨은 이 토글과 독립(항상 price_scale에만 표시).
showVwapLine = input.bool(true, title="VWAP 중앙선 표시", group="VWAP Settings", display=display.none, tooltip="켜면 화면 VWAP 중앙선을 차트에 그립니다(기본 ON). 스타일은 밴드2선과 동일하게 굵기 1px·점선(dashed)입니다. 선 색은 CEO 지시로 고정 단색(중립 흰색)입니다 — 지지/저항 판정에 따라 변색하지 않습니다. 끄면 선만 숨기며 VWAP 값·계산·우측 가격축 흰색 라벨에는 영향이 없습니다.")
hideonDWM = input(false, title="Hide VWAP on 1D or Above", group="VWAP Settings", display=display.none)
// VWAP 누적은 "최근 N봉 롤링(Recent Bars)" 단일 방식으로 고정(CEO 지시 — 앵커모드 제거). 세션/거래일 앵커 분기·입력·세션 리셋 전부 삭제됨.
//  ▸ 정합성: 원본 이치모쿠의 vwap상태(20)는 앵커 무관 Recent Bars 고정이 정답. 전 VWAP(화면 50봉·vwap상태20·중기추세 vwapValue·지지저항)이 Recent Bars 단일로 계산된다.
// 기본 화면용 VWAP window 길이(= Recent Bars 롤링 길이). CEO 지시: 기본 화면 VWAP 기본값 50.
recentBars = input.int(defval=50, title="Recent Bars (기본 화면 VWAP)", minval=1, group="VWAP Settings", display=display.none)
src = input(title="Source", defval=hlc3, group="VWAP Settings", display=display.none)
offset = input.int(0, title="Offset", group="VWAP Settings", display=display.none)
enableDynamicLineColor = input.bool(false, title="Enable Dynamic Line Color", group="VWAP Settings", display=display.none)
// VWAP 중앙선 지지/저항 색 규칙(CEO 확정 — near 구간 종가 + 꼬리 걸침 이탈). ⚠️ 단, CEO 지시로 VWAP 선 색은 현재 고정 단색(중립 흰색)이라 이 판정은 선 색에 반영되지 않는다(로직·상태 보존용). 아래는 판정 규칙 서술.
//  "near 구간" = VWAP와 밴드1 사이의 **동적 %(pct) 범위**(밴드1 전체가 아님). 하단 near=[lowerNear, vwap], 상단 near=[vwap, upperNear].
//   ▸ upperNear = vwap + pct×(upperBand1 − vwap),  lowerNear = vwap − pct×(vwap − lowerBand1). 하단 near 최저=lowerNear, 상단 near 최고=upperNear.
//   ▸ pct = 밴드폭 반비례 동적(좁을 때 최대 0.60, 넓을 때 최소 0.20). r=(upperBand1−lowerBand1)/vwap 를 rLow~rHigh 사이 정규화 후 max~min 반비례 보간·clamp. (계산부는 vwapSRColor 블록 참조)
//  ▸ 저항(빨강, UPPER_BREAK_LINE_COLOR) = ① lowerNear ≤ close ≤ vwap  OR  ② close < lowerNear AND high > lowerNear(종가 하단 near 이탈+고가 꼬리 걸침).
//  ▸ 지지(녹, LOWER_BREAK_LINE_COLOR)   = ③ vwap ≤ close ≤ upperNear  OR  ④ close > upperNear AND low < upperNear(종가 상단 near 이탈+저가 꼬리 걸침).
//  ▸ 그 외(완전 이탈: close 가 near 구간 밖 + 꼬리도 near 미접촉 / na 워밍업) → 중립(흰, DEFAULT_LINE_COLOR).
//  ★ close==vwap은 ①③ 양쪽에 걸리므로 저항을 먼저 평가 → 저항(빨강)으로 확정. 부동소수라 실제 동일값은 드묾.
//  na/밴드1 유효성 가드(shouldPlot·not na(vwap/upperBand1/lowerBand1))가 워밍업·도지 방어. 모두 확정봉 세트값(close/high/low/vwap/밴드1·near) → 리페인팅 없음.
//  enableDynamicLineColor(밴드2 이탈 녹/빨강)와 독립한 별도 VWAP 선 전용 색이다.
enableVwapSRColor = input.bool(true, title="VWAP 선 지지/저항 색 판정(내부 상태 — 선 색 미반영)", group="VWAP Settings", tooltip="⚠️ CEO 지시로 VWAP 중앙선 색은 고정 단색(중립 흰색)으로 전환되어, 이 옵션은 더 이상 선 색에 영향을 주지 않습니다(판정 로직·상태 boolean 보존용으로만 유지). 판정 규칙(참고): 구간=VWAP와 밴드1 사이의 동적 near 범위(아래 '근처 구간 %' 참고). 하단 near 최저=lowerNear, 상단 near 최고=upperNear. 저항=lowerNear≤종가≤VWAP(①), 또는 종가가 lowerNear 아래로 이탈했지만 고가가 lowerNear 위(② 꼬리 걸침). 지지=VWAP≤종가≤upperNear(③), 또는 종가가 upperNear 위로 이탈했지만 저가가 upperNear 아래(④ 꼬리 걸침). 종가=VWAP 경계는 저항으로 처리. 향후 이 판정을 다른 표시에 재사용할 수 있도록 계산은 남겨 둡니다.")
// VWAP 선색 "근처(near) 구간" 동적 % — 저항/지지 판정 구간을 밴드1 전체가 아니라 VWAP~밴드1의 일부(pct)로 좁힌다(CEO 지시).
//  상단 구간 최고 = upperNear = vwap + pct×(upperBand1 − vwap), 하단 구간 최저 = lowerNear = vwap − pct×(vwap − lowerBand1). 저항(하단)·지지(상단) 동일 pct 대칭.
//  ▸ pct = 밴드폭 반비례 동적 %: 밴드폭 좁음(저변동성)→최대 %(기본 60), 밴드폭 넓음(고변동성)→최소 %(기본 20).
//  ▸ 정규화: r = (upperBand1 − lowerBand1) / vwap (가격 대비 밴드1 폭 비율, 종목·가격 무관). r을 rLow~rHigh 사이에서 정규화 후 max~min으로 반비례 선형보간·clamp.
//  ▸ 임계 기본값: rLow=0.5%(저변동성 하단)·rHigh=2.0%(고변동성 상단) — 세션 VWAP 밴드1(≈1σ×배수) 통상 폭. 과최적화 경계상 라운드넘버.
vwapNearMinPct = input.float(20.0, title="VWAP 근처 구간 최소 %(넓을 때)", minval=0.0, maxval=100.0, step=1.0, group="VWAP Settings", active=enableVwapSRColor, display=display.none, tooltip="밴드폭이 넓을 때(고변동성) 적용할 근처 구간 비율의 최소 %. 밴드1폭/VWAP 비율이 '고변동성 임계' 이상이면 이 값으로 수렴합니다. 근처 구간이 VWAP 바로 옆으로 좁아집니다. 기본 20.")
vwapNearMaxPct = input.float(60.0, title="VWAP 근처 구간 최대 %(좁을 때)", minval=0.0, maxval=100.0, step=1.0, group="VWAP Settings", active=enableVwapSRColor, display=display.none, tooltip="밴드폭이 좁을 때(저변동성) 적용할 근처 구간 비율의 최대 %. 밴드1폭/VWAP 비율이 '저변동성 임계' 이하이면 이 값으로 수렴합니다. 기본 60. 근처 %는 이 값과 최소 % 사이에서 밴드폭에 반비례로 결정됩니다.")
vwapNearRLowPct = input.float(0.5, title="근처 % 저변동성 임계(밴드1폭/VWAP, %)", minval=0.0, step=0.1, group="VWAP Settings", active=enableVwapSRColor, display=display.none, tooltip="밴드1 폭 ÷ VWAP 비율(%)이 이 값 이하이면 저변동성으로 보고 근처 %를 최대(기본 60)로 씁니다. 기본 0.5%(=밴드1 폭이 가격의 0.5% 이하일 때 저변동성). 세션 VWAP 밴드1(≈1σ×배수) 통상 하단.")
vwapNearRHighPct = input.float(2.0, title="근처 % 고변동성 임계(밴드1폭/VWAP, %)", minval=0.0, step=0.1, group="VWAP Settings", active=enableVwapSRColor, display=display.none, tooltip="밴드1 폭 ÷ VWAP 비율(%)이 이 값 이상이면 고변동성으로 보고 근처 %를 최소(기본 20)로 씁니다. 기본 2.0%. 저변동성 임계와 이 값 사이는 선형보간합니다(반비례). 저변동성 임계보다 커야 합니다.")
showBandPctLabels = input.bool(true, title="VWAP·밴드 간격 % 라벨 표시", group="VWAP Settings")

BANDS_GROUP = "Bands Settings"
CALC_MODE_TOOLTIP = "Determines how band distance is calculated. Log Standard Deviation uses volume-weighted log-price volatility, and Absolute Standard Deviation uses price units."
calcModeInput = input.string("Log Standard Deviation", "Bands Calculation Mode", options=["Log Standard Deviation", "Absolute Standard Deviation"], group=BANDS_GROUP, tooltip=CALC_MODE_TOOLTIP, display=display.none)
showBand_1 = input(true, title="", group=BANDS_GROUP, inline="band_1", display=display.none)
bandMult_1 = input.float(1.0, title="Bands Multiplier #1", group=BANDS_GROUP, inline="band_1", step=0.5, minval=0, display=display.none, active=showBand_1)
showBand_2 = input(true, title="", group=BANDS_GROUP, inline="band_2", display=display.none)
bandMult_2 = input.float(2.0, title="Bands Multiplier #2", group=BANDS_GROUP, inline="band_2", step=0.5, minval=0, display=display.none, active=showBand_2)

// =========================
// 거래량 가중 이동평균선(VWMA 50/100/200) + 테이블 — SUPER-ICHIMOKU(advanced-ichimoku.pine)에서 이식(포팅).
//  ▸ 페인팅: 거래량 가중 50/100/200선(각 2px) + 100선~200선 사이 fill. 산식은 원본과 동일(ta.vwma·f_ltMa switch).
//     ⚠️ 텐칸·기준·후행 등 다른 이치모쿠 페인팅은 이식하지 않는다(지시 6번).
//     ⚠️ 50선 색: 원본은 노랑(#FFEB3B)이나 auto-vwap 리본 EMA(노랑)와 겹치므로, 리본(노랑/하늘/분홍)·100선(파랑)·200선(보라)·
//        신호색(녹/빨강)·비정상 배경(파랑/주황)과 확실히 구분되는 딥 오렌지(#FF6D00)로 변경(CEO 지시 6번). input.color로 노출.
//  ▸ 테이블(우측 상단): 추세 확인(단기/중기/장기 3행) / 추세 전환가(TEMA 전환·DEMA 전환·정배열 전환·역배열 전환·T/D 전환 — 다음 봉 종가 기준 전환가 P*) /
//     변동성 임계가(밴드 상단/하단 + 이격도/되돌림) / 지지·저항 임계가(50선/100선/200선 지지·저항). 판정식은 원본 로직 그대로 이식(확정봉·오프셋 불변).
// =========================
VWMA_GROUP = "거래량 가중선(VWMA)"
ltMaType = input.string("VWMA", title="장기선 MA 종류(100/200)", options=["SMA", "EMA", "WMA", "VWMA"], group=VWMA_GROUP, tooltip="장기선(100/200) 이동평균 종류. 기본 VWMA(거래량 가중). 원본(advanced-ichimoku.pine)과 동일. 50선은 항상 VWMA(ta.vwma).")
ltLen1 = input.int(100, minval=1, title="장기선 MA #1 길이(100)", group=VWMA_GROUP, tooltip="장기선 #1 길이. 기본 100. 전략성 파라미터(수학자 리뷰 대상).")
ltLen2 = input.int(200, minval=1, title="장기선 MA #2 길이(200)", group=VWMA_GROUP, tooltip="장기선 #2 길이. 기본 200. 전략성 파라미터(수학자 리뷰 대상).")
showVwma50 = input.bool(true, title="거래량 가중 50선", group=VWMA_GROUP, tooltip="거래량 가중 50선(VWMA 50)을 딥 오렌지로 표시합니다(2px). 기본 ON. 단기 추세(20선 vs 50선) 행의 느린 선입니다.")
vwma50Color = input.color(#FF6D00, title="거래량 가중 50선 색", group=VWMA_GROUP, active=showVwma50, tooltip="거래량 가중 50선 색. 리본 EMA(노랑)와 겹치지 않도록 딥 오렌지(#FF6D00) 기본. 리본/장기선/신호색/비정상 배경과 구분됩니다.")
showLongTrend = input.bool(true, title="장기선 100/200 표시", group=VWMA_GROUP, tooltip="거래량 가중 100선·200선(각 2px)과 그 사이 fill을 표시합니다. 기본 ON.")
ltColor1 = input.color(color.blue, title="100선 색", group=VWMA_GROUP, active=showLongTrend, tooltip="거래량 가중 100선 색. 기본 파랑(원본 동일).")
ltColor2 = input.color(color.purple, title="200선 색", group=VWMA_GROUP, active=showLongTrend, tooltip="거래량 가중 200선 색. 기본 보라(원본 동일).")
ltFillTransp = input.int(75, minval=0, maxval=100, title="100~200선 fill 투명도", group=VWMA_GROUP, active=showLongTrend, tooltip="100선~200선 사이 fill 투명도(0=불투명, 100=완전 투명). 기본 75. 색은 100선>200선이면 100선 색, 아니면 200선 색.")
// 테이블 표시 토글
TABLE_GROUP = "상태 테이블"
showStatusTable = input.bool(true, title="상태 테이블 표시(우측 상단)", group=TABLE_GROUP, tooltip="우측 상단 상태 테이블(추세 확인 / 추세 전환가 / 변동성 임계가 / 지지·저항 임계가)을 표시합니다. SUPER-ICHIMOKU 테이블 이식.")
entryBase = input.string("완성봉", title="추세 진입 기준봉", options=["실시간봉", "완성봉"], group=TABLE_GROUP, active=showStatusTable, tooltip="상태 테이블 '추세 전환가' 5행(TEMA/DEMA/정배열/역배열/T/D 전환가)의 기준봉입니다(cRSI '테이블 기준봉'과 같은 의미).\n완성봉(기본): 가장 최근 완성봉 기준(형성 중=직전봉, 마감된 마지막 봉·바 리플레이=그 봉). 형성 중 봉의 틱 변동에 값이 고정되고(리페인팅 없음), 가격은 '형성 중이거나 다음에 올 봉의 종가'가 얼마면 조건이 바뀌는가, %는 기준봉 종가 대비입니다.\n실시간봉: 현재 형성 중 봉(차트 마지막 봉 [0])까지를 고정으로 보고 '다음 봉 종가' 조건을 역산, 틱마다 갱신(의도된 리얼타임 리페인팅). %는 현재 봉 종가 대비. 봉 마감 시점 값은 완성봉 모드와 동일합니다.")
// 장기 추세 강도/크로스 판정 파라미터(원본 '장기 추세' 그룹 이식) — 단기/중기/장기 추세 셀이 공유.
ltTrendLook = input.int(5, minval=1, title="추세 폭 변화 판정 봉수", group=TABLE_GROUP, tooltip="단기/중기/장기 추세 셀 공통. 크로스 후 이 봉수 경과해야 강/약(폭 변화)을 판정합니다(그 전은 빌드업). 기본 5. 원본과 동일. 전략성 파라미터(수학자 리뷰 대상).")
ltFlatTol = input.float(0.25, minval=0.0, step=0.05, title="평탄 판정 ATR 배수(강↔약 사이 '상승/하락')", group=TABLE_GROUP, tooltip="단기/중기/장기 추세 폭 변화 데드밴드 = ATR(14) × 이 배수. 폭 변화가 이 이내면 평탄('상승/하락'). 기본 0.25. 원본과 동일.")
ltCrossWarnPct = input.float(4.0, minval=0.05, step=0.05, title="크로스 주의 간격(%, 클수록 빨리)", group=TABLE_GROUP, tooltip="확립 후 두 선 간격이 이 % 이하이고 확대 중이 아니면 '약한'으로 고정(반대 크로스 임박). 기본 4.0. 원본과 동일.")
// 지지/저항 near 구간 동적 %(원본 '장기 추세' 그룹 이식) — 50/100/200선 지지·저항 공통(구 vwap상태(20) 밴드2 SR 소비처는 vwap 구간 행 제거로 소멸).
srNearMinPct = input.float(20.0, title="지지/저항 근처 구간 최소 %(넓을 때)", minval=0.0, maxval=100.0, step=1.0, group=TABLE_GROUP, display=display.none, tooltip="50/100/200선 지지·저항 공통(원본 이식). 밴드폭이 넓을 때(고변동성) 근처 구간 비율 최소 %. 기본 20.")
srNearMaxPct = input.float(60.0, title="지지/저항 근처 구간 최대 %(좁을 때)", minval=0.0, maxval=100.0, step=1.0, group=TABLE_GROUP, display=display.none, tooltip="밴드폭이 좁을 때(저변동성) 근처 구간 비율 최대 %. 기본 60. 밴드폭에 반비례로 최소/최대 사이 보간.")
srNearRLowPct = input.float(0.5, title="근처 % 저변동성 임계(밴드1폭/기준선, %)", minval=0.0, step=0.1, group=TABLE_GROUP, display=display.none, tooltip="밴드1 폭 ÷ 기준선 비율(%)이 이 값 이하이면 저변동성 → 근처 % 최대. 기본 0.5%. 원본 이식.")
srNearRHighPct = input.float(2.0, title="근처 % 고변동성 임계(밴드1폭/기준선, %)", minval=0.0, step=0.1, group=TABLE_GROUP, display=display.none, tooltip="밴드1 폭 ÷ 기준선 비율(%)이 이 값 이상이면 고변동성 → 근처 % 최소. 기본 2.0%. 저변동성 임계보다 커야 함. 원본 이식.")
srBandStdMult = input.float(1.0, minval=0.1, step=0.5, title="100·200선 지지/저항 근처 밴드 σ 배수", group=TABLE_GROUP, display=display.none, tooltip="100선·200선(VWMA)도 VWMA ± (이 배수 × 거래량 가중 표준편차 σ)로 판정 전용 밴드1을 만들어 지지/저항 판정. 기본 1.0(=±1σ). 원본 이식.")

// =========================
// 지수 추세 리본(EMA/DEMA/TEMA) + 배열 상태 판정(bgFillState) — 표시 전용. (차트 밴드 배경 페인팅은 'Sonar 모멘텀 배경' 섹션으로 이관 — CEO 지시 2026-10-16)
//  ▸ 페인팅 리본(plot): 선택 가능한 리본 소스(기본 close, 옵션 hlc3/ohlc4)에 EMA를 3중 누적(e1=EMA(소스), e2=EMA(e1), e3=EMA(e2))해
//     EMA=e1, DEMA=2e1−e2, TEMA=3e1−3e2+e3 를 그린다(모두 확정 성격 ta.ema 누적 → 신규 리페인팅 없음).
//     TEMA는 DEMA보다, DEMA는 EMA보다 지연이 작아, 세 선의 상대 위치·기울기가 추세 국면을 압축해 보여준다. 이 3선만 화면에 표시.
//  ▸ 배열 상태 bgFillState(이름은 옛 '밴드 배경' 유래 — 현재 차트 페인팅 아님, 추세 전환가 '정배열 전환'·'역배열 전환' 행 전용): 세 이평선의 1봉 로그 기울기(ㄱ) 지표간 서열로 판정한다.
//     ① TEMA>DEMA>EMA 정배열(pctR2 기준 temaSlA>demaSlA>emaSlA) → +1.  ② EMA>DEMA>TEMA 역배열(emaSlA>demaSlA>temaSlA) → −1.  ③ 그 외/na → 0.
//     ▸ 셀 색 컨플루언스(AND, CEO 지시): 지표간 서열이 성립해도 기울기 3행(EMA/DEMA/TEMA) 셀 색과 어긋나면 억제 — 녹 배경이어도 3행 셀 중 하나라도 적이면 억제, 적 배경이어도 3행 셀 중 하나라도 녹이면 억제(셀 na=회색은 억제 안 함). 배경 = 지표간 서열 AND 3행 셀 색 정합.
//     ▸ 소스 = 각 이평선의 ㄱ(1봉 로그 기울기 = ln(line[0])−ln(line[1]), f_logSlopes3의 첫 요소). 지표간(EMA/DEMA/TEMA) 서열을 %(×100) 소수2자리 반올림(f_pctR2, 셀색 판정과 동일)으로 비교.
//     ⚠️ 이제 배경(지표간 서열)과 기울기 3행 셀 색(각 행 시간축 ㄱ>ㄴ>ㄷ 서열)은 서로 다른 기준이다 — 의도된 분리. 셀 색은 불변.
//     옛 TEMA 로그 행 색 매핑·baseState·정규화 모드·전환 임계 역산·전환 후보(±2)·억제/래치/플립은 CEO 지시로 전면 제거됨.
//  ▸ 확정봉/리페인팅 특성: ㄱ에 line[0](현재봉)이 포함되어 배경도 라이브 봉 동안 갱신되고 봉 마감 시 확정된다. 미래참조 없음(line[0..1]만). 과거봉 확정 후 고정.
//  ⚠️ 매매 신호가 아니라 표시 전용 국면 배경이다. 기존 auto-vwap 기능과 무관.
// =========================
RIBBON_GROUP = "지수 추세 리본"
showRibbon = input.bool(true, title="지수 추세 리본 표시(EMA/DEMA/TEMA)", group=RIBBON_GROUP, tooltip="켜면 리본 소스 기준 EMA·DEMA·TEMA 3선을 오버레이로 그립니다(각 1px). DEMA/TEMA는 EMA 지연을 줄인 지수형 추세선으로, 세 선의 정배열/역배열이 추세 국면을 보여줍니다. 표시 전용(매매 판정·밴드와 무관).")
// 리본 소스 선택(CEO 지시) — EMA/DEMA/TEMA 3중 누적의 입력 소스를 고른다. e1(1차 EMA)에만 적용하고 e2/e3는 e1의 EMA라 자동 반영.
//  ▸ 매핑: "종가"→close, "고저종/3"→hlc3, "시고저종/4"→ohlc4. 기본 "종가"는 기존 close와 완전 동일(회귀 0).
//  ▸ 로그 slope·기울기 3행·정배열/역배열 배경은 모두 리본 line(emaLine/demaLine/temaLine)을 그대로 쓰므로 소스 변경이 자동 전파(별도 수정 불필요).
ribbonSrc = input.string("종가", title="리본 소스", options=["종가", "고저종/3", "시고저종/4"], group=RIBBON_GROUP, active=showRibbon, tooltip="EMA/DEMA/TEMA 3선을 계산할 입력 소스. '종가'=close(기본, 기존과 완전 동일), '고저종/3'=hlc3((고+저+종)/3), '시고저종/4'=ohlc4((시+고+저+종)/4). 소스는 1차 EMA(e1)에만 적용되고 DEMA/TEMA와 로그 slope·기울기 3행·정배열/역배열 배경에 자동 전파됩니다. 표시 전용(매매 판정과 무관).")
ribbonLen = input.int(20, title="지수 리본 길이", minval=1, group=RIBBON_GROUP, active=showRibbon, tooltip="EMA/DEMA/TEMA 공통 길이. 3중 EMA 누적(e1=EMA(리본 소스), e2=EMA(e1), e3=EMA(e2))의 길이로 쓰입니다. 기본 20. 전략성 파라미터(수학자 리뷰 대상).")
ribbonEmaColor = input.color(color.yellow, title="EMA 선 색", group=RIBBON_GROUP, active=showRibbon, tooltip="EMA 선 색. 기본 노랑.")
ribbonDemaColor = input.color(color.aqua, title="DEMA 선 색", group=RIBBON_GROUP, active=showRibbon, tooltip="DEMA(2·EMA−EMA(EMA)) 선 색. 기본 하늘색.")
ribbonTemaColor = input.color(#FF80AB, title="TEMA 선 색", group=RIBBON_GROUP, active=showRibbon, tooltip="TEMA(3·EMA−3·EMA(EMA)+EMA(EMA(EMA))) 선 색. 기본 분홍.")
// ── 밴드 배경 필터 방식(CEO 지시 — 4모드 선택·수학자 검증 산식) ──
//  배경 서열 판정(bgBull/bgBear)에 노이즈 필터를 선택 적용한다. 공통: V = ATR(14)/close(무차원 per-bar 변동성 근사, close>0 가드), g1 = temaSlA − demaSlA, g2 = demaSlA − emaSlA(원값 1봉 로그 기울기 갭).
//   ▸ 미적용: 현행 순수 부등호 서열(pctR2 2자리 반올림). 필터 없음.
//   ▸ 정규화 갭: 갭을 V로 나눈 정규화 값이 임계 τ 이상이어야 서열 성립(g1/V≥τ AND g2/V≥τ). V>0 나눗셈 가드 필수.
//   ▸ 상대 데드존: 갭이 데드존 폭(k×V) 이상이어야 서열 성립(g1≥k·V AND g2≥k·V). 곱셈이라 V=0 안전(기본값).
//   ▸ 기울기 크기 게이트: 순수 서열 성립 AND 정렬 방향 대표 기울기(TEMA ㄱ)가 배열 방향으로 m×V 이상(정배열 temaSlA≥+m·V / 역배열 temaSlA≤−m·V — 부호 판정, CEO 승인 B안).
//  ⚠️ 셀 색 컨플루언스(anyCellRed/Green AND)는 모든 모드에 공통으로 그대로 적용된다(이번엔 bgBull/bgBear 계산만 모드 분기). 표시 전용(매매 신호 아님).
//  ⚠️ UI: 아래 4개 input은 배경 토글(Sonar 배경 showSonarBg 등)에 active로 묶지 않는다 — 실제 소비처는 bgFillState→추세 전환가 '정배열 전환'·'역배열 전환' 행(셀색·전환가 문턱)이라 배경을 꺼도 계속 유효(τ/k/m은 해당 모드에서만 active).
bgFilterMode = input.string("정규화 갭", title="밴드 배경 필터", options=["미적용", "정규화 갭", "기울기 크기 게이트", "상대 데드존"], group=RIBBON_GROUP, tooltip="⚠️ 이 필터는 차트 배경에는 영향이 없습니다(차트 배경은 'Sonar 모멘텀 배경' 섹션 기준). 그래서 Sonar 배경을 꺼도 이 설정과 τ/k/m은 비활성(회색)되지 않고 항상 조정 가능합니다. 상태 테이블 추세 전환가 '정배열 전환'·'역배열 전환' 행(셀 색·배열 전환가 문턱)(지표간 기울기 서열 정배열/역배열 판정)에만 적용되는 노이즈 필터 방식입니다(기본 '정규화 갭', CEO 지시). 공통 스케일 V = ATR(14)/close(무차원 per-bar 변동성 근사, close>0 가드), 갭 g1 = TEMA ㄱ − DEMA ㄱ, g2 = DEMA ㄱ − EMA ㄱ(1봉 로그 기울기 원값 차). ▸ '미적용' = 순수 부등호 서열(pctR2 2자리 반올림, 필터 없음). ▸ '정규화 갭' = g1/V≥τ AND g2/V≥τ(역배열은 −g1/V·−g2/V, V>0 가드). ▸ '상대 데드존' = g1≥k·V AND g2≥k·V(역배열 대칭, 곱셈이라 V=0 안전). ▸ '기울기 크기 게이트' = 순수 서열 AND 배열 방향 부호 판정(정배열은 TEMA ㄱ≥+m·V, 역배열은 TEMA ㄱ≤−m·V — 정렬 방향 대표 기울기가 그 방향으로 m·V 이상). 각 모드 파라미터(τ/k/m)는 해당 모드에서만 노출됩니다. ⚠️ 셀 색 컨플루언스(TEMA/DEMA/EMA 시간축 ㄱ>ㄴ>ㄷ 판정 정합 AND — 기울기 3행 표시는 제거됐고 판정만 내부 유지)는 모든 모드에 공통 적용됩니다. 표시 전용(매매 신호 아님).")
bgGapTau = input.float(0.10, title="정규화 갭 임계 τ", minval=0.0, step=0.01, group=RIBBON_GROUP, active=bgFilterMode == "정규화 갭", tooltip="'정규화 갭' 모드 전용(상태 테이블 추세 전환가 '정배열 전환'·'역배열 전환' 행(셀 색·배열 전환가 문턱) 판정 — 밴드 배경과 무관). 정규화 갭(g/V) 임계. 정배열은 g1/V≥τ AND g2/V≥τ, 역배열은 −g1/V≥τ AND −g2/V≥τ여야 서열 성립. 기본 0.10(라운드넘버). ⚠️ 종목별 튜닝·백테스트 최적화 금지(표시 가독성 파라미터).")
bgSizeM = input.float(0.10, title="기울기 크기 배수 m", minval=0.0, step=0.01, group=RIBBON_GROUP, active=bgFilterMode == "기울기 크기 게이트", tooltip="'기울기 크기 게이트' 모드 전용(상태 테이블 추세 전환가 '정배열 전환'·'역배열 전환' 행(셀 색·배열 전환가 문턱) 판정 — 밴드 배경과 무관). 순수 서열 성립에 더해 정렬 방향 대표 기울기(TEMA ㄱ, temaSlA)가 배열 방향으로 m×V 이상이어야 인정합니다 — 정배열은 TEMA ㄱ≥+m·V, 역배열은 TEMA ㄱ≤−m·V(부호 판정). 기본 0.10(라운드넘버). ⚠️ 종목별 튜닝·백테스트 최적화 금지(표시 가독성 파라미터).")
bgDeadK = input.float(0.10, title="상대 데드존 배수 k", minval=0.0, step=0.01, group=RIBBON_GROUP, active=bgFilterMode == "상대 데드존", tooltip="'상대 데드존' 모드 전용(상태 테이블 추세 전환가 '정배열 전환'·'역배열 전환' 행(셀 색·배열 전환가 문턱) 판정 — 밴드 배경과 무관). 데드존 폭 = k×V. 정배열은 g1≥k·V AND g2≥k·V, 역배열은 (−g1)≥k·V AND (−g2)≥k·V여야 서열 성립(곱셈이라 V=0 안전). 기본 0.10(라운드넘버). ⚠️ 종목별 튜닝·백테스트 최적화 금지(표시 가독성 파라미터).")

// =========================
// Sonar 모멘텀 배경 — 국내 MTS "SonarMomentumSignal강세약세(20,9,9)" 이식(CEO 지시 2026-10-16, 구 '밴드워킹' 배경 페인팅 대체). 표시 전용(매매 신호 아님).
//  ▸ 산식(알고리즘 수학자 조사, 키움 영웅문 정의 차분형): Sonar = EMA(close, n) − EMA(close, n)[k],  Signal = EMA(Sonar, m).  (20,9,9) = (n, k, m).
//  ▸ 판정(sonarBasis): 'Signal 교차' = Sonar>Signal 상승 / Sonar<Signal 하락,  '0선' = Sonar>0 상승 / Sonar<0 하락.  같으면 이전 상태 유지(var 래치).
//     ⚠️ 원 MTS 판정식은 미공개 — 'Signal 교차'는 유력 추정(출처 미확정). '0선'은 대안 가설.
//  ▸ 색: 펀드 컨벤션 상승=녹·하락=빨강(원 MTS의 빨강=상승/파랑=하락 관례를 따르지 않음). 기본 색은 구 밴드워킹 배경 값(#2E7D32/#C62828) 그대로, 기본 투명도는 85(CEO 지시 2026-10-16 — 구 70에서 더 연하게).
//  ▸ 소스: close 고정(원 지표 종가 기준). 리본 소스(ribbonSrc)와 공유하지 않는다 — 리본 표시 옵션을 바꿀 때 배경 판정이 함께 바뀌는 결합을 피하기 위함.
//  ▸ 칠 영역(sonarArea): '밴드 내부' = 밴드 #2(상단2~하단2) 영역 fill(기본, 구 밴드워킹 위치), '차트 전체(bgcolor)' = 원 MTS처럼 차트 전체 세로 배경.
// =========================
SONAR_GROUP = "Sonar 모멘텀 배경"
showSonarBg = input.bool(true, title="Sonar 모멘텀 배경 표시", group=SONAR_GROUP, tooltip="켜면 Sonar 모멘텀 상태로 배경을 칠합니다(상승=녹, 하락=빨강). Sonar = EMA(종가, n) − EMA(종가, n)[k], Signal = EMA(Sonar, m). 국내 MTS 'SonarMomentumSignal강세약세(20,9,9)' 이식. ⚠️ 현재봉 종가를 쓰므로 실시간 봉 동안 틱마다 바뀔 수 있고 봉 마감 시 확정됩니다(미래참조 없음). 워밍업(n+k+m 봉 전후) 구간은 칠하지 않습니다. 표시 전용(매매 신호 아님).")
sonarLen = input.int(20, title="Sonar EMA 기간 n", minval=1, group=SONAR_GROUP, active=showSonarBg, tooltip="Sonar의 EMA(종가, n) 기간. 기본 20(원 MTS 파라미터 첫째 값). 전략성 파라미터(수학자 리뷰 대상).")
sonarGap = input.int(9, title="비교 간격 k", minval=1, maxval=500, group=SONAR_GROUP, active=showSonarBg, tooltip="Sonar = EMA(n) − EMA(n)[k]의 비교 간격 k(봉). 기본 9(원 MTS 파라미터 둘째 값). 최대 500(max_bars_back=1000 버퍼 안). 전략성 파라미터(수학자 리뷰 대상).")
sonarSigLen = input.int(9, title="Signal 기간 m", minval=1, group=SONAR_GROUP, active=showSonarBg, tooltip="Signal = EMA(Sonar, m)의 기간. 기본 9(원 MTS 파라미터 셋째 값). '0선' 판정에서는 쓰이지 않습니다. 전략성 파라미터(수학자 리뷰 대상).")
sonarBasis = input.string("Signal 교차", title="판정 기준", options=["Signal 교차", "0선"], group=SONAR_GROUP, active=showSonarBg, tooltip="원 MTS 판정식 미공개, Signal 교차가 유력 추정. ▸ 'Signal 교차' = Sonar > Signal이면 상승(녹), Sonar < Signal이면 하락(빨강). ▸ '0선' = Sonar > 0이면 상승, Sonar < 0이면 하락. 두 값이 같으면 이전 상태를 유지합니다.")
sonarArea = input.string("밴드 내부", title="칠 영역", options=["밴드 내부", "차트 전체(bgcolor)"], group=SONAR_GROUP, active=showSonarBg, tooltip="'밴드 내부' = 밴드 #2(상단2~하단2) 영역만 칠합니다(기본, 구 밴드워킹 배경과 같은 위치). 밴드 #2 선을 꺼도 영역 값은 계속 계산되므로 같은 영역이 칠해지며, VWAP가 표시되지 않는 봉(일/주/월봉 숨김·거래량 0)에서는 칠하지 않습니다. '차트 전체(bgcolor)' = 원 MTS처럼 차트 전체 세로 배경을 칠합니다(VWAP 표시 여부와 무관).")
sonarBullColor = input.color(#2E7D32, title="상승 색", group=SONAR_GROUP, inline="sonarColor", active=showSonarBg)
sonarBearColor = input.color(#C62828, title="하락 색", group=SONAR_GROUP, inline="sonarColor", active=showSonarBg, tooltip="상승 배경색(기본 녹 #2E7D32) / 하락 배경색(기본 빨강 #C62828) — 구 밴드워킹 배경 색 그대로. 펀드 컨벤션 상승=녹·하락=빨강(원 MTS의 빨강=상승 관례 미적용).")
sonarTransp = input.int(85, title="배경 투명도", minval=0, maxval=100, group=SONAR_GROUP, active=showSonarBg, tooltip="Sonar 배경색 투명도(0=불투명, 100=완전 투명). 기본 85(CEO 지시로 구 70보다 연하게 — 불투명도 30%→15%).")
// ── 추세 확인 테이블 EMA/DEMA/TEMA 기울기 3행 셀 배경색(CEO 재설계 — 로그 slope 순서 규칙) ──
//  각 행 = 리본 이평선(emaLine/demaLine/temaLine)의 ln(line) 기반 로그 slope 3종(ㄱ 2점·ㄴ 3점 OLS·ㄷ 5점 OLS).
//  셀색(각 slope를 %(×100) 소수2자리 반올림한 값으로 비교): pctR2(ㄱ)>pctR2(ㄴ)>pctR2(ㄷ)=녹 / pctR2(ㄱ)<pctR2(ㄴ)<pctR2(ㄷ)=적 / 하나라도 na 또는 2자리 동률=회색. 데드존 없음(2자리 반올림 부등호, CEO 명세). (기울기 3행 표시는 2026-10-16 CEO 지시로 제거 — 판정 bool만 bgFillState용으로 존치.)
//  ⚠️ 옛 각도° 표시·평균 색·데드밴드·과열 승격·ATR 정규화 모드·전환선·전환 판정·전환 후보 삼각형·cRSI 필터·래치는 CEO 지시로 전면 제거됨(전용 input·const 삭제).

// 윌리엄스 %R 다이버전스(williams-fractal 이식) — %R 라인은 오버레이 부적합이라 다이버전스 봉에 원 마커만 표시.
WPR_GROUP = "윌리엄스 %R 다이버전스"
showWprDiv = input.bool(true, "%R 다이버전스 원 표시", group=WPR_GROUP, tooltip="윌리엄스 %R 강세(매수)/약세(매도) 다이버전스 발생 봉에 원 마커 표시. %R 라인 자체는 오버레이라 그리지 않음. 기본 ON. 표시 전용(매매 신호 아님). ⚠️ 옛 전환 후보 삼각형·그 억제 필터는 CEO 지시로 제거됨 — 이 옵션은 이제 %R 원 표시만 제어합니다.")
wprLen = input.int(14, "윌리엄스 %R 길이", group=WPR_GROUP, minval=1, tooltip="윌리엄스 %R(ta.wpr) 계산 기간. 표준 14. 종가 기준, 범위 −100~0.")
wprLower = input.int(-80, "%R 하단 밴드", group=WPR_GROUP, tooltip="강세 다이버전스 진입 임계. 직전 봉 %R가 이 값 아래이면 과매도 진입으로 본다. 표준 −80.")
wprUpper = input.int(-20, "%R 상단 밴드", group=WPR_GROUP, tooltip="약세 다이버전스 진입 임계. 직전 봉 %R가 이 값 위이면 과매수 진입으로 본다. 표준 −20.")
wprBullColor = input.color(#81D4FA, title="%R 강세 다이버전스 원 색(매수)", group=WPR_GROUP, active=showWprDiv, tooltip="윌리엄스 %R 강세 다이버전스 원 마커 색. 기본 라이트 스카이블루(#81D4FA), 봉 아래(belowbar). 확정/과거참조라 리페인팅 없음.")
wprBearColor = input.color(#FF1493, title="%R 약세 다이버전스 원 색(매도)", group=WPR_GROUP, active=showWprDiv, tooltip="윌리엄스 %R 약세 다이버전스 원 마커 색. 기본 딥 핑크(#FF1493), 봉 위(abovebar). 확정/과거참조라 리페인팅 없음.")

// ⚠️ 기울기 정렬 삼각형 전용 input 그룹(TRI_GROUP·showAlignTri·alignTriUpColor·alignTriDnColor·showWickFilter·showTdxFilter)은
//    CEO 지시로 마커·판정 로직과 함께 전면 제거됨(상세는 아래 "기울기 정렬 삼각형 제거" 주석 블록 참조).
// ⚠️ cRSI 삼각형 필터 그룹(useCrsiTriFilter·crsiDomCycle·crsiNarrowThreshold·triLookback)은 CEO 지시로 전환 후보 삼각형과 함께 전면 제거됨.
//    (비정상 캔들의 abnCrsi는 이와 무관한 독립 지표로 그대로 유지된다.)

DEFAULT_LINE_COLOR = #FFFFFF
LOWER_BREAK_LINE_COLOR = #00FF00
UPPER_BREAK_LINE_COLOR = #FF0000

formatPercentGap(float bandValue, float baseValue) =>
    if na(bandValue) or na(baseValue) or baseValue == 0
        ""
    else
        percentGap = (bandValue / baseValue - 1.0) * 100.0
        (percentGap > 0 ? "+" : "") + str.tostring(percentGap, "0.00") + "%"

updateLineEndLabel(label existingLineEndLabel, int xPos, float yPrice, string labelText, color lineColor, bool shouldShow) =>
    label updatedLabel = existingLineEndLabel
    if shouldShow
        if na(updatedLabel)
            updatedLabel := label.new(x=xPos, y=yPrice, text=labelText, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(lineColor, 100), textcolor=lineColor, size=size.small)
        else
            label.set_xy(updatedLabel, xPos, yPrice)
            label.set_text(updatedLabel, labelText)
            label.set_textcolor(updatedLabel, lineColor)
            label.set_color(updatedLabel, color.new(lineColor, 100))
            label.set_style(updatedLabel, label.style_label_left)
    else if not na(updatedLabel)
        label.delete(updatedLabel)
        updatedLabel := na
    updatedLabel

cumVolume = ta.cum(volume)
if barstate.islast and cumVolume == 0
    runtime.error("No volume is provided by the data vendor.")

var label upperBand1LineEndLabel = na
var label lowerBand1LineEndLabel = na
var label upperBand2LineEndLabel = na
var label lowerBand2LineEndLabel = na

// VWAP·밴드·밴드2 계산 헬퍼 — window 길이(barsLen)와 **소스(srcArg)**를 파라미터로 받아 기본 화면용(length=50, src) 세트를 계산한다.
//  ⚠️ CEO 지시로 앵커모드(Session / Recent Trading Days)를 완전 제거 → **"최근 N봉 롤링(Recent Bars)" 단일 방식 고정**.
//   앵커 = barsLen 봉 전 누적값(cumulative*[barsLen])이며, window = 현재 누적 − 그 앵커 = 최근 barsLen봉 롤링 누적.
//  ⚠️ 소스별로 서로 다른 누적이 필요하므로 누적(cumulative*)을 **함수-로컬 var로 내부화**한다.
//   Pine v6에서 함수 내부 var는 그 호출부(instance)마다 독립 상태를 가지므로, 여러 번 호출하면 각각 독립 누적이 유지된다.
//  산식 자체(rolling VWAP + 로그/절대 표준편차 밴드)는 앵커모드 제거 전의 Recent Bars 경로와 100% 동일. 확정봉 기준 누적이라 소스가 series여도 신규 리페인팅 없음.
//  반환: [vwapValue, upperBand1, lowerBand1, upperBand2, lowerBand2, shouldPlot].
computeVwapSet(int barsLen, float srcArg) =>
    var float cumulativePV = 0.0
    var float cumulativeVolume = 0.0
    var float cumulativeP2V = 0.0
    var float cumulativeLogPV = 0.0
    var float cumulativeLog2V = 0.0
    var float cumulativeInvalidLogVolume = 0.0

    barPV = srcArg * volume
    barP2V = srcArg * srcArg * volume
    logSrc = srcArg > 0 ? math.log(srcArg) : na
    barLogPV = na(logSrc) ? 0.0 : logSrc * volume
    barLog2V = na(logSrc) ? 0.0 : logSrc * logSrc * volume
    barInvalidLogVolume = na(logSrc) ? volume : 0.0
    cumulativePV += barPV
    cumulativeVolume += volume
    cumulativeP2V += barP2V
    cumulativeLogPV += barLogPV
    cumulativeLog2V += barLog2V
    cumulativeInvalidLogVolume += barInvalidLogVolume

    // 앵커 = barsLen 봉 전 누적값(Recent Bars 롤링 단일). 워밍업(barsLen 미만)엔 nz로 0 폴백 → 전체 누적을 창으로 사용.
    anchorPV = nz(cumulativePV[barsLen], 0.0)
    anchorVolume = nz(cumulativeVolume[barsLen], 0.0)
    anchorP2V = nz(cumulativeP2V[barsLen], 0.0)
    anchorLogPV = nz(cumulativeLogPV[barsLen], 0.0)
    anchorLog2V = nz(cumulativeLog2V[barsLen], 0.0)
    anchorInvalidLogVolume = nz(cumulativeInvalidLogVolume[barsLen], 0.0)

    windowPV = cumulativePV - anchorPV
    windowVolume = cumulativeVolume - anchorVolume
    windowP2V = cumulativeP2V - anchorP2V
    windowLogPV = cumulativeLogPV - anchorLogPV
    windowLog2V = cumulativeLog2V - anchorLog2V
    windowInvalidLogVolume = cumulativeInvalidLogVolume - anchorInvalidLogVolume

    float vwapLocal = na
    float upperBand1Local = na
    float lowerBand1Local = na
    float upperBand2Local = na
    float lowerBand2Local = na

    shouldPlotLocal = not (hideonDWM and timeframe.isdwm) and windowVolume > 0

    if shouldPlotLocal
        vwapLocal := windowPV / windowVolume
        weightedVariance = math.max(windowP2V / windowVolume - math.pow(vwapLocal, 2), 0)
        stdevAbs = math.sqrt(weightedVariance)
        weightedLogVariance = math.max(windowLog2V / windowVolume - math.pow(windowLogPV / windowVolume, 2), 0)
        stdevLog = math.sqrt(weightedLogVariance)
        canUseLogBands = windowInvalidLogVolume == 0 and vwapLocal > 0

        if calcModeInput == "Absolute Standard Deviation"
            upperBand1Local := vwapLocal + stdevAbs * bandMult_1
            lowerBand1Local := vwapLocal - stdevAbs * bandMult_1
            upperBand2Local := vwapLocal + stdevAbs * bandMult_2
            lowerBand2Local := vwapLocal - stdevAbs * bandMult_2
        else if canUseLogBands
            upperBand1Local := vwapLocal * math.exp(stdevLog * bandMult_1)
            lowerBand1Local := vwapLocal * math.exp(-stdevLog * bandMult_1)
            upperBand2Local := vwapLocal * math.exp(stdevLog * bandMult_2)
            lowerBand2Local := vwapLocal * math.exp(-stdevLog * bandMult_2)
    [vwapLocal, upperBand1Local, lowerBand1Local, upperBand2Local, lowerBand2Local, shouldPlotLocal]

// =========================
// 비정상 매수/매도 — SUPER-ICHIMOKU 메인 지표(advanced-ichimoku.pine)의 "비정상 캔들"(비정상 매수/매도) 판정을 이식(포팅).
//  판정: cRSI 과매수/과매도(도미넌트 사이클) + 볼린저 밴드 이탈(고가/저가 기준). 두 조건이 동시 성립하면 비정상.
//   ▸ 비정상 매수(과매수 구간, abnCandleState==-1) = cRSI 과매수(abnIsOB) AND 고가가 볼린저 상단 밴드를 초과(초과폭÷캔들범위 ≥ 비율). → 붉은 캔들.
//   ▸ 비정상 매도(과매도 구간, abnCandleState== 1) = cRSI 과매도(abnIsOS) AND 저가가 볼린저 하단 밴드를 이탈(이탈폭÷캔들범위 ≥ 비율). → 하늘색 캔들.
//   ⚠️ 이치모쿠 원본과 매핑: "비정상 매수 = 과매수(cRSI≥OB + 상단밴드 돌파)"·"비정상 매도 = 과매도(cRSI≤OS + 하단밴드 이탈)". 지시 매핑(비정상매수=과매수·비정상매도=과매도)과 정확히 일치.
//  ⚠️ 자기완결 포팅(이치모쿠 의존 제거):
//   (1) 원본은 기준 길이를 베이스 라인(basePeriods)에 연동(abnLen=basePeriods)했으나, auto-vwap엔 이치모쿠 input이 없다. CEO 지시로 **비정상 전체 기준 길이를 abnBbLen(기본 20) 하나로 단일화**한다(구 전용 input abnBaseLen 삭제).
//       abnBbLen(기본 20) → 볼린저 basis/dev + cRSI 사이클 길이(abnBbLen/2=10)·ATR·RSI·추적 lookback이 모두 이 값 하나에 연동된다(전 기준 길이 22→20으로 통일).
//   (2) 원본은 래치 리셋 트리거로 '이격도 중립 복귀'(abnDisparityNeutral = overCount==0 and underCount==0)를 썼으나, auto-vwap엔 이격도 블록이 없으므로 **이치모쿠 이격도(Disparity) 계산을 그대로 자기완결 이식**한다.
//       이격도 = 종가 ÷ 선택 이평 × 100, 고정 임계(±%)+적응형(σ 배수)로 되돌림 판정. overCount/underCount==0(중립)이면 abnDisparityNeutral=true. input(이격도 MA 종류·길이·임계·통계 구간·σ 배수)도 원본 명칭/기본값/툴팁 그대로 이식.
//       ⚠️ 이 이격도는 오직 비정상 상태 래치 리셋(원본과 동일한 종료 조건)에만 쓰이며, 테이블·다른 표시를 새로 만들지 않는다(표시 전용 최소 이식).
//  ⚠️ 배경(bgcolor)은 확정 성격 래치(abnCandleState) 기반 — cRSI/볼린저는 현재봉 close/high/low를 쓰므로 형성 중 현재봉은 실시간 변동(원본과 동일 거동), 과거봉은 확정. 원본과 동일한 리페인팅 특성(신규 리페인팅 추가 없음).
//  ⚠️ 표시 전용(배경색 + 아래 과매수/과매도 수평선) — 밴드·정배열/역배열 배경 로직과 무관. 매매 전략(진입·청산·임계)과 무관.
// =========================
ABN_GROUP = "비정상 매수/매도"
abnVibration = input.int(10, minval=1, title="비정상 캔들 cRSI Vibration", group=ABN_GROUP)
abnOB = input.float(70.0, title="비정상 절대 과매수", group=ABN_GROUP)
abnOS = input.float(30.0, title="비정상 절대 과매도", group=ABN_GROUP)
// 비정상 전체 기준 길이 — CEO 지시로 abnBaseLen(구 기본 22)을 삭제하고 이 볼린저 길이(기본 20) 하나로 단일화. 볼린저뿐 아니라 cRSI 사이클·RSI·ATR·반등 추적 lookback이 모두 이 값에 연동된다.
abnBbLen = input.int(20, minval=1, title="비정상 기준 길이(볼린저 등)", group=ABN_GROUP, tooltip="비정상 매수/매도 판정의 전체 기준 길이(기본 20, 표준 볼린저 관례). 볼린저 밴드(basis=SMA·dev=STDEV)뿐 아니라 cRSI 사이클 길이(이 값÷2)·RSI·ATR·반등 추적 lookback이 모두 이 값에 연동됩니다(CEO 지시로 기존 별도 기준 길이 abnBaseLen을 삭제·통합). 전략성 파라미터(수학자 리뷰 대상).")
abnBbMult = input.float(2.0, minval=0.1, step=0.1, title="비정상 볼린저 배수", group=ABN_GROUP)
abnBodyRatio = input.float(0.3, minval=0.0, step=0.05, title="비정상 밴드 초과 비율(고저 기준)", group=ABN_GROUP)
// 반등 감시(abnWatch) 게이트 입력 2개 — advanced-ichimoku.pine 반등 감시와 title 일치(일관성). CEO 지시.
//  ⚠️ group: 이치모쿠 원본 그룹은 "비정상 캔들"이나, auto-vwap의 모든 비정상 입력은 ABN_GROUP("비정상 매수/매도")에 모여 있어
//   두 입력만 별도 그룹으로 떼면 auto-vwap 자체의 UI 일관성이 깨진다 → 기존 ABN_GROUP에 배치한다(title은 원본과 동일). (자기완결 이식 관례와 동일 판단.)
//  ⚠️ 전략성 파라미터(수학자 리뷰 대상): 임계·배수 변경은 반등 감시 민감도(전략)를 바꾼다.
abnAtrMult = input.float(1.5, minval=0.1, step=0.1, title="비정상 반등 감시 ATR 배수", group=ABN_GROUP, tooltip="비정상 캔들 이후 그 방향과 반대되는 가격 되돌림(반등)이 이 ATR 배수 이상이면 '롱/숏 감시'(abnWatch)로 판정합니다. 기본 1.5(이치모쿠 반등 감시와 동일 — 기본/강화 2단은 단일 감시로 통합됨). 전략성 파라미터(수학자 리뷰 대상).")
abnRsiMoveLimit = input.float(15.0, minval=0.1, step=0.1, title="비정상 RSI 이동 제한", group=ABN_GROUP, tooltip="반등 감시 게이트의 RSI 이동 상한. 가격 되돌림이 ATR 조건을 충족해도, 그 사이 RSI 되돌림 폭이 이 값 이하일 때만 '감시'로 인정합니다(가격은 되돌렸는데 RSI 과열은 아직 안 풀린 반등 초기 국면). 기본 15(이치모쿠 반등 감시와 동일). 전략성 파라미터(수학자 리뷰 대상).")
abnShowBg = input.bool(true, title="비정상 매수/매도 캔들색 표시", group=ABN_GROUP, tooltip="비정상 매도=파랑(기본 color.blue), 비정상 매수=붉은색(기본 #E53935)으로 해당 봉의 캔들 몸통색을 칠합니다(CEO 지시로 배경 → 캔들 몸통색 전환). 비정상이 아닌 봉은 캔들 기본색을 유지합니다. (반등 감시 배경은 CEO 지시로 제거됨)")
// 비정상 매수/매도 캔들 몸통색(CEO 지시: 매도=파랑(되돌림), 매수=붉은색 — 과매수=고점 경고 직관(붉은=위험)에 부합. 매도색은 파랑(color.blue) — 검은(다크) 배경에서 파랑으로 표시.)
abnSellBgColor = input.color(color.blue, title="비정상 매도 캔들색(파랑)", group=ABN_GROUP)
abnBuyBgColor = input.color(#E53935, title="비정상 매수 캔들색(붉은색)", group=ABN_GROUP)
// (구 '비정상 배경 투명도' input은 캔들 몸통색 전환으로 미사용이 되어 제거 — 캔들 몸통은 불투명으로 색상 그대로 칠한다. 새 파라미터는 만들지 않음.)

// 이격도(Disparity) 자기완결 이식 — 비정상 상태 래치 리셋(원본 abnDisparityNeutral)에만 사용. 이치모쿠 원본 산식·input 그대로.
DISP_GROUP = "이격도"
disparityMaType = input.string("SMA", title="이격도 MA 종류", options=["SMA", "EMA", "WMA", "VWMA"], group=DISP_GROUP)
disparityMaLen = input.int(20, minval=1, title="이격도 MA 길이", group=DISP_GROUP)
disparityThreshold = input.float(10.0, minval=0.1, step=0.1, title="이격도 임계(±%, 고정)", group=DISP_GROUP)
disparityStatLen = input.int(50, minval=5, title="이격도 통계 구간(적응형)", group=DISP_GROUP)
disparityStatMult = input.float(1.5, minval=0.1, step=0.1, title="이격도 통계 시그마 배수", group=DISP_GROUP)

// 기본 화면용 VWAP 세트(length=50, 소스=src) — 화면 plot·밴드·라벨의 기준. 소스는 기존 화면 VWAP src(기본 hlc3) 유지 → 거동 불변.
[vwapValue, upperBandValue1, lowerBandValue1, upperBandValue2, lowerBandValue2, shouldPlot] = computeVwapSet(recentBars, src)

// =========================
// 비정상 매수/매도 판정 — advanced-ichimoku.pine "비정상 캔들" 블록의 이식(포팅). 산식·기본값 동일.
//  원본 abnLen/abnLookback=basePeriods → auto-vwap은 CEO 지시로 abnBbLen(비정상 전체 기준 길이, 기본 20) 하나로 단일화. cRSI/ATR/RSI 산식은 100% 동일(길이만 20으로 통일).
//  원본 abnDisparityNeutral(이격도 중립 복귀)은 아래 이격도 자기완결 이식으로 재현 → 래치 리셋 트리거로만 사용.
// =========================
// 이격도(Disparity) — 종가 ÷ 이평 × 100. 고정 임계(±%) + 적응형(σ 배수)로 되돌림 판정. 원본과 동일 산식(중립 여부만 사용).
disparityMa = switch disparityMaType
    "SMA" => ta.sma(close, disparityMaLen)
    "EMA" => ta.ema(close, disparityMaLen)
    "WMA" => ta.wma(close, disparityMaLen)
    "VWMA" => ta.vwma(close, disparityMaLen)
disparity = not na(disparityMa) and disparityMa != 0 ? close / disparityMa * 100 : na
disparityStd = ta.stdev(disparity, disparityStatLen)
disparityStatOk = not na(disparity) and not na(disparityStd) and disparityStd > 0
overFixed  = not na(disparity) and disparity - 100 >= disparityThreshold
overStat   = disparityStatOk and disparity - 100 >= disparityStatMult * disparityStd
underFixed = not na(disparity) and 100 - disparity >= disparityThreshold
underStat  = disparityStatOk and 100 - disparity >= disparityStatMult * disparityStd
overCount  = (overFixed ? 1 : 0) + (overStat ? 1 : 0)
underCount = (underFixed ? 1 : 0) + (underStat ? 1 : 0)

// 기준 길이 = abnBbLen(비정상 전체 기준 길이, 기본 20) — CEO 지시로 abnBaseLen 삭제·통합. 비정상 캔들 신호 최적화
abnLen = abnBbLen
abnLookback = abnBbLen
// cRSI (도미넌트 사이클) → 절대 과매수/과매도
abnCycleLen = math.max(1, int(abnBbLen / 2))
abnTorque = 2.0 / (abnVibration + 1.0)
abnPhasingLag = int((abnVibration - 1) / 2.0)
// [성능] ta.change(close) 중복 호출(과거 2회 → 1회) 제거. ta.change는 close[1] 참조 stateful 계산이라 2회 호출 시 각각 재계산됨.
//  chgClose를 1회 계산해 max/min에 재사용 → 값 완전 동일(math.max(chg,0)·-math.min(chg,0)의 chg가 같은 series). 산식·워밍업·series 정합 불변.
chgClose = ta.change(close)
abnUp = ta.rma(math.max(chgClose, 0), abnCycleLen)
abnDown = ta.rma(-math.min(chgClose, 0), abnCycleLen)
abnRsiRaw = abnDown == 0 ? 100.0 : abnUp == 0 ? 0.0 : 100.0 - 100.0 / (1.0 + abnUp / abnDown)
var float abnCrsi = na
abnCrsi := abnTorque * (2.0 * abnRsiRaw - nz(abnRsiRaw[abnPhasingLag])) + (1.0 - abnTorque) * nz(abnCrsi[1])
abnIsOB = abnCrsi >= abnOB
abnIsOS = abnCrsi <= abnOS

// 볼린저 밴드 이탈 = 비정상 캔들. 고가/저가 기준(원본과 동일). 비정상 매수=고가가 상단 초과, 비정상 매도=저가가 하단 이탈.
abnBbBasis = ta.sma(close, abnBbLen)
abnBbDev = ta.stdev(close, abnBbLen) * abnBbMult
abnBbUpper = abnBbBasis + abnBbDev
abnBbLower = abnBbBasis - abnBbDev
abnRangeSpan = math.max(high - low, syminfo.mintick)
abnUpperOut = math.max(high - abnBbUpper, 0.0)
abnLowerOut = math.max(abnBbLower - low, 0.0)
abnBearExt = abnUpperOut > 0 and abnUpperOut / abnRangeSpan >= abnBodyRatio
abnBullExt = abnLowerOut > 0 and abnLowerOut / abnRangeSpan >= abnBodyRatio
abnBearCandle = abnIsOB and abnBearExt   // 비정상 매수(과매수): cRSI 과매수 + 상단밴드 돌파
abnBullCandle = abnIsOS and abnBullExt   // 비정상 매도(과매도): cRSI 과매도 + 하단밴드 이탈

// =========================
// 비정상 반등 감시(abnWatch) — advanced-ichimoku.pine "반등 감시" 로직의 이식(포팅). CEO 지시.
//  목적: 비정상 캔들(과매수/과매도 극단) 발생 뒤, 그 방향과 **반대되는 되돌림(반등)** 이 ATR 대비 유의미하게 나오면
//   "롱 감시"(과매도 뒤 아래→위 반등 조짐, +2) / "숏 감시"(과매수 뒤 위→아래 반등 조짐, −2)로 상태를 래치한다.
//  ▸ 기준점 저장: 비정상 캔들이 뜬 봉에서 그 방향 극단가(롱=low, 숏=high)·RSI·ATR을 var로 스냅샷(RefPrice/RefRsi/RefAtr).
//  ▸ 되돌림 추적: RefPrice 대비 반대방향 가격 이동(priceMove)이 RefAtr×abnAtrMult(기본 1.5) 이상 + RSI 이동(rsiMove)이 abnRsiMoveLimit(기본 15) 이하이면 감시 ON.
//    (rsiMove ≤ 제한: 가격은 되돌렸는데 RSI 과열은 아직 안 풀린 = 반등 초기 국면을 잡는 이치모쿠 원본 게이트 그대로.)
//  ⚠️ RSI/ATR 소스: 이치모쿠 원본은 abnOsc=ta.rsi(close, abnLen)·abnAtr=ta.atr(abnLen), abnLen=basePeriods.
//    auto-vwap은 abnLen=abnBbLen(비정상 전체 기준 길이, 기본 20 — CEO 지시 단일화). lookback(abnLookback=abnBbLen)도 동일 값에 연동.
//  ⚠️ 리셋: 이치모쿠 원본과 동일하게 이격도 중립 복귀(abnDisparityNeutral) 시 abnCandleState·abnWatch를 함께 0으로 리셋한다.
//  ⚠️ 리페인팅 방지(CEO 명시 지시 — 본 이식의 게이트): 이치모쿠 원본은 abnWatch 갱신에 barstate.isconfirmed 가드를 **의도적으로 안 걸었으나**(실시간 빠른 캐치),
//    본 이식은 CEO 지시("상태 갱신은 확정봉에서만")에 따라 **확정봉(barstate.isconfirmed)에서만** abnWatch·기준점을 갱신한다.
//    → 형성 중 현재봉이 감시 래치를 흔들지 않음(신규 리페인팅 없음). 이치모쿠와의 이 실시간성 차이는 CEO 보고 대상(전략 성격).
//  ⚠️ 표시 방식 보류(CEO 보고): auto-vwap엔 상태 테이블/셀이 없다(README "상태판 없음" — CEO가 완전 제거). 이치모쿠는 셀 텍스트("롱 감시"/"숏 감시")로 표기하나
//    auto-vwap엔 대응 UI가 없으므로 **로직만 이식(abnWatch 계산까지)** 하고 화면 표시는 채택하지 않았다. 억지 신규 UI를 만들지 않음(CEO 판단 대기).
//    abnWatch 상태는 계산·래치되어 있어 추후 표시 방식(예: 마커/라벨/셀) 확정 시 즉시 연결 가능하다.
//  ⚠️ 표시 전용 국면 표식이며 매매 전략(진입·청산·임계)과 무관. abnAtrMult·abnRsiMoveLimit은 전략성 파라미터(수학자 리뷰 대상).
// =========================
// 반등 감시용 RSI·ATR — 비정상 전체 기준 길이(abnLen=abnBbLen, 기본 20). 기준점(RefRsi/RefAtr) 스냅샷과 되돌림 추적에 쓴다.
abnOsc = ta.rsi(close, abnLen)
abnAtr = ta.atr(abnLen)
// 상태 래치: 이격도 중립 복귀 시 리셋. (원본 advanced-ichimoku.pine 동일 — abnCandleState + 반등 감시 abnWatch 함께 리셋)
abnDisparityNeutral = overCount == 0 and underCount == 0
var int abnCandleState = 0   // 1=비정상 매도(과매도), -1=비정상 매수(과매수), 0=없음
var int abnWatch = 0         // 2=롱 감시, -2=숏 감시, 0=없음 (이치모쿠 원본과 동일 부호 체계)
// 기준점 스냅샷 — 비정상 캔들이 뜬 봉의 극단가·RSI·ATR. 롱(과매도 abnBullCandle)=low 기준, 숏(과매수 abnBearCandle)=high 기준.
var int abnBullBar = na
var int abnBearBar = na
var float abnBullRefPrice = na
var float abnBullRefRsi = na
var float abnBullRefAtr = na
var float abnBearRefPrice = na
var float abnBearRefRsi = na
var float abnBearRefAtr = na
// ⚠️ CEO 지시: 상태 갱신은 확정봉(barstate.isconfirmed)에서만. 기준점·감시 래치·정상 복귀 리셋을 모두 이 가드 안에서 갱신한다.
if barstate.isconfirmed
    if abnDisparityNeutral
        abnCandleState := 0
        abnWatch := 0
    if abnBullCandle
        abnCandleState := 1
        abnBullBar := bar_index
        abnBullRefPrice := low
        abnBullRefRsi := abnOsc
        abnBullRefAtr := abnAtr
    if abnBearCandle
        abnCandleState := -1
        abnBearBar := bar_index
        abnBearRefPrice := high
        abnBearRefRsi := abnOsc
        abnBearRefAtr := abnAtr
    // 되돌림 추적 — 기준점 이후 abnLookback 봉 이내에서만 유효. 롱=아래 극단(low)에서 가격이 위로(RefPrice−low는 저가 기준 되돌림), 숏=위 극단(high)에서 아래로.
    //  ⚠️ 이치모쿠 원본 산식 그대로: 롱 priceMove=RefPrice−low, 숏 priceMove=high−RefPrice. rsiMove는 각 방향 RSI 되돌림 폭.
    abnBullBars = not na(abnBullBar) ? bar_index - abnBullBar : na
    abnBearBars = not na(abnBearBar) ? bar_index - abnBearBar : na
    abnHasBull = not na(abnBullBars) and abnBullBars >= 0 and abnBullBars <= abnLookback
    abnHasBear = not na(abnBearBars) and abnBearBars >= 0 and abnBearBars <= abnLookback
    abnBullPriceMove = abnHasBull and not na(abnBullRefPrice) ? abnBullRefPrice - low : na
    abnBullRsiMove = abnHasBull and not na(abnBullRefRsi) ? abnBullRefRsi - abnOsc : na
    abnBullAtrNeed = abnHasBull and not na(abnBullRefAtr) ? abnBullRefAtr * abnAtrMult : na
    abnBearPriceMove = abnHasBear and not na(abnBearRefPrice) ? high - abnBearRefPrice : na
    abnBearRsiMove = abnHasBear and not na(abnBearRefRsi) ? abnOsc - abnBearRefRsi : na
    abnBearAtrNeed = abnHasBear and not na(abnBearRefAtr) ? abnBearRefAtr * abnAtrMult : na
    // 반등 감시 게이트(단일 — 이치모쿠 기본/강화 통합 후 단일 감시): 가격 되돌림 ≥ ATR×abnAtrMult(기본 1.5) AND RSI 이동 ≤ abnRsiMoveLimit(기본 15).
    abnBullBgOn = abnHasBull and abnBullBars > 0 and not na(abnBullPriceMove) and not na(abnBullAtrNeed) and abnBullPriceMove >= abnBullAtrNeed and abnBullRsiMove <= abnRsiMoveLimit
    abnBearBgOn = abnHasBear and abnBearBars > 0 and not na(abnBearPriceMove) and not na(abnBearAtrNeed) and abnBearPriceMove >= abnBearAtrNeed and abnBearRsiMove <= abnRsiMoveLimit
    if abnBullBgOn
        abnWatch := 2
    if abnBearBgOn
        abnWatch := -2

// 비정상 캔들 몸통색(CEO 지시 — 배경 bgcolor → barcolor 전환): 비정상 매도(abnCandleStateLive==1)=하늘색(abnSellBgColor), 비정상 매수(abnCandleStateLive==-1)=붉은색(abnBuyBgColor). ※과매수=고점 경고 직관(붉은=위험)에 맞춰 주황→붉은 계열 변경.
//  ⚠️ 색상(hue)은 기존 배경색을 그대로 승계(톤앤매너 유지)하되, 캔들 몸통은 배경(투명도 82)처럼 은은하면 몸통색이 거의 안 보이므로 불투명(투명도 0)으로 칠한다.
//   → abnBgTransp(배경 투명도)는 더 이상 캔들색에 적용하지 않는다(캔들은 몸통 전체를 덮는 오버라이드라 반투명이면 원래 캔들색과 뒤섞여 판독 저하). 색·판정(abnCandleState 래치)은 불변, 표현 매체만 배경→캔들.
//  ⚠️ 비정상 구간이 아닌 봉은 na → barcolor(na)로 캔들 기본색 유지(오버라이드 안 함).
// ⚠️ [CEO 지시 — 캔들색 실시간 반영] 화면 표시 전용 실시간 상태(abnCandleStateLive).
//  배경: 위 래치 abnCandleState는 CEO 지시로 barstate.isconfirmed 가드 안에서만 갱신된다(abnWatch 리페인팅 방지 — cfae42a 이식 때 함께 묶임).
//   그 결과 형성 중(미확정) 현재봉은 조건이 충족돼도 봉이 닫히기 전까지 캔들색이 칠해지지 않았다. CEO 지시로 **화면 색만** 실시간화한다.
//  ⚠️ 판정 기준 불변: 조건식(abnBullCandle/abnBearCandle)·임계값·리셋 조건(abnDisparityNeutral)·우선순위(리셋 → 매도 → 매수)를
//   위 확정봉 블록과 **완전히 동일한 순서**로 한 번 더 적용할 뿐이다. 새 조건·새 임계값·새 색을 만들지 않는다.
//  ⚠️ 확정봉/과거봉 동등성: 확정봉에서는 abnCandleState가 이미 같은 변환을 거친 값이므로 이 재적용은 멱등(idempotent)이다
//   → 과거봉·확정봉의 캔들색은 수정 전과 100% 동일하고, 달라지는 것은 **형성 중 현재봉 한 개의 표시 시점**뿐이다.
//  ⚠️ 래치(abnCandleState)·반등 감시(abnWatch)·기준점 스냅샷은 전혀 건드리지 않는다(확정봉 갱신 유지 — 상태 리페인팅 없음).
//  ⚠️ 특성: 미확정봉에서는 틱마다 재평가되므로 조건 진입/이탈에 따라 색이 켜졌다 꺼질 수 있다(의도된 실시간 거동).
abnCandleStateLive = abnDisparityNeutral ? 0 : abnCandleState
if abnBullCandle
    abnCandleStateLive := 1
if abnBearCandle
    abnCandleStateLive := -1

abnBarColor = abnCandleStateLive == 1 ? abnSellBgColor : abnCandleStateLive == -1 ? abnBuyBgColor : na

// =========================
// 지수 추세 리본(EMA/DEMA/TEMA) 계산 + 로그 slope 3종 + 밴드 배경(TEMA 로그 행 색).
//  ▸ 페인팅 리본(plot, 리본 소스 기준): e1=EMA(ribbonSource,len), e2=EMA(e1,len), e3=EMA(e2,len). EMA=e1, DEMA=2e1−e2, TEMA=3e1−3e2+e3. ribbonSource=close(기본)/hlc3/ohlc4.
//     이 3선(emaLine/demaLine/temaLine)만 화면에 plot(각 1px, 우측 가격축 라벨 ON — CEO 지시, display.all). 모두 ta.ema 누적(확정 성격) → 신규 리페인팅 없음.
//  ▸ 로그 slope 3종(CEO 재설계 — 수학자 검증 산식): 각 리본선 line의 ln(line) 기준으로 ㄱ(2점 로그수익률)·ㄴ(3점 OLS)·ㄷ(5점 OLS)을 계산한다(아래 f_logSlopes3).
//     셀 색(각 slope를 %(×100) 소수2자리 반올림한 값으로 비교): pctR2(ㄱ)>pctR2(ㄴ)>pctR2(ㄷ)=녹(정배열) / pctR2(ㄱ)<pctR2(ㄴ)<pctR2(ㄷ)=적(역배열) / 하나라도 na 또는 2자리 동률=회색. 데드존 없음(2자리 반올림 부등호, CEO 명세). (기울기 3행 표시는 2026-10-16 CEO 지시로 제거 — 판정 bool만 bgFillState용으로 존치.)
//     x축을 "과거→현재=증가"로 두어 우상향(가속)=양수 → ㄱ>ㄴ>ㄷ(최근 기울기가 더 큼)이 녹(정배열)이다.
//  ▸ 배열 상태 bgFillState(1봉 기울기 지표간 서열): TEMA>DEMA>EMA 정배열(ㄱ, f_pctR2)→+1, EMA>DEMA>TEMA 역배열→−1, 그 외/na→0. 셀 색(시간축 서열)과 다른 기준(의도된 분리). 차트 페인팅에는 쓰이지 않음(Sonar 배경으로 이관).
//     옛 baseState·정규화·전환 임계 역산·전환 후보·전환선·억제/래치/플립은 CEO 지시로 전면 제거됨.
//  ⚠️ 리페인팅(CEO 명시 특성): slope에 line[0](현재봉)이 포함되므로 로그 slope·셀색·배경이 라이브 봉 동안 갱신되고 봉 마감 시 확정된다. 미래참조 없음(line[0..4]만). 과거봉은 확정 후 고정.
//  ⚠️ 밴드2 값(upperBandValue2/lowerBandValue2)·shouldPlot은 위에서 이미 계산됨(선언순서 안전).
// =========================
// 페인팅 리본(plot 대상). plot은 아래에서 emaLine/demaLine/temaLine 3선만 그린다(불변).
//  리본 소스 매핑(CEO 지시): "고저종/3"→hlc3, "시고저종/4"→ohlc4, 그 외("종가")→close. 기본 "종가"는 기존 close와 완전 동일(회귀 0).
//  소스는 e1(1차 EMA)에만 적용 — e2=EMA(e1)·e3=EMA(e2)는 e1의 EMA라 소스 변경이 자동 전파된다.
ribbonSource = ribbonSrc == "고저종/3" ? hlc3 : ribbonSrc == "시고저종/4" ? ohlc4 : close
ribbonE1 = ta.ema(ribbonSource, ribbonLen)
ribbonE2 = ta.ema(ribbonE1, ribbonLen)
ribbonE3 = ta.ema(ribbonE2, ribbonLen)
emaLine = ribbonE1
demaLine = 2 * ribbonE1 - ribbonE2
temaLine = 3 * ribbonE1 - 3 * ribbonE2 + ribbonE3

// =========================
// 로그 slope 3종(ㄱ 2점·ㄴ 3점 OLS·ㄷ 5점 OLS) — 수학자 검증 산식(1/3/5 상수 고정, input 노출 금지).
//  ▸ na/양수 가드: yk = line[k]>0 ? ln(line[k]) : na. 하나라도 na면 그 slope na(→ 셀 회색).
//  ▸ ㄱ (봉당 로그수익률): slopeA = ln(line[0]) − ln(line[1]).
//  ▸ ㄴ (3점 OLS, line[0..2]): x=2,1,0 for k=0,1,2(과거→현재 증가). slopeB = (3·(2·y0+1·y1+0·y2) − 3·(y0+y1+y2)) / 6.
//  ▸ ㄷ (5점 OLS, line[0..4]): x=4,3,2,1,0 for k=0..4. slopeC = (5·(4·y0+3·y1+2·y2+1·y3+0·y4) − 10·(y0+y1+y2+y3+y4)) / 50.
//  ▸ 부호 정합: x축을 과거→현재 증가로 두어 우상향=양수(위 계수 검산 완료). 봉 마감 확정(line[0] 포함=라이브 갱신).
f_logY(float v) => v > 0 ? math.log(v) : na
// [slopeA, slopeB, slopeC] 반환. 각 slope는 필요한 yk 중 하나라도 na면 na.
f_logSlopes3(float line0, float line1, float line2, float line3, float line4) =>
    float y0 = f_logY(line0)
    float y1 = f_logY(line1)
    float y2 = f_logY(line2)
    float y3 = f_logY(line3)
    float y4 = f_logY(line4)
    float sA = (na(y0) or na(y1)) ? na : y0 - y1
    float sB = (na(y0) or na(y1) or na(y2)) ? na : (3.0 * (2.0 * y0 + 1.0 * y1 + 0.0 * y2) - 3.0 * (y0 + y1 + y2)) / 6.0
    float sC = (na(y0) or na(y1) or na(y2) or na(y3) or na(y4)) ? na : (5.0 * (4.0 * y0 + 3.0 * y1 + 2.0 * y2 + 1.0 * y3 + 0.0 * y4) - 10.0 * (y0 + y1 + y2 + y3 + y4)) / 50.0
    [sA, sB, sC]
// 셀 색 판정: 각 slope를 %(×100) 소수 2자리 반올림한 값으로 서열 비교(CEO 지시). (기울기 3행 표시는 제거됨 — 판정만 존치.)
//  ▸ pctR(s) = math.round(s*10000)/100 = 로그 slope→%(×100)→소수2자리 반올림(banker's 아님, 0.5는 절댓값 큰 쪽으로).
//  ▸ green = pctR(ㄱ)>pctR(ㄴ)>pctR(ㄷ), red = pctR(ㄱ)<pctR(ㄴ)<pctR(ㄷ). 2자리 반올림 후 두 값이 같아지면 부등호 불성립→회색(노이즈 완화). 하나라도 na면 둘 다 false(회색).
f_pctR2(float s) => math.round(s * 10000.0) / 100.0
f_logGreen(float sA, float sB, float sC) => not na(sA) and not na(sB) and not na(sC) and f_pctR2(sA) > f_pctR2(sB) and f_pctR2(sB) > f_pctR2(sC)
f_logRed(float sA, float sB, float sC)   => not na(sA) and not na(sB) and not na(sC) and f_pctR2(sA) < f_pctR2(sB) and f_pctR2(sB) < f_pctR2(sC)

[emaSlA, emaSlB, emaSlC]   = f_logSlopes3(emaLine,  emaLine[1],  emaLine[2],  emaLine[3],  emaLine[4])
[demaSlA, demaSlB, demaSlC] = f_logSlopes3(demaLine, demaLine[1], demaLine[2], demaLine[3], demaLine[4])
[temaSlA, temaSlB, temaSlC] = f_logSlopes3(temaLine, temaLine[1], temaLine[2], temaLine[3], temaLine[4])

emaLogGreen  = f_logGreen(emaSlA,  emaSlB,  emaSlC)
emaLogRed    = f_logRed(emaSlA,   emaSlB,  emaSlC)
demaLogGreen = f_logGreen(demaSlA, demaSlB, demaSlC)
demaLogRed   = f_logRed(demaSlA,  demaSlB, demaSlC)
temaLogGreen = f_logGreen(temaSlA, temaSlB, temaSlC)
temaLogRed   = f_logRed(temaSlA,  temaSlB, temaSlC)

// 밴드 배경/추세 셀 공통 ATR(14) — 로그 slope 재설계로 옛 배경 판정부 bgAngleRef가 제거된 뒤 추세 셀 데드밴드용으로만 쓰였으나,
//  이제 밴드 배경 필터(정규화 갭·상대 데드존·크기 게이트)의 공통 스케일 V=ATR/close에도 쓰이므로 배경 판정보다 위에서 1회 계산해 재사용한다(신규 ta.* 아님·값 동일, 선언 위치만 상향).
ltAtrTable = ta.atr(14)
// =========================
// 밴드 배경 = 세 이평선의 1봉 로그 기울기(ㄱ) 지표간 서열(CEO 재정의) + 배경 필터 방식 4모드(CEO 지시·수학자 검증). TEMA>DEMA>EMA 정배열→녹(+1) / EMA>DEMA>TEMA 역배열→적(−1) / 그 외·na→없음(0).
//  ▸ 소스: 각 이평선의 1봉 로그 기울기 ㄱ = emaSlA/demaSlA/temaSlA(위 f_logSlopes3에서 계산, ln(line[0])-ln(line[1])). 재사용.
//  ▸ 공통 스케일·갭: V = ltAtrTable/close(무차원 per-bar 변동성 근사, close>0 가드 → close≤0/na면 Vok=false). g1 = temaSlA − demaSlA, g2 = demaSlA − emaSlA(원값 1봉 로그 기울기 갭, 2자리 반올림 전).
//  ▸ 모드별 bgBull/bgBear(bgHasSlopes na 가드는 전 모드 공통):
//     · 미적용        : 현행 순수 부등호 서열(f_pctR2 2자리 반올림). bgBull = pctR2(temaSlA)>pctR2(demaSlA)>pctR2(emaSlA). bgBear 대칭.
//     · 정규화 갭     : Vok(V>0) AND g1/V≥τ AND g2/V≥τ (bgBear는 −g1/V≥τ AND −g2/V≥τ). V>0 나눗셈 가드 필수.
//     · 상대 데드존   : g1≥k·V AND g2≥k·V (bgBear는 (−g1)≥k·V AND (−g2)≥k·V). 곱셈이라 V=0 안전(V=na만 가드).
//     · 크기 게이트   : 순수 서열(위 미적용식) AND 부호 판정 — bgBull은 temaSlA≥+m·V, bgBear는 temaSlA≤−m·V(CEO 승인 B안; 종전 |temaSlA|≥m·V). 기준 slope = TEMA ㄱ(정배열=세 slope 중 최대·역배열=최소, 정렬 방향 대표값).
//  ▸ 셀 색과 동일한 2자리 반올림(f_pctR2)으로 순수 서열을 비교(미세차 뭉갬 방지, 셀색 판정과 일관). 세 slope 중 na 하나라도 있으면(bgHasSlopes=false) 전 모드에서 배경 없음(0).
//  ▸ ⚠️ 셀 색(기울기 3행)은 각 행 시간축 ㄱ>ㄴ>ㄷ 서열 기준으로 불변. 배경만 지표간 서열+필터 기준 — 의도된 분리(셀=시간축, 배경=지표간).
//  ▸ 라이브 갱신: emaSlA/demaSlA/temaSlA가 line[0] 포함이라 배경도 라이브 봉 동안 갱신될 수 있다(봉 마감 시 확정). 과거봉 확정.
// =========================
bgHasSlopes = not na(emaSlA) and not na(demaSlA) and not na(temaSlA)
// 공통 스케일 V·갭 g1/g2. close>0 가드로 V 유효성(bgVok) 판정. V가 na여도 아래 곱셈(데드존)은 안전, 나눗셈(정규화 갭)은 bgVok로 가드.
bgV = close > 0 ? ltAtrTable / close : na
bgVok = not na(bgV) and bgV > 0
bgG1 = (na(temaSlA) or na(demaSlA)) ? na : temaSlA - demaSlA
bgG2 = (na(demaSlA) or na(emaSlA)) ? na : demaSlA - emaSlA
// 순수 서열(미적용 모드 + 크기 게이트 모드의 서열 부분 공통). f_pctR2 2자리 반올림 부등호.
bgSeqBull = bgHasSlopes and f_pctR2(temaSlA) > f_pctR2(demaSlA) and f_pctR2(demaSlA) > f_pctR2(emaSlA)
bgSeqBear = bgHasSlopes and f_pctR2(emaSlA) > f_pctR2(demaSlA) and f_pctR2(demaSlA) > f_pctR2(temaSlA)
// 모드별 bgBull/bgBear 산출(bool 초기 대입 후 if/else 재대입 — 줄 연속 회피). 전 모드 bgHasSlopes(na 가드) 공통 적용.
bool bgBull = false
bool bgBear = false
if bgHasSlopes
    if bgFilterMode == "정규화 갭"
        bgBull := bgVok and (bgG1 / bgV >= bgGapTau) and (bgG2 / bgV >= bgGapTau)
        bgBear := bgVok and (-bgG1 / bgV >= bgGapTau) and (-bgG2 / bgV >= bgGapTau)
    else if bgFilterMode == "상대 데드존"
        // 곱셈이라 V=0 안전(데드존 폭 0 → 순수 부등호 회귀). V=na(close 결측)만 not na(bgV)로 차단해 na→bool 대입 방지.
        bgBull := not na(bgV) and (bgG1 >= bgDeadK * bgV) and (bgG2 >= bgDeadK * bgV)
        bgBear := not na(bgV) and ((-bgG1) >= bgDeadK * bgV) and ((-bgG2) >= bgDeadK * bgV)
    else if bgFilterMode == "기울기 크기 게이트"
        // V=na(close 결측)면 크기 게이트 판정 불가 → 배경 없음. not na(bgV) 가드로 na→bool 대입 방지(V=0이면 문턱 0 → 순수 서열만).
        //  부호 판정(CEO 승인 B안·수학자 검산): 정배열은 TEMA ㄱ ≥ +m·V, 역배열은 TEMA ㄱ ≤ −m·V(종전 |TEMA ㄱ|≥m·V의 반대 부호 가지 제거).
        bgBull := bgSeqBull and not na(bgV) and (temaSlA >= bgSizeM * bgV)
        bgBear := bgSeqBear and not na(bgV) and (temaSlA <= -bgSizeM * bgV)
    else
        bgBull := bgSeqBull
        bgBear := bgSeqBear
// 셀 색 컨플루언스(CEO 지시): 지표간 서열(bgBull/bgBear)이어도 기울기 3행 셀 색과 어긋나면 배경 억제(0). 전 모드 공통 AND.
//  ⚠️ 기울기 3행 '표시'는 2026-10-16 CEO 지시로 제거됐으나 이 판정(emaLogGreen/Red 등)은 bgFillState 컨플루언스로 계속 쓰인다(존치).
//  ▸ anyCellRed/Green = 3행(EMA/DEMA/TEMA 각 행 시간축 ㄱ>ㄴ>ㄷ 서열) 셀 중 하나라도 적/녹. 위 emaLogRed 등 재사용.
//  ▸ 녹 배경인데 셀 하나라도 적이면 → 억제. 적 배경인데 셀 하나라도 녹이면 → 억제. 셀 na(회색)는 red/green 둘 다 false라 억제 안 함(정상).
anyCellRed   = emaLogRed or demaLogRed or temaLogRed
anyCellGreen = emaLogGreen or demaLogGreen or temaLogGreen
bgFillState = (bgBull and not anyCellRed) ? 1 : (bgBear and not anyCellGreen) ? -1 : 0

isLowerBand2Break = shouldPlot and showBand_2 and not na(lowerBandValue2) and low < lowerBandValue2
isUpperBand2Break = shouldPlot and showBand_2 and not na(upperBandValue2) and high > upperBandValue2
// Rare wide-range candles can sweep both sides; bias the highlight toward the close vs VWAP.
color breakHighlightLineColor = DEFAULT_LINE_COLOR
if isLowerBand2Break and not isUpperBand2Break
    breakHighlightLineColor := LOWER_BREAK_LINE_COLOR
else if isUpperBand2Break and not isLowerBand2Break
    breakHighlightLineColor := UPPER_BREAK_LINE_COLOR
else if isLowerBand2Break and isUpperBand2Break
    breakHighlightLineColor := close <= vwapValue ? LOWER_BREAK_LINE_COLOR : UPPER_BREAK_LINE_COLOR

color activeLineColor = enableDynamicLineColor ? breakHighlightLineColor : DEFAULT_LINE_COLOR
color activeFillColor = color.new(activeLineColor, 92)

// =========================
// VWAP 중앙선 지지/저항 색 판정(CEO 확정 — near 구간 종가 + 꼬리 걸침 이탈). 화면 기본 VWAP 선(vwapValue) 전용.
//  판정에 쓰는 close·high·low·vwapValue·밴드1(upperBandValue1/lowerBandValue1)은 모두 현재봉의 확정 성격 세트값이다.
//   → 과거 봉 색은 재계산돼도 값이 불변이라 리페인팅(과거 변조) 없음. 형성 중 현재봉만 종가/고저 확정 전 색이 바뀔 수 있으나(정상적 인트라바 갱신) 봉 마감 시 확정된다.
//  "near 구간" = VWAP와 밴드1 사이의 **동적 %(pct) 범위**. 하단 near=[lowerNear, vwap], 상단 near=[vwap, upperNear]. 하단 near 최저=lowerNear, 상단 near 최고=upperNear.
//   ▸ upperNear = vwap + pct×(upperBand1 − vwap),  lowerNear = vwap − pct×(vwap − lowerBand1). 저항(하단)·지지(상단) 동일 pct 대칭.
//  [pct 동적 산출 — 밴드폭 반비례, 범위 [0.20, 0.60]]
//   ▸ 밴드폭 측정: bandWidth1 = upperBand1 − lowerBand1 (밴드1 폭 = 2×stdev×bandMult_1). near 가 밴드1 기준이므로 밴드1 폭 사용.
//   ▸ 정규화(종목·가격 무관): r = bandWidth1 / vwap (가격 대비 밴드폭 비율). 절대값이 아닌 비율.
//   ▸ 매핑(반비례): r≤rLow(저변동성·좁은밴드)→최대%(0.60), r≥rHigh(고변동성·넓은밴드)→최소%(0.20), 사이는 선형보간·clamp.
//       t = clamp((r − rLow)/(rHigh − rLow), 0, 1);  nearPct = maxPct − t×(maxPct − minPct);  pct = clamp(nearPct, 0, 100)/100.
//   ▸ rLow=vwapNearRLowPct/100(기본 0.5%), rHigh=vwapNearRHighPct/100(기본 2.0%). rHigh≤rLow(임계 뒤집힘)·vwap==0(r na)이면 t=0 → 최대%(넓은 near, 판정 보수화) 폴백.
//  ▸ 저항(빨강, UPPER_BREAK_LINE_COLOR) =
//     ① lowerNear ≤ close ≤ vwap                (하단 near 안에 종가 마감 → VWAP이 저항)  OR
//     ② close < lowerNear AND high > lowerNear   (종가는 하단 near 아래로 이탈했으나 고가가 하단 near 최저 위 = 꼬리 걸침)
//  ▸ 지지(녹, LOWER_BREAK_LINE_COLOR) =
//     ③ vwap ≤ close ≤ upperNear                (상단 near 안에 종가 마감 → VWAP이 지지)  OR
//     ④ close > upperNear AND low < upperNear    (종가는 상단 near 위로 이탈했으나 저가가 상단 near 최고 아래 = 꼬리 걸침)
//  ▸ 그 외(완전 이탈: close가 near 구간 밖 + 꼬리도 near에 안 걸침 / na 워밍업) → 중립(흰, DEFAULT_LINE_COLOR).
//  ★ close==vwap 경계: ①은 close≤vwap, ③은 close≥vwap이라 close==vwap이 양쪽에 걸린다. **저항을 먼저 평가**(if 저항 → else if 지지)해
//    close==vwap이면 저항(빨강)으로 확정한다. 부동소수라 실제 동일값은 드묾.
//  ★ 상호배타·구멍 없음 검증:
//    · 저항 계열(close≤vwap[①] or close<lowerNear[②])과 지지 계열(close≥vwap[③] or close>upperNear[④])은 close==vwap 외엔 배타(위 우선순위로 close==vwap도 저항 단일 확정).
//    · ②(close<lowerNear)와 ①(close≥lowerNear) 배타, ④(close>upperNear)와 ③(close≤upperNear) 배타.
//    · lowerNear ≤ vwap ≤ upperNear(pct≥0·밴드 구조상 항상 성립)이므로 ②(close<lowerNear)와 ④(close>upperNear)도 동시 성립 불가.
//  엣지케이스: (a) close==vwap → 저항(빨강, 위 우선순위). (b) 밴드1/vwap na(워밍업) → 진입 가드에서 걸러져 흰.
//   (c) 밴드1 편차 0(도지) lowerBand1==upperBand1==vwap → bandWidth1=0 → r=0(≤rLow)이라 pct=최대나, upperNear==vwap·lowerNear==vwap로 near 구간 소멸.
//       close==vwap이면 ① 해당(저항), close≠vwap이면 ②(high>vwap==lowerNear)/④(low<vwap==upperNear)의 꼬리 걸침으로 판정. 확정봉 세트값이라 리페인팅 없음.
//  enableDynamicLineColor(밴드2 이탈 녹/빨강)와 독립한 별도 VWAP 선 전용 색이다.
// =========================
// 지지/저항 "상태"(vwapResistance/vwapSupport)를 판정해 VWAP 선색(vwapSRColor)을 결정한다.
//   - 판정 산식(pct/near/저항·지지)은 아래 near 구간 종가·꼬리 걸침 규칙과 동일하다.
//   - 색 적용(vwapSRColor 칠하기)은 옵션(enableVwapSRColor)에 종속한다(선색 표시 거동 보존). 즉 "상태 판정은 항상 / 색칠은 옵션 ON일 때만".
//   - shouldPlot·밴드1/vwap na 가드는 유지 → 워밍업엔 둘 다 false(중립)라 흰색.
bool vwapResistance = false
bool vwapSupport = false
color vwapSRColor = DEFAULT_LINE_COLOR
if shouldPlot and not na(vwapValue) and not na(upperBandValue1) and not na(lowerBandValue1)
    // [pct 동적 산출] 밴드폭 반비례. 밴드폭/VWAP 비율 r을 rLow~rHigh 사이 정규화 → maxPct~minPct 반비례 매핑. 확정봉 세트값 → 리페인팅 없음.
    float bandWidth1 = upperBandValue1 - lowerBandValue1          // 밴드1 폭(= 2×stdev×bandMult_1)
    float rNear = vwapValue != 0 ? bandWidth1 / vwapValue : na    // 가격 대비 밴드폭 비율(종목·가격 무관 정규화)
    float rLow  = vwapNearRLowPct / 100.0                         // 저변동성 임계(입력 %→비율)
    float rHigh = vwapNearRHighPct / 100.0                        // 고변동성 임계(입력 %→비율)
    // 임계 뒤집힘(rHigh<=rLow)·rNear na(vwap 0)면 보간 불가 → t=0 → 최대%(넓은 near, 판정 보수화) 폴백.
    float tNear = (na(rNear) or rHigh <= rLow) ? 0.0 : math.min(math.max((rNear - rLow) / (rHigh - rLow), 0.0), 1.0)
    float nearPct = vwapNearMaxPct - tNear * (vwapNearMaxPct - vwapNearMinPct)  // 반비례: t=0(저변동·좁음)→max(0.60), t=1(고변동·넓음)→min(0.20)
    float pct = math.min(math.max(nearPct, 0.0), 100.0) / 100.0   // 최종 clamp [0,100] 후 비율화
    // near 구간 경계(밴드1 기준). 도지(편차 0)면 upperNear==vwap / lowerNear==vwap로 수렴 → strict 부등호가 꼬리 판정으로 자연 처리.
    float upperNear = vwapValue + pct * (upperBandValue1 - vwapValue)
    float lowerNear = vwapValue - pct * (vwapValue - lowerBandValue1)
    // 저항 = ①(하단 near 안 종가) OR ②(종가 하단 near 아래 이탈 + 고가 꼬리 걸침). ② high>lowerNear로 꼬리가 하단 near 최저 위에 닿았는지 판정.
    bool isResistance = (close >= lowerNear and close <= vwapValue) or (close < lowerNear and high > lowerNear)
    // 지지 = ③(상단 near 안 종가) OR ④(종가 상단 near 위 이탈 + 저가 꼬리 걸침). ④ low<upperNear로 꼬리가 상단 near 최고 아래에 닿았는지 판정.
    bool isSupport = (close >= vwapValue and close <= upperNear) or (close > upperNear and low < upperNear)
    // ★ close==vwap 우선순위: 저항을 먼저 확정(지지보다 먼저). 상태 boolean도 동일 우선순위로 상호배타 도출.
    if isResistance
        vwapResistance := true                  // 저항 상태(빨강). close==vwap은 여기서 우선 확정(지지보다 먼저).
    else if isSupport
        vwapSupport := true                     // 지지 상태(녹).
    // 색칠은 옵션 ON일 때만(판정 로직 보존용 — 상태 판정과 독립). ⚠️ CEO 지시로 VWAP 중앙선 plot 색은 고정 흰색(DEFAULT_LINE_COLOR)으로 전환되어,
    //   아래 vwapSRColor(녹/빨강/흰 산출)는 더 이상 VWAP 선 색에 반영되지 않는다(판정 로직·상태 boolean은 향후 재사용 대비 보존).
    if enableVwapSRColor
        vwapSRColor := vwapResistance ? UPPER_BREAK_LINE_COLOR : vwapSupport ? LOWER_BREAK_LINE_COLOR : DEFAULT_LINE_COLOR

// =========================================================================================
// [z-order 블록 #1 — VWMA 50/100/200 + 100~200 fill]  ★ plot/fill 중 가장 뒤(back-most).
//  explicit_plot_zorder=true이므로 이 plot/fill들을 파일에서 가장 먼저 선언 → 이후 모든 plot/fill(VWAP·밴드·정역배열·리본)보다 뒤에 그려진다.
//  ⚠️ 비정상 매수/매도는 이제 barcolor(캔들 몸통색)이라 plot/fill과 레이어가 다르다(봉 몸통 ↔ 밴드 배경) → 이 VWMA/fill과 z-order 경합 없이 캔들 위에 별도로 그려진다.
//     실제 레이어(뒤→앞) = [이 VWMA 블록] → [나머지 페인팅]; 비정상은 barcolor로 캔들 몸통에 직접(밴드 배경과 공존).
//  ⚠️ 계산(f_ltMa·vwma20/50·ltMa1/2·ltUp)·plot 산식·색·오프셋·display는 이동 전과 100% 동일 — 오직 선언 위치(z-order)만 앞으로 옮겼다.
//  ⚠️ ta.vwma/f_ltMa 확정봉 기반 → 신규 리페인팅 없음. 우측 가격축 라벨 제거(display.all - display.price_scale, 다른 선과 동일 패턴).
// =========================================================================================
// 100/200선: 원본 f_ltMa switch 그대로(기본 VWMA). 50선/20선: ta.vwma 고정(원본 동일).
f_ltMa(int length) =>
    switch ltMaType
        "SMA" => ta.sma(close, length)
        "EMA" => ta.ema(close, length)
        "WMA" => ta.wma(close, length)
        "VWMA" => ta.vwma(close, length)
vwma20 = ta.vwma(close, 20)   // 단기 추세(20선 vs 50선)의 빠른 선. 로직 전용(페인트 없음). 원본 동일.
vwma50 = ta.vwma(close, 50)   // 단기 추세의 느린 선이자 표시선(2px). 원본 동일.
ltMa1 = f_ltMa(ltLen1)        // 거래량 가중 100선
ltMa2 = f_ltMa(ltLen2)        // 거래량 가중 200선
ltUp = ltMa1 > ltMa2          // 우상향 장기 추세(100선 > 200선)
// 50선 색 = vwma50Color(딥 오렌지 #FF6D00 기본 — 리본 노랑과 구분). 100/200/fill 색은 원본 따름(파랑/보라).
plot(showVwma50 ? vwma50 : na, title="거래량 가중 50선(VWMA 50)", color=vwma50Color, linewidth=2, display=display.all - display.price_scale, editable=true)
ltPlot1 = plot(showLongTrend ? ltMa1 : na, title="거래량 가중 100선(VWMA 100)", color=ltColor1, linewidth=2, display=display.all - display.price_scale, editable=true)
ltPlot2 = plot(showLongTrend ? ltMa2 : na, title="거래량 가중 200선(VWMA 200)", color=ltColor2, linewidth=2, display=display.all - display.price_scale, editable=true)
fill(ltPlot1, ltPlot2, title="100~200선 fill", color=showLongTrend ? (ltUp ? color.new(ltColor1, ltFillTransp) : color.new(ltColor2, ltFillTransp)) : na, editable=true)

// =========================================================================================
// [비정상 매수/매도 — 캔들 몸통색(barcolor)]  ★ CEO 지시(배경 bgcolor → 캔들 몸통색 전환).
//  ⚠️ 표현 매체 전환: 직전엔 이 비정상 구간을 전체 화면 세로 배경(bgcolor)으로 칠했으나, CEO 지시로 **해당 봉의 캔들 몸통색(barcolor)** 오버라이드로 옮긴다.
//   → 비정상 구간에서만 barcolor로 몸통을 칠하고(매도=파랑·매수=붉은색, 색상 승계), 비정상이 아닌 봉은 barcolor(na)로 캔들 기본색을 유지(오버라이드 안 함).
//  ⚠️ z-order: barcolor는 봉의 몸통색 자체를 바꾸는 것이라 밴드 fill(정/역배열 배경)·bgcolor와 레이어가 다르다(캔들 몸통 vs 밴드 배경 → 시각 충돌 없이 공존).
//   비정상 캔들색과 정배열/역배열 밴드 배경이 동시에 떠도 서로 다른 대상(봉 몸통 ↔ 밴드 영역)에 그려지므로 겹쳐도 판독 가능.
//  ⚠️ 색·조건·판정(abnBarColor/abnShowBg/abnCandleState 래치)은 전부 불변 — 렌더 매체만 bgcolor→barcolor로 전환(배경 투명도 abnBgTransp는 캔들색엔 미적용, 위 abnBarColor 주석 참조).
// =========================================================================================
barcolor(abnShowBg ? abnBarColor : na, title="비정상 매수/매도 캔들색")

// VWAP 중앙선: 두께 1px·점선(dashed)(CEO 지시 — 밴드2선과 동일 스타일). 선색은 고정 단색(중립 흰색, DEFAULT_LINE_COLOR), 우측 가격축 라벨은 흰색 고정(CEO 지시).
//  ▸ 색 고정(CEO 지시): 직전엔 지지/저항 판정(vwapLineColor: 녹=지지·빨강=저항·흰=중립)으로 봉 단위 동적 변색했으나, CEO 지시로 **고정 중립 흰색(DEFAULT_LINE_COLOR)** 으로 전환한다.
//    → 지지/저항 "판정 로직"(vwapResistance/vwapSupport/vwapSRColor 블록·enableVwapSRColor 옵션)은 보존하되, 이 VWAP 중앙선 plot의 color 참조만 고정색으로 바꾼다(선색 표시가 판정에 더 반응하지 않음).
//  ▸ 값·계산 전부 불변 — 렌더 스타일(1px·점선)·표시 게이트도 불변, 오직 선 color 인자만 vwapLineColor → DEFAULT_LINE_COLOR로 교체.
//  ▸ 표시 게이트(CEO 지시): showVwapLine(기본 ON)이면 pane·상태줄·데이터윈도우에 표시(밴드2와 동일 display.all − display.price_scale), 끄면 display.none으로 선만 숨김.
//  ▸ 점선/1px: 밴드2선(upperBand_2/lowerBand_2)과 동일하게 plot()의 linestyle=plot.linestyle_dashed·linewidth=1 사용(밴드2와 같은 dash 스타일·굵기).
//  ▸ 흰색 가격축 라벨 plot: 값·색(흰색)·display 전부 불변(기존 그대로) — 이번 변경 대상 아님. 라벨 동작 유지.
displayVwapLine = showVwapLine ? display.all - display.price_scale : display.none
plot(vwapValue, title="브이왑", color=DEFAULT_LINE_COLOR, offset=offset, linewidth=1, display=displayVwapLine, editable=true, linestyle=plot.linestyle_dashed)
plot(vwapValue, title="VWAP 가격축 라벨", color=color.white, offset=offset, display=display.none, editable=true)

upperBand_1 = plot(upperBandValue1, title="Upper Band #1", color=activeLineColor, offset=offset, display=display.none, editable=true, linestyle=plot.linestyle_dotted)
lowerBand_1 = plot(lowerBandValue1, title="Lower Band #1", color=activeLineColor, offset=offset, display=display.none, editable=true, linestyle=plot.linestyle_dotted)
fill(upperBand_1, lowerBand_1, title="Bands Fill #1", color=activeFillColor, display=display.none, editable=true)

// 최외곽 상/하단 선(Band #2): 위치는 항상 원값. 두께 1px. 선 색은 활성 기본색(activeLineColor) 고정.
//  ▸ 롤백(CEO 지시): 직전에 넣었던 "밴드2 선색을 paintState(정/역배열)에 따라 순수 녹/빨강으로 바꾸는" 조건식을 완전히 제거하고, 원래대로 activeLineColor(무조건)로 환원한다.
//    그에 따라 신설했던 input band2BullLineColor/band2BearLineColor도 삭제(참조 끊김). 그 순수 녹/빨강 색값은 아래 "실시간 상승/하락 전환 수평선"(Part C)으로 이관해 재사용한다.
//  ⚠️ 밴드2 값·산식·fill(Sonar 배경 '밴드 내부')은 불변 — 이번 롤백은 선 색만 activeLineColor로 되돌린다.
displayBand2 = showBand_2 ? display.all - display.price_scale : display.none
upperBand_2 = plot(upperBandValue2, title="Upper Band #2", color=activeLineColor, offset=offset, display=displayBand2, editable=true, linewidth=1, linestyle=plot.linestyle_dashed)
lowerBand_2 = plot(lowerBandValue2, title="Lower Band #2", color=activeLineColor, offset=offset, display=displayBand2, editable=true, linewidth=1, linestyle=plot.linestyle_dashed)
// fill(±2σ 채움)은 밴드2 원값 선(upperBand_2/lowerBand_2)에 직접 붙인다. clamp 폐기로 선 자체가 항상 원값이라 별도 fill ref plot 불필요. 현재 display=none.
fill(upperBand_2, lowerBand_2, title="Bands Fill #2", color=activeFillColor, display=display.none, editable=true)
// ══ Sonar 모멘텀 배경(CEO 지시 2026-10-16 — 구 '밴드워킹' 배경 페인팅 대체) ══
//  ⚠️ 구 밴드워킹 배경과 그 전용 계산(20봉 computeVwapSet(vwapStateBars)·vwOut*/vwSlope*/vwBwExpanding/vwBreak*/vwWalk*·vwUpperWalk/vwLowerWalk·bgWalkPaintState·bgFillColor)
//     및 전용 input(vwapStateBars·showRibbonExpBg·ribbonBullBgColor·ribbonBearBgColor·ribbonBgTransp)은 전부 제거됨(다른 소비처 없음 — grep 확인).
//  ▸ 산식: sonarEma = EMA(close, n), sonar = sonarEma − sonarEma[k], sonarSignal = EMA(sonar, m). 판정 diff = (0선 ? sonar : sonar − sonarSignal).
//  ▸ 상태 래치(var int): diff>0 → +1(상승), diff<0 → −1(하락), diff==0 → 이전 유지. 워밍업(미준비) 봉은 0(배경 없음).
//  ▸ 워밍업: sonarEma는 n−1번째 봉부터, sonar는 n+k−1번째, sonarSignal은 n+k+m−2번째 봉부터 유효 → bar_index 문턱 + na 이중 가드.
//  ▸ 리페인팅: close[0] 포함이라 실시간 봉은 틱마다 갱신(var는 틱마다 직전 확정값으로 롤백 후 재계산), 봉 마감 시 확정. 미래참조·request.* 없음. 과거 참조는 [k](k≤500)뿐 → max_bars_back=1000 안.
//  ▸ z-order: '밴드 내부' fill은 구 밴드워킹 fill과 같은 선언 위치(밴드2 plot 뒤·리본 plot 앞)라 스크립트 내부 레이어 불변. bgcolor는 스크립트 배경 그룹(최후면).
//    캔들과의 관계: indicator(behind_chart=true)로 이 fill/bgcolor를 포함한 스크립트 전체가 메인 캔들 뒤에 그려진다(상단 indicator() 주석 참조).
sonarEma = ta.ema(close, sonarLen)
sonar = sonarEma - sonarEma[sonarGap]
sonarSignal = ta.ema(sonar, sonarSigLen)
sonarZeroMode = sonarBasis == "0선"
sonarReady = sonarZeroMode ? (bar_index >= sonarLen + sonarGap - 1 and not na(sonar)) : (bar_index >= sonarLen + sonarGap + sonarSigLen - 2 and not na(sonar) and not na(sonarSignal))
sonarDiff = sonarZeroMode ? sonar : sonar - sonarSignal
var int sonarState = 0
if not sonarReady
    sonarState := 0
else if sonarDiff > 0
    sonarState := 1
else if sonarDiff < 0
    sonarState := -1
sonarFillColor = sonarState == 1 ? color.new(sonarBullColor, sonarTransp) : sonarState == -1 ? color.new(sonarBearColor, sonarTransp) : na
sonarInBand = sonarArea == "밴드 내부"
fill(upperBand_2, lowerBand_2, color = (showSonarBg and sonarInBand and shouldPlot and not na(upperBandValue2) and not na(lowerBandValue2)) ? sonarFillColor : na, title="Sonar 배경(밴드 내부)", display=display.all, editable=true)
bgcolor(showSonarBg and not sonarInBand ? sonarFillColor : na, title="Sonar 배경(차트 전체)", offset=offset, editable=true)

// 지수 추세 리본 3선(EMA/DEMA/TEMA) — 각 1px, 우측 가격축 라벨 ON(display.all, CEO 지시). 표시 전용 오버레이.
//  ⚠️ ta.ema 누적(확정 성격)이라 신규 리페인팅 없음. showRibbon OFF면 na로 미표시(라벨도 함께 사라짐).
//  ▸ 각 plot의 color(ribbonEmaColor/ribbonDemaColor/ribbonTemaColor)가 가격축 라벨 색에 자동 반영(선 색 = 라벨 색). 선 굵기·색·값·리페인팅은 불변, price_scale 라벨만 추가.
plot(showRibbon ? emaLine : na, title="지수 리본 EMA", color=ribbonEmaColor, offset=offset, linewidth=1, display=display.all, editable=true)
plot(showRibbon ? demaLine : na, title="지수 리본 DEMA", color=ribbonDemaColor, offset=offset, linewidth=1, display=display.all, editable=true)
plot(showRibbon ? temaLine : na, title="지수 리본 TEMA", color=ribbonTemaColor, offset=offset, linewidth=1, display=display.all, editable=true)

// 비정상 매수/매도 캔들 몸통색 barcolor()는 위쪽(VWMA 블록 뒤)에서 선언한다(CEO 지시 — 배경 bgcolor → barcolor 전환 주석 참조).
//  barcolor는 봉의 몸통색을 바꾸는 것이라 밴드 fill·bgcolor와 레이어가 달라 공존한다. 색·조건·판정(abnCandleState 래치)은 불변이다.

// =========================================================================================
// [이식] 윌리엄스 %R 다이버전스 — 원 마커(독립 지표, CEO 명시 유지).
//  ⚠️ CEO 지시로 전환 후보 삼각형·cRSI 필터·중복 억제 래치·%R 방향확인 억제(삼각형용)는 전면 제거됨.
//     %R 다이버전스 판정(ta.wpr·bullWprDiv/bearWprDiv)과 원 마커(plotshape)는 독립 지표로 그대로 유지한다.
//  기존 auto-vwap 로직(밴드 배경·비정상 캔들색·VWAP·밴드·테이블·이격도·되돌림·%R)은 전혀 건드리지 않는다.
// =========================================================================================

// ── 윌리엄스 %R 다이버전스 판정(williams-fractal 원본 그대로 이식) ──
//  wpr: 확정봉 close 기준. 직전 봉이 밴드 밖 진입(wpr[1]) + 현재 봉 다이버전스 조건 → 현재봉(offset 0) 원. 가격 비교는 종가(close).
//  리페인팅 0: close[1]·wpr[1]·wpr 모두 확정/과거참조. 미래참조 없음.
wpr = ta.wpr(wprLen)
bullWprDiv = wpr[1] < wprLower and (close < close[1] and wpr > wpr[1])   // 강세(매수): 과매도 진입 후 종가↓·%R↑
bearWprDiv = wpr[1] > wprUpper and (close > close[1] and wpr < wpr[1])   // 약세(매도): 과매수 진입 후 종가↑·%R↓

// ── %R 다이버전스 원 마커 — 확정된 현재봉(offset 0), belowbar(매수)/abovebar(매도). 화면 고정 픽셀 스택(자동 겹침 방지). ──
plotshape(showWprDiv and bullWprDiv, title="%R 강세 다이버전스(매수)", style=shape.circle, location=location.belowbar, color=color.new(wprBullColor, 0), size=size.tiny, offset=0)
plotshape(showWprDiv and bearWprDiv, title="%R 약세 다이버전스(매도)", style=shape.circle, location=location.abovebar, color=color.new(wprBearColor, 0), size=size.tiny, offset=0)

// =========================================================================================
// [T/D 크로스 4-상태 판정 — SSOT(Single Source Of Truth)]
//  ⚠️ 위치 사유(선언 순서): 이 블록은 원래 상태 테이블 "T/D 크로스 행" 부근(파일 후반)에 있었으나,
//     아래 "기울기 정렬 삼각형" 블록의 T/D 크로스 필터가 이 판정 bool을 참조하므로 삼각형 렌더보다 위로 옮겼다.
//     Pine은 선언 순서가 곧 스코프다 — 참조자보다 아래에서 선언되면 컴파일 에러.
//  ⚠️ 이동에 따른 값 변화 없음: 이 블록은 ribbonLen(input)·ribbonE1/E2/E3(449~451행)·temaLine/demaLine(453~454행)·close 만
//     참조하는 순수 계산이며, 모두 이 지점보다 위에서 선언된다. 내부에 var/varip·ta.* 상태 함수가 없고
//     과거참조([o])만 쓰므로 호출 위치가 바뀌어도 봉별 결과가 동일하다(재계산·요청 호출 추가 없음).
//  ▸ 이 블록이 산출하는 4-상태(테이블 셀 색과 삼각형 억제가 공유하는 단일 진실 공급원):
//     ① tdxDimRed   = 데드 & (cur<avg, 둘 다 유효) → 저채도 적 SR50_BELOW  … 데드 압력이 완화되는 중 → 삼각형 억제 안 함
//     ② tdxFullRed  = 데드 & 그 외                 → 원색 적 ltDownColor    … 파랑 삼각형(△) 억제
//     ③ tdxDimGreen = 골든 & (cur>avg, 둘 다 유효) → 저채도 녹 SR50_ABOVE  … 골든이 되돌려지는 중 → 삼각형 억제 안 함
//     ④ tdxFullGreen= 골든 & 그 외                 → 원색 녹 ltUpColor      … 빨강 역삼각형(▽) 억제
//     ⑤ 위 넷 모두 false(temaLine==demaLine·na)   → 회색 gray·40           … 억제 안 함
//     tdxDead/tdxGold는 상호배타(temaLine<demaLine / >demaLine)이고 각 내부도 이분이라 ①~⑤는 완전·배타 분할이다.
//  ⚠️ 색 결정은 여전히 SR50_*/ltUp/ltDown 색 상수가 선언된 뒤(파일 후반 tdxCellColor)에서만 하고,
//     이 블록은 "판정 bool"만 만든다 — 색 상수를 앞으로 끌어오지 않으므로 색 관련 회귀 위험이 없다.
//  ⚠️ tdxGold/tdxDead/tdxOvr/tdxCur/tdxAvg의 산식·na 처리는 이동 전과 100% 동일(한 글자도 바꾸지 않음).
// =========================================================================================
tdxAlpha = 2.0 / (ribbonLen + 1)
tdxBeta  = 1.0 - tdxAlpha
tdxA = tdxAlpha * tdxBeta * tdxBeta                                          // A = α·β² (상수 — 리본 길이만 의존)
// offset o에서 골든 임계가격 X[o] 역산. e1/e2/e3=ribbonE1/E2/E3[o], B[o]=β·[β²·e1 − (2−α)·e2 + e3], X=−B/A. na/A≈0면 na.
f_crossX(int o) =>
    e1 = ribbonE1[o]
    e2 = ribbonE2[o]
    e3 = ribbonE3[o]
    b = tdxBeta * (tdxBeta * tdxBeta * e1 - (2.0 - tdxAlpha) * e2 + e3)      // B[o] = β·[β²·e1 − (2−α)·e2 + e3]
    (na(e1) or na(e2) or na(e3) or math.abs(tdxA) <= 1e-12) ? na : -b / tdxA
// offset o의 변화율 pct[o] = (X[o] − close[o]) / close[o] × 100. close≤0·na(X na=A≈0/워밍업)면 na.
//  ▸ CEO 정책(X≤0 가드 제거): 임계가 X≤0(강추세로 골든 임계가가 음수)여도 pct를 클램핑 없이 그대로 계산·반환한다.
//    이때 pct는 −100% 이하(예 −250%)의 큰 음수가 되며, "크로스가 아득히 멀다=강도"를 표현한다(실제 도달가격이 아니라 강도 파악 목적).
//    ⚠️ na로 남는 조건은 close≤0(비현실)·na(입력 na=워밍업, 또는 A≈0=상수라 사실상 불발생)뿐 — 정상 데이터에선 항상 값이 나온다. 상하한/클램핑 없음.
f_crossPct(int o) =>
    x = f_crossX(o)
    c = close[o]
    (na(x) or na(c) or c <= 0) ? na : (x - c) / c * 100.0
// pct 5봉(현재봉[0]~과거[4]) — cur=현재봉%, avg=현재봉 포함 5봉 중 "유효 봉만"의 부분평균.
//  ▸ 버그 수정(CEO 지적): 기존엔 5봉 중 하나라도 na면 avg 전체를 na로 전파 → 현재봉%가 유효한데도 과거 한 봉(X≤0 등)이 na면
//    평균(5)이 "-"로 비었다. cur(현재봉%)와 avg(평균%)는 서로 독립이어야 하므로, avg는 유효 봉만 합산·개수로 나눈 부분평균으로 계산한다.
//    유효 봉이 하나도 없을 때만 avg=na("-"). cur은 종전대로 pct[0](유효하면 값·na면 "-") — 두 값이 서로 영향 주지 않음.
//  ▸ 각 봉 na 조건(CEO 정책 — X≤0 가드 제거): A≈0(상수라 사실상 불발생)·close≤0(비현실)·na(워밍업)뿐. X≤0(강추세로 임계가가 음수)은 이제 na 아님 → pct를 큰 음수(예 −250%)로 그대로 계산(클램핑 없음, 강도 표현). 정상 데이터에선 항상 값 → 현재봉 '-'가 사라지고 cur/avg 비대칭 해소. 역산 수식·pct 정의는 불변.
tdxP0 = f_crossPct(0)
tdxP1 = f_crossPct(1)
tdxP2 = f_crossPct(2)
tdxP3 = f_crossPct(3)
tdxP4 = f_crossPct(4)
tdxCur = tdxP0
tdxSum = (na(tdxP0) ? 0.0 : tdxP0) + (na(tdxP1) ? 0.0 : tdxP1) + (na(tdxP2) ? 0.0 : tdxP2) + (na(tdxP3) ? 0.0 : tdxP3) + (na(tdxP4) ? 0.0 : tdxP4)
tdxCnt = (na(tdxP0) ? 0 : 1) + (na(tdxP1) ? 0 : 1) + (na(tdxP2) ? 0 : 1) + (na(tdxP3) ? 0 : 1) + (na(tdxP4) ? 0 : 1)
tdxAvg = tdxCnt == 0 ? na : tdxSum / tdxCnt
// 현재 크로스 상태(골든/데드) — 셀 색 기본 판정. temaLine==demaLine·na는 회색.
tdxGold = not na(temaLine) and not na(demaLine) and temaLine > demaLine
tdxDead = not na(temaLine) and not na(demaLine) and temaLine < demaLine
// 방향 오버라이드는 cur·avg 모두 유효(pct 유효)일 때만. 그 외엔 골든 녹·데드 적 기본색.
tdxOvr = not na(tdxCur) and not na(tdxAvg)
// ── 4-상태 판정 bool(SSOT) — 셀 색(tdxCellColor)과 삼각형 T/D 크로스 필터가 **둘 다 이것만** 소비한다. ──
//  종전 중첩 삼항식 `tdxDead ? (A ? DIM_R : FULL_R) : tdxGold ? (B ? DIM_G : FULL_G) : GRAY`
//  (A = tdxOvr and tdxCur < tdxAvg, B = tdxOvr and tdxCur > tdxAvg)와의 동치 증명:
//   · tdxDead=true  → DimRed=A, FullRed=not A, DimGreen=FullGreen=false → A면 DIM_R·아니면 FULL_R (종전과 동일)
//   · tdxGold=true  → DimRed=FullRed=false, DimGreen=B, FullGreen=not B → B면 DIM_G·아니면 FULL_G (종전과 동일)
//   · 둘 다 false   → 넷 모두 false → GRAY (종전과 동일)
//  ⚠️ 경계값 유지: cur==avg는 데드에서 tdxDimRed=false → 원색 적(FullRed), 골든에서 tdxDimGreen=false → 원색 녹(FullGreen).
//     tdxOvr=false(cur/avg 중 하나라도 na)도 Dim이 false가 되어 원색으로 떨어진다 — 종전 fallback과 동일.
tdxDimRed    = tdxDead and tdxOvr and tdxCur < tdxAvg   // 저채도 적(SR50_BELOW) — 데드 압력 완화 중
tdxFullRed   = tdxDead and not (tdxOvr and tdxCur < tdxAvg)   // 원색 적(ltDownColor) — 파랑 삼각형 억제 대상
tdxDimGreen  = tdxGold and tdxOvr and tdxCur > tdxAvg   // 저채도 녹(SR50_ABOVE) — 골든 되돌림 중
tdxFullGreen = tdxGold and not (tdxOvr and tdxCur > tdxAvg)   // 원색 녹(ltUpColor) — 빨강 역삼각형 억제 대상

// =========================================================================================
// [추세 전환가 — 추세전환 임계가격(P*) 역산] (CEO 지시 2026-10-16 · 알고리즘 수학자 제안서 "Auto VWAP 선행 추세 확인 6행 → P* 대체안" §2 수식 그대로)
//  ▸ 목적: 구 6행(TEMA/DEMA/EMA 기울기 %·기울기 배열 %·T/D 크로스 %·D/E 크로스 %)을 "다음 봉이 몇에 마감하면 추세 조건이 바뀌는가"라는 조건부 가격 P*로 대체한다.
//     ⚠️ P*는 "그 가격 이상(이하)으로 마감하면 조건이 충족된다"는 **조건부 가격**이다. 도달 확률·도달 후 기대수익은 말하지 않는다(가격 예측 아님).
//  ▸ 기준봉 오프셋 entryOff(제안서 §3 기준봉 표):
//     0 = 실시간봉(cRSI crossTableBase "실시간봉"과 같은 의미) — 현재 형성 중인 봉 [0]까지를 고정된 과거로 보고 **다음 봉 종가 C**를 미지수로 둔다.
//         고정값이 [0..]이라 형성 중인 봉의 틱마다 다시 계산된다(의도된 실시간 갱신). T/D는 제안서 X[0].
//     1 = 완성봉(직전 완성봉 [1]까지 고정, 형성 중인 봉 종가가 미지수 — 제안서 X[1]).
//     ▸ 결정(input entryBase, 기본 "완성봉" — cRSI crK와 같은 방식): 실시간봉 → 항상 0. 완성봉 → 마지막 봉이 끝났으면(시간 경과 timenow≥time_close,
//       time_close na면 isconfirmed 폴백, 또는 isconfirmed) 0, 형성 중이면 1. 히스토리 봉은 timenow≥time_close(또는 isconfirmed)라 항상 0 → 과거 값 불변.
//       Bar Replay에서도 timenow(실제 시각)>리플레이 봉 time_close라 0(cRSI와 동일 근거). 오프셋 1 참조는 indicator max_bars_back=1000 버퍼 안.
//     ▸ % 기준(cRSI crClose1=src[crK]와 동일): 기준봉 종가 close[entryOff] — 실시간봉=현재가, 완성봉(형성 중)=직전 완성봉 종가.
//  ▸ 선형 표현(제안서 §2 "선형 표현" 표): 미지 봉의 선 값 L' = a_L·C + b_L. e1p/e2p/e3p = ribbonE1/E2/E3[entryOff], α=tdxAlpha=2/(len+1), β=tdxBeta=1−α.
//     EMA : a_E = α                     b_E = β·e1p
//     DEMA: a_D = 1−β²  (= α(2−α))       b_D = β·[(2−α)·e1p − e2p]
//     TEMA: a_T = 1−β³  (= α(3−3α+α²))   b_T = β·[(3−3α+α²)·e1p − (3−α)·e2p + e3p]
//     공통 해 C* = (L'_target − b_L)/a_L. a_L>0(상수)이므로 C>C*이면 위쪽 상태, C<C*이면 아래쪽 상태.
//  ▸ 소스 가드(제안서 §2 "해의 존재와 예외 처리"): 리본 소스가 종가가 아니면(hlc3/ohlc4) P*가 종가 하나로 환원되지 않으므로 계산값을 표시하지 않고 "소스≠종가"로 표시한다.
//  ▸ 리페인팅: 과거 봉 값은 확정. 형성 중인 봉에서만 틱마다 갱신(미래참조·request.* 없음). 테이블은 barstate.islast에서만 그린다. 신호·알림·배경과 무관(표시 전용).
// =========================================================================================
entryBarClosed = not na(time_close) ? timenow >= time_close : barstate.isconfirmed   // cRSI crBarClosed와 동일식
entryOff = entryBase == "실시간봉" ? 0 : (entryBarClosed or barstate.isconfirmed) ? 0 : 1   // 기준봉 오프셋(0=마지막 봉·1=직전 완성봉) — cRSI crK와 동일식
entBaseC = close[entryOff]                     // % 기준가(기준봉 종가) — cRSI crClose1과 동일
entrySrcOk = ribbonSrc == "종가"               // 리본 소스=종가일 때만 P*가 다음 봉 종가 조건으로 성립
entE1p = ribbonE1[entryOff]
entE2p = ribbonE2[entryOff]
entE3p = ribbonE3[entryOff]
// 선형 계수 a_L(상수)·b_L(기준봉 누적값) — 제안서 §2 표
entAE = tdxAlpha
entAD = 1.0 - tdxBeta * tdxBeta
entAT = 1.0 - tdxBeta * tdxBeta * tdxBeta
entBE = tdxBeta * entE1p
entBD = tdxBeta * ((2.0 - tdxAlpha) * entE1p - entE2p)
entBT = tdxBeta * ((3.0 - 3.0 * tdxAlpha + tdxAlpha * tdxAlpha) * entE1p - (3.0 - tdxAlpha) * entE2p + entE3p)
// 기준봉 선 값 L[o](= 미지 봉 직전의 고정 선 값)
entEmaP  = emaLine[entryOff]
entDemaP = demaLine[entryOff]
entTemaP = temaLine[entryOff]

// ① TEMA/DEMA 전환 — 제안서 §2 이벤트 표 "ㄱ 부호 전환(선이 꺾임): L' = L[o]" → C* = (L[o] − b_L)/a_L.
//    기준봉 ㄱ(temaSlA/demaSlA[entryOff] = 고정 봉의 1봉 로그 기울기)이 양수면 하락전환가(C<C*이면 다음 봉 ㄱ<0), 0 이하면 상승전환가(C>C*이면 ㄱ>0).
entTemaX = (entTemaP - entBT) / entAT
entDemaX = (entDemaP - entBD) / entAD
entTemaSl = temaSlA[entryOff]
entDemaSl = demaSlA[entryOff]

// ② T/D 전환 — 제안서 §2 "T/D 크로스: TEMA'=DEMA' → X = −B(e[o])/(αβ²)". 기존 f_crossX(o) 그대로(a_T−a_D=αβ², b_T−b_D=B 와 동일식).
//    실시간봉/마감된 마지막 봉(entryOff=0) → X[0], 완성봉 모드·형성 중(entryOff=1) → X[1]. 기준봉이 골든(tdxGold)이면 데드전환가(C<X), 아니면 골든전환가(C>X).
entTdX = f_crossX(entryOff)
entTdGold = tdxGold[entryOff]

// ③ 배열 전환(근사) — 제안서 §2 "기울기 배열 갭 g1 = ㄱT−ㄱD ≥ τV": K = (T[o]/D[o])·e^{τV}, C* = (K·b_D − b_T)/(a_T − K·a_D). g2(D/E)도 같은 형태.
//    정배열 진입가 = max(C*_g1, C*_g2)(C 이상이면 두 갭 조건 동시 충족). 역배열 진입가는 대칭(−g ≥ τV ⇔ 지수 −τV, C 이하) → min(C*'_g1, C*'_g2).
//    ▸ 문턱 s(밴드 배경 필터 모드별, bgFillState 판정식과 같은 문턱): 정규화 갭 = τ·V(V>0 필요) / 상대 데드존 = k·V / 미적용·기울기 크기 게이트 = 0(순수 서열).
//    ▸ 기울기 크기 게이트 모드는 추가로 TEMA 목표 기울기(제안서 §2 "목표 기울기 s: L' = L[o]·e^s", s=±m·V)를 max/min에 포함한다.
//      판정식이 부호 판정(정배열 TEMA ㄱ≥+m·V / 역배열 ≤−m·V, CEO 승인 B안)이라 이 max/min 반영은 판정식과 정확히 일치한다(수학자 검산 위반 0/400).
//    ▸ 근사 범위(제안서 §5): V(=ATR14/close)를 기준봉 값으로 동결, 기울기 셀색 컨플루언스(anyCellRed/Green)·pctR2 2자리 반올림 생략 → 필요조건. 봉 마감 후 셀 색으로 최종 확인.
//    ▸ 분모 a_F − K·a_S ≤ 0(선 비율이 비현실적으로 벌어진 퇴화 케이스)·선 값 ≤0·na → na("-").
f_entGapX(float fP, float sP, float aF, float bF, float aS, float bS, float s) =>
    float k = (na(fP) or na(sP) or fP <= 0 or sP <= 0 or na(s)) ? na : (fP / sP) * math.exp(s)
    float den = na(k) ? na : aF - k * aS
    (na(den) or den <= 0) ? na : (k * bS - bF) / den
f_entSlopeX(float lP, float a, float b, float s) => (na(lP) or lP <= 0 or na(s)) ? na : (lP * math.exp(s) - b) / a
entV = bgV[entryOff]
entS = bgFilterMode == "정규화 갭" ? ((not na(entV) and entV > 0) ? bgGapTau * entV : na) : bgFilterMode == "상대 데드존" ? (na(entV) ? na : bgDeadK * entV) : 0.0
entGate = bgFilterMode == "기울기 크기 게이트"
entGateS = entGate and not na(entV) ? bgSizeM * entV : na
entBullG1 = f_entGapX(entTemaP, entDemaP, entAT, entBT, entAD, entBD, entS)
entBullG2 = f_entGapX(entDemaP, entEmaP, entAD, entBD, entAE, entBE, entS)
entBearG1 = f_entGapX(entTemaP, entDemaP, entAT, entBT, entAD, entBD, -entS)
entBearG2 = f_entGapX(entDemaP, entEmaP, entAD, entBD, entAE, entBE, -entS)
entBullGate = entGate ? f_entSlopeX(entTemaP, entAT, entBT, entGateS) : na
entBearGate = entGate ? f_entSlopeX(entTemaP, entAT, entBT, -entGateS) : na
entArrBullX = (na(entBullG1) or na(entBullG2) or (entGate and na(entBullGate))) ? na : entGate ? math.max(entBullG1, entBullG2, entBullGate) : math.max(entBullG1, entBullG2)
entArrBearX = (na(entBearG1) or na(entBearG2) or (entGate and na(entBearGate))) ? na : entGate ? math.min(entBearG1, entBearG2, entBearGate) : math.min(entBearG1, entBearG2)
entArrState = bgFillState[entryOff]            // 기준봉 배열 상태(1=정배열·−1=역배열·0=중립) — 표시 규칙·셀 색 공용

// =========================================================================================
// ⚠️ [CEO 지시] 기울기 정렬 삼각형 마커(파랑 △ belowbar / 빨강 ▽ abovebar)와 그 판정 로직 일체는 전면 제거됨.
//    제거된 것: noBg(bgFillState==0)·greenCnt/redCnt(셀 순 개수 상쇄)·blueRaw/redRaw·blueShow/redShow·plotshape 2개,
//    순꼬리 필터(triBody·triUpperWick·triLowerWick·triNetUpper·triNetLower·triNotDoji·blueWickBlock·redWickBlock·도지 가드),
//    비정상 캔들 억제(abnBuySuppress/abnSellSuppress), T/D 크로스 억제(tdxBlueSuppress/tdxRedSuppress),
//    중복 억제 래치(var blueLatched/redLatched·resetBlue/resetRed·barstate.isconfirmed 커밋 블록),
//    전용 input 5개 + 그룹 상수(TRI_GROUP·showAlignTri·alignTriUpColor·alignTriDnColor·showWickFilter·showTdxFilter).
//  ▸ ⚠️ 소비처가 남아 있는 SSOT는 전부 존치(삭제·개명·인라인화 금지):
//     · bgFillState(→ entArrState → 상태 테이블 추세 전환가 '정배열 전환'·'역배열 전환' 행 셀색·표시 규칙) 및 그 계산 경로 input(bgFilterMode·bgGapTau·bgSizeM·bgDeadK — 배열 전환가 문턱에도 쓰임)
//     · emaLogGreen/Red·demaLogGreen/Red·temaLogGreen/Red(→ anyCellRed/Green → bgFillState 컨플루언스). 기울기 3행 표시는 CEO 지시로 제거(2026-10-16)됐으나 이 판정 bool은 bgFillState가 쓰므로 존치
//     · tdxDimRed/tdxFullRed/tdxDimGreen/tdxFullGreen(→ tdxCellColor → 추세 전환가 'T/D 전환' 행 셀색) — 위 SSOT 블록 그대로 유지
//     · abnCandleState(→ barcolor 비정상 캔들 몸통색), sonarState(→ Sonar 모멘텀 배경 fill/bgcolor — 구 밴드워킹 bgWalkPaintState 대체)
//  ▸ 윌리엄스 %R 다이버전스 원(bullWprDiv/bearWprDiv·plotshape 2개)은 무수정 유지 — 삼각형과 참조 관계가 없어 영향 없음.
// =========================================================================================

if barstate.islast
    lineEndX = bar_index + offset
    upperBand1LineEndLabel := updateLineEndLabel(upperBand1LineEndLabel, lineEndX, upperBandValue1, formatPercentGap(upperBandValue1, vwapValue), activeLineColor, showBandPctLabels and shouldPlot and showBand_1 and not na(upperBandValue1))
    lowerBand1LineEndLabel := updateLineEndLabel(lowerBand1LineEndLabel, lineEndX, lowerBandValue1, formatPercentGap(lowerBandValue1, vwapValue), activeLineColor, showBandPctLabels and shouldPlot and showBand_1 and not na(lowerBandValue1))
    upperBand2LineEndLabel := updateLineEndLabel(upperBand2LineEndLabel, lineEndX, upperBandValue2, formatPercentGap(upperBandValue2, vwapValue), activeLineColor, showBandPctLabels and shouldPlot and showBand_2 and not na(upperBandValue2))
    lowerBand2LineEndLabel := updateLineEndLabel(lowerBand2LineEndLabel, lineEndX, lowerBandValue2, formatPercentGap(lowerBandValue2, vwapValue), activeLineColor, showBandPctLabels and shouldPlot and showBand_2 and not na(lowerBandValue2))

// =========================================================================================
// [이식] 거래량 가중 이동평균선(VWMA 50/100/200) + 상태 테이블 — advanced-ichimoku.pine에서 포팅.
//  아래 모든 판정식은 이치모쿠 원본 로직 그대로다(소스·오프셋·확정봉 기준 임의 변경 없음).
//  기존 auto-vwap 로직(정/역배열 배경·비정상 배경·억제 게이트·VWAP·밴드)은 전혀 건드리지 않는다.
// =========================================================================================

// ── 거래량 가중선 계산·페인팅은 z-order 최하단(back-most) 배치를 위해 파일 앞쪽 밴드 plot 직전으로 이동함(CEO z-order 지시).
//    계산(f_ltMa·vwma20/50·ltMa1/2·ltUp)과 plot+fill이 "VWMA z-order 블록"으로 옮겨졌다. 산식·색·오프셋 전부 불변, 위치(선언 순서)만 변경.
// ── 거래량 가중 표준편차 σ_vw(원본 f_vwStdev 이식) — 100/200선 지지/저항 판정 전용 밴드1 산출용 ──
//  σ_vw = sqrt(max( Σ(close²·vol)/Σvol − vwma² , 0)). 원본 산식 동일(rolling length 윈도우).
f_vwStdev(float vwma, int len) =>
    float p2v = ta.sma(close * close * volume, len)
    float vAvg = ta.sma(volume, len)
    float ex2 = (na(vAvg) or vAvg == 0) ? na : p2v / vAvg
    (na(ex2) or na(vwma)) ? na : math.sqrt(math.max(ex2 - vwma * vwma, 0.0))

// ── 지지/저항 판정 helper(원본 f_srSupportResist 이식) — center·밴드1(up1/lo1)로 [isSupport, isResistance] ──
//  동적 near 구간 + 종가/꼬리 걸침 4규칙. 워밍업/밴드 na면 둘 다 false. close==center는 저항 우선. 원본과 산식 100% 동일.
f_srSupportResist(float center, float up1, float lo1) =>
    bool isSup = false
    bool isRes = false
    if not na(center) and not na(up1) and not na(lo1)
        float bandWidth1 = up1 - lo1
        float rNear = center != 0 ? bandWidth1 / center : na
        float rLow  = srNearRLowPct / 100.0
        float rHigh = srNearRHighPct / 100.0
        float tNear = (na(rNear) or rHigh <= rLow) ? 0.0 : math.min(math.max((rNear - rLow) / (rHigh - rLow), 0.0), 1.0)
        float nearPct = srNearMaxPct - tNear * (srNearMaxPct - srNearMinPct)
        float pct = math.min(math.max(nearPct, 0.0), 100.0) / 100.0
        float upperNear = center + pct * (up1 - center)
        float lowerNear = center - pct * (center - lo1)
        isRes := (close >= lowerNear and close <= center) or (close < lowerNear and high > lowerNear)
        isSup := not isRes and ((close >= center and close <= upperNear) or (close > upperNear and low < upperNear))
    [isSup, isRes]


// ── 거래량 가중 50/100/200선 + 100~200 fill의 페인팅은 z-order 최하단(back-most) 배치를 위해 위쪽 "VWMA z-order 블록"으로 이동함(CEO z-order 지시). 여기서는 제거됨. 계산·plot 산식/색/오프셋 전부 불변.

// ── (제거됨) vwap 상태(20) 파이프라인(밴드워킹 판정) — CEO 지시(2026-10-16)로 밴드 배경이 Sonar 모멘텀 배경으로 교체되며 유일 소비처가 사라져 전부 삭제.

// ── 추세 셀 색 공통 상수(원본 이식) ──────────────────────────────────────────────────────
ltUpColor = #0E9C8A     // 상승계열 청록
ltDownColor = #C2185B   // 하락계열 자홍
// 크로스 셀 방향성 오버라이드 색(CEO 지시 — 50선 지지/저항 행의 위/아래 색과 시각 통일). 어두운 톤·셀 투명도(30)와 어울리게.
//  ▸ 색상(hue)은 50선 지지/저항 행(row 17, vwSrColor)의 "위"(#6E8F72)·"아래"(#A57A7A)와 동일하게 통일한다. 셀 배경 투명도는 3행 톤(30)을 유지(50선 행은 텍스트/셀 순색 투명도 0이지만, 이 3행은 셀 배경이라 30 유지가 톤 정합).
SR50_ABOVE = #6E8F72    // 50선 "위" 색과 통일(어두운 녹회색) — 종전 DARKBLUE(어두운 파랑). 양수(벌어짐)인데 현재봉이 평균 이하(줄어드는 중) / 골든인데 현재봉%가 평균 초과.
SR50_BELOW = #A57A7A    // 50선 "아래" 색과 통일(어두운 적회색) — 종전 DARKORANGE(어두운 주황). 음수(좁혀짐)인데 현재봉이 평균 이상(완화 중) / 데드인데 현재봉%가 평균 미만.
// 추세 셀(단기/중기/장기) 폭 변화 데드밴드용 ATR(14). ⚠️ ltAtrTable은 이제 밴드 배경 필터(공통 스케일 V=ATR/close)에서도 쓰이므로 리본 slope 직후(배경 판정 위)에서 이미 1회 계산됨 — 여기서 재정의하지 않고 그 값을 재사용한다(값 동일, ta.atr(14) 중복 호출 방지).
ltDeadBand = not na(ltAtrTable) ? ltAtrTable * ltFlatTol : 0.0

// ── (제거됨) 구 "선행 추세 확인" 표시 행 — CEO 지시(2026-10-16)로 섹션을 "추세 진입"(전환가 P* 4행, 현 헤더 "추세 전환가")으로 교체 ─────────────
//  ▸ 삭제: TEMA/DEMA/EMA 기울기 3행 표시(f_slopePctStr·f_logSlope3Text·f_logSlope3Color·emaAngleText/Color·demaAngleText/Color·temaAngleText/Color),
//     기울기 배열 행 텍스트(slopeArrText), 툴팁(slopeTemaTooltip/slopeDemaTooltip/slopeEmaTooltip/slopeArrTooltip/tdCrossTooltip/deCrossTooltip).
//  ▸ 존치: 로그 slope 계산(f_logY·f_logSlopes3·emaSlA..temaSlC)·셀색 판정 bool(emaLogGreen/Red 등·f_pctR2) — bgFillState(배열 상태)와 전환가 행이 계속 쓴다.
//  ▸ 신규 4행 계산은 위 "추세 전환가 — P* 역산" 블록, 텍스트·색은 아래 "추세 전환가 5행 셀 텍스트·색" 블록.

// ── 단기 추세(20선 vs 50선) 셀 — 원본 이식 ────────────────────────────────────────────────
stReady = not na(vwma20) and not na(vwma50)
stUp = stReady and vwma20 > vwma50
stGap = stReady ? math.abs(vwma20 - vwma50) : na
stGapPct = stReady and close != 0 ? stGap / close * 100 : na
stGoldCross = stReady and ta.crossover(vwma20, vwma50)
stDeadCross = stReady and ta.crossunder(vwma20, vwma50)
stBarsSince = ta.barssince(stGoldCross or stDeadCross)
stFresh = na(stBarsSince) or stBarsSince < ltTrendLook
stEstablished = not stFresh
stGapChg = (stEstablished and not na(stGap) and not na(stGap[ltTrendLook])) ? stGap - stGap[ltTrendLook] : na
stWidening = not na(stGapChg) and stGapChg > ltDeadBand
stNarrowing = not na(stGapChg) and stGapChg < -ltDeadBand
stNearCross = stEstablished and not na(stGapPct) and stGapPct <= ltCrossWarnPct and not stWidening
stDir = stUp ? "상승" : "하락"
stStateBase = not stEstablished ? stDir : stNearCross ? (stUp ? "약한 상승" : "약한 하락") : stWidening ? (stUp ? "강한 상승" : "강한 하락") : stNarrowing ? (stUp ? "약한 상승" : "약한 하락") : stDir
var float stCross20 = na
if stGoldCross or stDeadCross
    stCross20 := vwma20
stMovePct = not na(stCross20) and stCross20 != 0 and stReady ? (vwma20 / stCross20 - 1) * 100 : na
stInfoTxt = (na(stMovePct) or na(stBarsSince)) ? "" : " (" + (stMovePct >= 0 ? "+" : "") + str.tostring(stMovePct, "0.0") + "% | " + str.tostring(stBarsSince) + "봉)"
stCellText = not stReady ? "-" : stDeadCross ? "데드 크로스" : stGoldCross ? "골든 크로스" : stStateBase + stInfoTxt
stCellTransp = not stEstablished ? 30 : (stNearCross or stNarrowing) ? 55 : stWidening ? 0 : 30
stCellColor = not stReady ? color.new(color.gray, 50) : stGoldCross ? color.new(ltUpColor, 0) : stDeadCross ? color.new(ltDownColor, 0) : stUp ? color.new(ltUpColor, stCellTransp) : color.new(ltDownColor, stCellTransp)

// ── 중기 추세(화면 주황 50선 vwma50 vs 100선 ltMa1) 셀 ──
//  ⚠️ 버그 수정(CEO 명세: "50 vs 100 = 화면 주황선 vs 파랑선"): 이전에는 vwapValue(롤링 50봉 세션 VWAP·hlc3)를 참조해
//     화면에 그려지는 주황 50선(vwma50 = ta.vwma(close,50))과 **다른 값**으로 판정 → 선과 테이블 불일치였다.
//     판정 입력을 vwma50으로 통일한다. 판정식(crossover/under·gap·이격) 구조는 불변, 참조 MA만 vwapValue→vwma50.
mtReady = not na(vwma50) and not na(ltMa1)
mtUp = mtReady and vwma50 > ltMa1
mtGap = mtReady ? math.abs(vwma50 - ltMa1) : na
mtGapPct = mtReady and close != 0 ? mtGap / close * 100 : na
mtGoldCross = mtReady and ta.crossover(vwma50, ltMa1)
mtDeadCross = mtReady and ta.crossunder(vwma50, ltMa1)
mtBarsSince = ta.barssince(mtGoldCross or mtDeadCross)
mtFresh = na(mtBarsSince) or mtBarsSince < ltTrendLook
mtEstablished = not mtFresh
mtGapChg = (mtEstablished and not na(mtGap) and not na(mtGap[ltTrendLook])) ? mtGap - mtGap[ltTrendLook] : na
mtWidening = not na(mtGapChg) and mtGapChg > ltDeadBand
mtNarrowing = not na(mtGapChg) and mtGapChg < -ltDeadBand
mtNearCross = mtEstablished and not na(mtGapPct) and mtGapPct <= ltCrossWarnPct and not mtWidening
mtDir = mtUp ? "상승" : "하락"
mtStateBase = not mtEstablished ? mtDir : mtNearCross ? (mtUp ? "약한 상승" : "약한 하락") : mtWidening ? (mtUp ? "강한 상승" : "강한 하락") : mtNarrowing ? (mtUp ? "약한 상승" : "약한 하락") : mtDir
var float mtCrossVwap = na
if mtGoldCross or mtDeadCross
    mtCrossVwap := vwma50
mtMovePct = not na(mtCrossVwap) and mtCrossVwap != 0 and mtReady ? (vwma50 / mtCrossVwap - 1) * 100 : na
mtInfoTxt = (na(mtMovePct) or na(mtBarsSince)) ? "" : " (" + (mtMovePct >= 0 ? "+" : "") + str.tostring(mtMovePct, "0.0") + "% | " + str.tostring(mtBarsSince) + "봉)"
mtCellText = not mtReady ? "-" : mtDeadCross ? "데드 크로스" : mtGoldCross ? "골든 크로스" : mtStateBase + mtInfoTxt
mtCellTransp = not mtEstablished ? 30 : (mtNearCross or mtNarrowing) ? 55 : mtWidening ? 0 : 30
mtCellColor = not mtReady ? color.new(color.gray, 50) : mtGoldCross ? color.new(ltUpColor, 0) : mtDeadCross ? color.new(ltDownColor, 0) : mtUp ? color.new(ltUpColor, mtCellTransp) : color.new(ltDownColor, mtCellTransp)

// ── 장기 추세(100선 vs 200선) 셀 — 원본 이식 ──────────────────────────────────────────────
//  ⚠️ na 게이트 강화(CEO 지시): 200봉 미만 워밍업 구간에서 ltMa2=na이면 ltUp(=ltMa1>ltMa2)이 false로 평가돼
//     "하락"이 오표시된다. 단기/중기처럼 명시 Ready 가드를 두고, 미준비 시 셀을 "-"로 처리한다. 판정식(100/200 크로스)은 불변.
ltReady = not na(ltMa1) and not na(ltMa2)
ltGapT = ltReady ? math.abs(ltMa1 - ltMa2) : na
ltGapPctT = ltReady and close != 0 ? ltGapT / close * 100 : na
ltDeadCross = ltReady and ta.crossunder(ltMa1, ltMa2)
ltGoldCross = ltReady and ta.crossover(ltMa1, ltMa2)
ltBarsSince = ta.barssince(ltGoldCross or ltDeadCross)
ltFresh = na(ltBarsSince) or ltBarsSince < ltTrendLook
ltEstablished = not ltFresh
ltGapChg = (ltEstablished and not na(ltGapT[ltTrendLook])) ? ltGapT - ltGapT[ltTrendLook] : na
ltWidening = not na(ltGapChg) and ltGapChg > ltDeadBand
ltNarrowing = not na(ltGapChg) and ltGapChg < -ltDeadBand
ltNearCross = ltEstablished and not na(ltGapPctT) and ltGapPctT <= ltCrossWarnPct and not ltWidening
ltDir = ltUp ? "상승" : "하락"
ltStateBase = not ltEstablished ? ltDir : ltNearCross ? (ltUp ? "약한 상승" : "약한 하락") : ltWidening ? (ltUp ? "강한 상승" : "강한 하락") : ltNarrowing ? (ltUp ? "약한 상승" : "약한 하락") : ltDir
var float ltCrossMa1 = na
if ltGoldCross or ltDeadCross
    ltCrossMa1 := ltMa1
ltMovePct = not na(ltCrossMa1) and ltCrossMa1 != 0 and ltReady ? (ltMa1 / ltCrossMa1 - 1) * 100 : na
ltInfoTxt = (na(ltMovePct) or na(ltBarsSince)) ? "" : " (" + (ltMovePct >= 0 ? "+" : "") + str.tostring(ltMovePct, "0.0") + "% | " + str.tostring(ltBarsSince) + "봉)"
ltCellText = not ltReady ? "-" : ltDeadCross ? "데드 크로스" : ltGoldCross ? "골든 크로스" : ltStateBase + ltInfoTxt
ltCellTransp = not ltEstablished ? 30 : (ltNearCross or ltNarrowing) ? 55 : ltWidening ? 0 : 30
ltCellColor = not ltReady ? color.new(color.gray, 50) : ltGoldCross ? color.new(ltUpColor, 0) : ltDeadCross ? color.new(ltDownColor, 0) : ltUp ? color.new(ltUpColor, ltCellTransp) : color.new(ltDownColor, ltCellTransp)

// ── 지지/저항 3행 값 텍스트 헬퍼(CEO 지시) — "선 가격 (현재가 대비 ±%)" 형식(예 140,000 (+10.1%)) ──
//  ▸ 표시 텍스트 전용: 지지/저항 판정·셀 배경색·이격도(Disp)·연속봉수(Bars) 계산은 아래 각 행 블록에서 그대로 보존(값만 셀에 미표시).
//  ▸ 가격 = 선 값을 math.round_to_mintick으로 틱 반올림(실제 호가 단위로 표시 — 소수 자릿수 표시와 값의 틱 정합) + 천 단위 쉼표.
//    소수 자릿수 d = mintick×10^d가 정수가 되는 최소 d(최대 8, cRSI f_crossFmt 방식 — 0.25·0.005 같은 비10진 틱도 자릿수 손실 없음).
//  ▸ % = (선 값 − 현재 종가 close[0]) / close[0] × 100, 소수 1자리·부호(+/−). 선이 현재가 위면 +, 아래면 −.
//    반올림 정수 n=round(pct×10)으로 부호·숫자를 만들어 −0.0 방지(n=0 → "0.0%", cRSI f_crossPct 방식).
//    %는 틱 반올림 전 선 원값 기준(반올림 오차가 %에 섞이지 않게).
//  ▸ 선 값 na → "-". close[0] ≤ 0·na(비정상 데이터) → % 자리만 "-".
//  ▸ 기준봉: 현재봉 [0](선·종가 모두 라이브 값) — 봉 마감 전 틱마다 갱신, 봉 마감 시 확정(기존 테이블 컨벤션 동일, 미래참조 없음).
f_srLineFmt() =>
    mt = syminfo.mintick
    int d = 0
    for i = 0 to 8
        d := i
        x = mt * math.pow(10, i)
        if math.abs(x - math.round(x)) < 1e-6
            break
    d == 0 ? "#,##0" : "#,##0." + str.repeat("0", d)
srLineFmt = f_srLineFmt()
// % 텍스트(현재 종가 close[0] 대비, 소수 1자리·부호 항상, −0.0 방지). close≤0·na면 "-". 지지/저항·밴드·추세 전환가 행 공용(값 v는 호출부가 정함).
f_srPctText(float v) =>
    string pctTxt = "-"
    if not na(close) and close > 0
        n = math.round((v - close) / close * 100 * 10)
        pctTxt := n == 0 ? "0.0%" : (n > 0 ? "+" : "") + str.tostring(n / 10.0, "0.0") + "%"
    pctTxt
f_srLineText(float ma) =>
    string t = "-"
    if not na(ma)
        t := str.tostring(math.round_to_mintick(ma), srLineFmt) + " (" + f_srPctText(ma) + ")"
    t

// ── 변동성 임계가: 밴드 상단 / 밴드 하단 2행(CEO 지시 — 구 'vwap 기울기'·'vwap 구간' 행 대체) ──
//  ▸ 값 = 화면 주 밴드(Band #2, ±bandMult_2σ — 기본 2.0) 상단/하단 가격 + 현재가 대비 % → "10,000 (+10.0%)" 형식.
//    포맷은 지지/저항 3행 헬퍼 f_srLineText 재사용(mintick 반올림·천 단위 쉼표, %=(밴드값−close)/close×100 소수1자리·부호, −0.0 방지).
//  ▸ 주 밴드 선택 근거: Band #1 plot은 display=display.none(기본 숨김), Band #2만 기본 표시(displayBand2 — 점선 1px)되고 밴드 배경 fill도 밴드2 영역이다.
//    값 세트도 차트에 그려지는 화면 50봉 세트(upperBandValue2/lowerBandValue2, recentBars)와 동일 (구 20봉 vwap 상태 세트는 Sonar 배경 교체로 삭제됨).
//  ▸ 가드: 밴드2 토글 OFF(showBand_2=false)·워밍업(shouldPlot=false)·na → "-"(f_srLineText가 na를 "-"로 처리).
//  ▸ 기준봉: 현재봉 [0](밴드값·종가 모두 라이브) — 지지/저항 3행과 동일(봉 마감 전 틱마다 갱신·마감 시 확정, 미래참조 없음).
//  ▸ 셀 색: 고정 — 상단=둔탁 적(#A57A7A, 저항 계열), 하단=둔탁 녹(#6E8F72, 지지 계열), "-"면 회색(gray 50, 지지/저항 행 na 색과 동일). 표시 전용·판정 아님.
bandRowOk = shouldPlot and showBand_2
bandUpperText = f_srLineText(bandRowOk ? upperBandValue2 : na)
bandLowerText = f_srLineText(bandRowOk ? lowerBandValue2 : na)
bandUpperColor = bandRowOk and not na(upperBandValue2) ? color.new(#A57A7A, 0) : color.new(color.gray, 50)
bandLowerColor = bandRowOk and not na(lowerBandValue2) ? color.new(#6E8F72, 0) : color.new(color.gray, 50)

// ── 50선(페인팅 거래량 가중 50선 = vwma50) 지지/저항 셀 ──
//  ⚠️ 버그 수정(CEO 리포트): 이 행은 "50선 지지/저항"이므로 화면에 페인팅되는 **거래량 가중 50선(vwma50 = ta.vwma(close,50), 주황 #FF6D00)**을
//     기준(reference)으로 판정해야 한다. 이전에는 화면 VWAP 중앙선(vwapValue = 롤링 50봉 VWAP·hlc3)과 그 밴드1(upperBandValue1/lowerBandValue1)을
//     참조해, 페인팅 50선과 **다른 값**(다른 소스·산식: VWMA(close,50) vs rolling-VWAP(hlc3,50))으로 판정 → 선과 테이블 불일치였다.
//  ▸ 판정식(f_srSupportResist·동적 near·σ 밴드·srBandStdMult)은 100/200선 행과 100% 동일하게 유지하고, **입력 MA만 vwma50**으로 통일한다.
//     판정 전용 밴드1 = vwma50 ± (srBandStdMult × f_vwStdev(vwma50, 50)) — 100/200선과 완전히 동일한 패턴(σ_vw 거래량 가중 표준편차).
//  ▸ 위/아래·이격도·연속봉수도 모두 vwma50 기준으로 재계산(행 내부 정합). 확정봉 세트값 → 신규 리페인팅 없음.
vwSrHasMa = not na(vwma50)
vwAbove = vwSrHasMa and close > vwma50
vwAboveInt = vwSrHasMa ? (vwAbove ? 1 : -1) : 0
var int vwSrBars = 0
if vwAboveInt == 0
    vwSrBars := 0
else if vwAboveInt == vwAboveInt[1]
    vwSrBars := vwSrBars + 1
else
    vwSrBars := 1
vwSrDisp = (na(vwma50) or vwma50 == 0) ? na : close / vwma50 * 100
vwSrSigma = f_vwStdev(vwma50, 50)
[vwSrSupport, vwSrResist] = f_srSupportResist(vwma50, na(vwSrSigma) ? na : vwma50 + srBandStdMult * vwSrSigma, na(vwSrSigma) ? na : vwma50 - srBandStdMult * vwSrSigma)
vwSrState = not vwSrHasMa ? "-" : vwSrSupport ? "지지" : vwSrResist ? "저항" : vwAbove ? "위" : "아래"
//  셀 값(CEO 지시): 선 가격 + 현재가 대비 % — 상태(vwSrState)·이격도(vwSrDisp)·연속봉수(vwSrBars)는 계산 보존, 셀 배경색(vwSrColor)이 지지/저항 판정을 표시.
vwSrText = f_srLineText(vwma50)
vwSrColor = not vwSrHasMa ? color.new(color.gray, 50) : vwSrSupport ? color.new(color.green, 0) : vwSrResist ? color.new(color.red, 0) : vwAbove ? color.new(#6E8F72, 0) : color.new(#A57A7A, 0)

// ── 100선(MA100) 지지/저항 셀 — 원본 이식 ─────────────────────────────────────────────────
ltM1Above = not na(ltMa1) and close > ltMa1
ltM1HasMa = not na(ltMa1)
ltM1Int = ltM1HasMa ? (ltM1Above ? 1 : -1) : 0
var int ltM1Bars = 0
if ltM1Int == 0
    ltM1Bars := 0
else if ltM1Int == ltM1Int[1]
    ltM1Bars := ltM1Bars + 1
else
    ltM1Bars := 1
ltM1Disp = (na(ltMa1) or ltMa1 == 0) ? na : close / ltMa1 * 100
ltM1SrSigma = f_vwStdev(ltMa1, ltLen1)
[ltM1Support, ltM1Resist] = f_srSupportResist(ltMa1, na(ltM1SrSigma) ? na : ltMa1 + srBandStdMult * ltM1SrSigma, na(ltM1SrSigma) ? na : ltMa1 - srBandStdMult * ltM1SrSigma)
ltM1SrState = not ltM1HasMa ? "-" : ltM1Support ? "지지" : ltM1Resist ? "저항" : ltM1Above ? "위" : "아래"
//  셀 값(CEO 지시): 선 가격 + 현재가 대비 % — 상태·이격도·연속봉수 계산 보존, 배경색(ltM1SrColor)이 판정 표시.
ltM1SrText = f_srLineText(ltMa1)
ltM1SrColor = not ltM1HasMa ? color.new(color.gray, 50) : ltM1Support ? color.new(color.green, 0) : ltM1Resist ? color.new(color.red, 0) : ltM1Above ? color.new(#6E8F72, 0) : color.new(#A57A7A, 0)

// ── 200선(MA200) 지지/저항 셀 — 원본 이식 ─────────────────────────────────────────────────
ltM2Above = not na(ltMa2) and close > ltMa2
ltM2HasMa = not na(ltMa2)
ltM2Int = ltM2HasMa ? (ltM2Above ? 1 : -1) : 0
var int ltM2Bars = 0
if ltM2Int == 0
    ltM2Bars := 0
else if ltM2Int == ltM2Int[1]
    ltM2Bars := ltM2Bars + 1
else
    ltM2Bars := 1
ltM2Disp = (na(ltMa2) or ltMa2 == 0) ? na : close / ltMa2 * 100
ltM2SrSigma = f_vwStdev(ltMa2, ltLen2)
[ltM2Support, ltM2Resist] = f_srSupportResist(ltMa2, na(ltM2SrSigma) ? na : ltMa2 + srBandStdMult * ltM2SrSigma, na(ltM2SrSigma) ? na : ltMa2 - srBandStdMult * ltM2SrSigma)
ltM2SrState = not ltM2HasMa ? "-" : ltM2Support ? "지지" : ltM2Resist ? "저항" : ltM2Above ? "위" : "아래"
//  셀 값(CEO 지시): 선 가격 + 현재가 대비 % — 상태·이격도·연속봉수 계산 보존, 배경색(ltM2SrColor)이 판정 표시.
ltM2SrText = f_srLineText(ltMa2)
ltM2SrColor = not ltM2HasMa ? color.new(color.gray, 50) : ltM2Support ? color.new(color.green, 0) : ltM2Resist ? color.new(color.red, 0) : ltM2Above ? color.new(#6E8F72, 0) : color.new(#A57A7A, 0)

// ── 비정상 매수/매도 셀: CEO 지시로 테이블 행 삭제(비정상은 이미 캔들 몸통색 barcolor로 표현). ──
//  ⚠️ 판정 래치(abnCandleState/abnWatch)·캔들색(abnBarColor·barcolor)은 전부 불변 — 삭제한 것은 테이블 셀 전용 변수(abnCandleTxt/abnWatchTxt/abnCellText/abnCellColor)뿐이다.

// ── 이격도 셀(원본 이식) — auto-vwap의 기존 disparity/overCount/underCount 재사용. 셀 텍스트/색·되돌림 가격만 신설 ──
disparityState = (overCount == 2 or underCount == 2) ? "되돌림 확실" : (overCount >= 1 or underCount >= 1) ? "되돌림 주의" : "중립"
disparityCellText = na(disparity) ? "-" : str.tostring(disparity, "0.0") + " (" + disparityState + ")"
disparityCellColor = overCount == 2 ? color.new(color.red, 0) : underCount == 2 ? color.new(color.green, 0) : overCount >= 1 ? color.new(#A57A7A, 0) : underCount >= 1 ? color.new(#6E8F72, 0) : color.new(color.gray, 40)
disparityNeutralPct = disparityStatOk ? math.min(disparityThreshold, disparityStatMult * disparityStd) : disparityThreshold
disparityLowerEdge = not na(disparityMa) ? disparityMa * (1 - disparityNeutralPct / 100) : na
disparityUpperEdge = not na(disparityMa) ? disparityMa * (1 + disparityNeutralPct / 100) : na
disparityPullbackPrice = overCount >= 1 ? disparityUpperEdge : underCount >= 1 ? disparityLowerEdge : na

// 되돌림 가격 셀 텍스트 포맷 헬퍼 — 원본 f_price/f_pct 그대로 이식(천 단위 쉼표 + mintick 자릿수, 종가 대비 %).
priceDecimals = syminfo.mintick >= 1 ? 0 : syminfo.mintick >= 0.1 ? 1 : syminfo.mintick >= 0.01 ? 2 : syminfo.mintick >= 0.001 ? 3 : syminfo.mintick >= 0.0001 ? 4 : 5
priceFmt = priceDecimals == 0 ? "#,##0" : priceDecimals == 1 ? "#,##0.0" : priceDecimals == 2 ? "#,##0.00" : priceDecimals == 3 ? "#,##0.000" : priceDecimals == 4 ? "#,##0.0000" : "#,##0.00000"
f_priceStr(float p) => str.tostring(p, priceFmt)
f_pctStr(float p) =>
    d = (p - close) / close * 100
    (d > 0 ? "+" : "") + str.tostring(d, "0.0") + "%"

// ── 후행·변동성·지지/저항 섹션 데이터 행 셀 툴팁(추세 전환가 툴팁과 톤 통일 — 각 행 신호 의미만 요약) ────────
//  후행 추세 3행: VWMA 골든/데드크로스로 확정된 추세를 확인하는 후행 신호(추세 전환가 대비 늦지만 오신호 적음). MA쌍만 행별 상이.
laggingStTooltip = "추세 진입 신호(전환가 돌파)가 실제 거래량을 동반해 단기 추세로 확정됐는지를 검증하여 잦은 되돌림(휩쏘)을 걸러냅니다."
laggingMtTooltip = "단기 노이즈를 걸러낸 중기 추세의 방향을 확정하는 데 씁니다."
laggingLtTooltip = "시장 대추세의 방향을 확정하여 진입 방향을 결정하는 최종 상위 필터로 씁니다."
//  변동성 4행: 밴드 상단·밴드 하단(주 밴드 Band #2 가격·현재가 대비 %)·이격도(과열)·되돌림가(회귀 목표). 각 행 개념+효과.
volBandUpperTooltip = "VWAP 주 밴드(Band #2) 상단의 가격과 현재가 대비 거리(%, 밴드가 위면 +·아래면 −)를 표시합니다. 평균단가 대비 과확장 상한으로, 추격 매수 자제·분할 청산 기준으로 씁니다. 밴드2가 꺼져 있거나 계산 전이면 -."
volBandLowerTooltip = "VWAP 주 밴드(Band #2) 하단의 가격과 현재가 대비 거리(%, 밴드가 위면 +·아래면 −)를 표시합니다. 평균단가 대비 과확장 하한으로, 추격 매도 자제·눌림 매수 대기 기준으로 씁니다. 밴드2가 꺼져 있거나 계산 전이면 -."
volDisparityTooltip = "가격이 평균에서 과도하게 벌어졌는지를 측정하여 추격 진입을 억제하고 되돌림 타이밍을 판단합니다."
volPullbackTooltip = "과열이 해소되며 되돌아올 것으로 예상되는 목표가를 제시하여 청산 목표나 눌림목 기준으로 씁니다."
//  지지/저항 3행(라벨 50선/100선/200선): 값=선 가격(현재가 대비 ±%), 셀 색=지지/저항 판정(VWMA선 ±σ 밴드). 개념+효과. MA만 행별 상이.
srVw50Tooltip = "거래량 가중 50선의 가격과 현재가 대비 거리(%, 선이 위면 +·아래면 −)를 표시합니다. 셀 색이 지지(녹)·저항(적)·위(둔탁 녹)·아래(둔탁 적) 판정입니다. 거래량이 실린 단기 평균선을 지지·저항 레벨로 삼아 진입과 손절 기준으로 씁니다."
srVw100Tooltip = "거래량 가중 100선의 가격과 현재가 대비 거리(%, 선이 위면 +·아래면 −)를 표시합니다. 셀 색이 지지(녹)·저항(적)·위(둔탁 녹)·아래(둔탁 적) 판정입니다. 단기선보다 강한 중기 매물대에서 추세의 지속과 반전을 판단합니다."
srVw200Tooltip = "거래량 가중 200선의 가격과 현재가 대비 거리(%, 선이 위면 +·아래면 −)를 표시합니다. 셀 색이 지지(녹)·저항(적)·위(둔탁 녹)·아래(둔탁 적) 판정입니다. 시장 대추세의 최종 지지·저항으로, 장기 국면 전환을 가르는 결정적 레벨로 봅니다."

// ── 추세 전환가 5행 셀 텍스트·색(CEO 지시 2026-10-16 — 위 "추세 전환가 — P* 역산" 블록 소비) ──────────────────
//  ▸ 값 포맷: "{이벤트} : {틱 반올림 가격} ({기준봉 종가 대비 %})"(예 `상승전환 : 10,215 (+2.1%)`). 가격 포맷 srLineFmt(천 단위 쉼표·mintick 자릿수), % = f_entPctText(소수1자리·부호 항상·−0.0 방지).
//     % 기준가 = entBaseC = close[entryOff](cRSI crClose1과 동일): 실시간봉 모드=현재가, 완성봉 모드(형성 중)=직전 완성봉 종가. 도달불가 ±30% 판정도 같은 기준.
//     %는 **표시된(틱 반올림된) 전환가** 기준 — 트레이더가 보는 가격과 %가 어긋나지 않게(지지/저항 행은 선 원값 기준이지만, 전환가는 표시가 자체가 트리거라 표시가 기준).
//  ▸ 틱 반올림(제안서 §2): 상향(상승·골든·정배열) 전환가 = ceil(P*/mintick)·mintick, 하향(하락·데드·역배열) = floor. 표시가에 도달하면 실제로 조건이 성립(엄격 부등호 대응).
//  ▸ 도달불가(cRSI 밴드 교차 테이블과 같은 기준): P*≤0, 또는 표시 반올림 % 정수 n=round(pct×10)이 ±300 초과(±30.0% 초과). "±30.0%"로 보이는 값은 표시.
//  ▸ "-": 워밍업·na·분모 퇴화. "소스≠종가": 리본 소스가 종가가 아님(entrySrcOk=false — 제안서 권고).
//  ▸ 셀 색(기존 색 체계 재사용, transp 30·중립 회색 40):
//     · TEMA/DEMA 전환: 기준봉 ㄱ<0(하락 중 = 상승전환 대기) → 적 ltDownColor / ㄱ>0(상승 중 = 하락전환 대기) → 녹 ltUpColor / 0·na → 회색. 셀 색=현재 상태(T/D 크로스 셀 관례와 같음).
//     · 정배열 전환·역배열 전환(2행 공통 entArrColor): entArrState(=bgFillState) 1 → 녹 / −1 → 적 / 0 → 회색(구 기울기 배열 행 slopeArrColor와 동일 매핑).
//     · T/D 전환: 기존 4-상태 tdxCellColor 그대로(골든 녹·데드 적 + cur/avg 저채도 SR50_ABOVE/BELOW). 평균(5) 텍스트만 폐지.
ENTRY_PCT_CAP = 30.0   // 도달불가 판정 변동률 상한(%) — cRSI CROSS_PCT_CAP과 같은 기준, input 미노출
f_entryTick(float p, bool up) =>
    float mt = syminfo.mintick
    up ? math.ceil(p / mt) * mt : math.floor(p / mt) * mt
// % 텍스트(기준가 base 대비) — f_srPctText와 같은 포맷(소수1자리·부호·−0.0 방지)이되 기준가를 기준봉 종가(entBaseC)로 받는다.
f_entPctText(float v, float base) =>
    string t = "-"
    if not na(base) and base > 0
        n = math.round((v - base) / base * 100 * 10)
        t := n == 0 ? "0.0%" : (n > 0 ? "+" : "") + str.tostring(n / 10.0, "0.0") + "%"
    t
f_entryText(string ev, float p, bool up) =>
    string v = "-"
    if not na(p)
        if p <= 0
            v := "도달불가"
        else
            float pr = f_entryTick(p, up)
            if not na(entBaseC) and entBaseC > 0 and math.abs(math.round((pr - entBaseC) / entBaseC * 1000)) > ENTRY_PCT_CAP * 10
                v := "도달불가"
            else
                v := str.tostring(pr, srLineFmt) + " (" + f_entPctText(pr, entBaseC) + ")"
    ev + " : " + v
// T/D 셀 색 — 위 SSOT의 4-상태 bool을 그대로 소비(조건 중복 작성 금지). 4상태가 상호배타라 삼항 체인은 종전 중첩 삼항식과 논리적으로 동일하다.
tdxCellColor = tdxDimRed ? color.new(SR50_BELOW, 30) : tdxFullRed ? color.new(ltDownColor, 30) : tdxDimGreen ? color.new(SR50_ABOVE, 30) : tdxFullGreen ? color.new(ltUpColor, 30) : color.new(color.gray, 40)
f_entSlopeColor(float sl) => na(sl) ? color.new(color.gray, 40) : sl < 0 ? color.new(ltDownColor, 30) : sl > 0 ? color.new(ltUpColor, 30) : color.new(color.gray, 40)
entTemaText = not entrySrcOk ? "소스≠종가" : na(entTemaSl) ? "-" : f_entryText(entTemaSl > 0 ? "하락전환" : "상승전환", entTemaX, not (entTemaSl > 0))
entDemaText = not entrySrcOk ? "소스≠종가" : na(entDemaSl) ? "-" : f_entryText(entDemaSl > 0 ? "하락전환" : "상승전환", entDemaX, not (entDemaSl > 0))
entTemaColor = f_entSlopeColor(entTemaSl)
entDemaColor = f_entSlopeColor(entDemaSl)
// 배열 2행(CEO 지시 — 구 '배열 전환' 1행의 중립 시 두 줄 표시 방지): 정배열 전환 행 = 역배열·중립이면 정배열 진입가, 이미 정배열이면 "-"(이탈가는 별도 수식·미검증 — 범위 밖).
//  역배열 전환 행 = 정배열·중립이면 역배열 진입가, 이미 역배열이면 "-". 수식(entArrBullX/entArrBearX)·접두어·도달불가/na/소스≠종가 규칙은 종전 그대로.
entArrBullText = not entrySrcOk ? "소스≠종가" : entArrState == 1 ? "-" : f_entryText("정배열", entArrBullX, true)
entArrBearText = not entrySrcOk ? "소스≠종가" : entArrState == -1 ? "-" : f_entryText("역배열", entArrBearX, false)
entArrColor = entArrState == 1 ? color.new(ltUpColor, 30) : entArrState == -1 ? color.new(ltDownColor, 30) : color.new(color.gray, 40)
entTdText = not entrySrcOk ? "소스≠종가" : na(entTdX) ? "-" : f_entryText(entTdGold ? "데드전환" : "골든전환", entTdX, not entTdGold)
entTdColor = tdxCellColor[entryOff]
// 셀 툴팁(공통 문구: 기준봉(entryBase 모드별)·조건부 가격·도달불가 기준)
ENTRY_TIP_BASE = entryBase == "실시간봉" ? " 기준봉=실시간봉: 현재 형성 중인 봉까지를 고정으로 보고 '다음 봉 종가'가 얼마면 조건이 바뀌는지 역산하며, 틱마다 다시 계산됩니다. %는 현재가 대비입니다." : " 기준봉=완성봉: 가장 최근 완성봉까지를 고정으로 보고 '형성 중이거나 다음에 올 봉의 종가'가 얼마면 조건이 바뀌는지 역산하며, 형성 중 틱 변동에는 값이 고정됩니다. %는 기준봉(완성봉) 종가 대비입니다."
ENTRY_TIP_COMMON = ENTRY_TIP_BASE + " 0 이하이거나 기준봉 종가 대비 ±30% 초과면 도달불가. ⚠️ 조건부 가격이지 예측이 아닙니다(도달 확률·기대수익과 무관). 매매 신호가 아닌 참고용입니다."
entTemaTooltip = "TEMA가 꺾이는(1봉 기울기 부호가 바뀌는) 다음 봉 종가입니다. TEMA가 하락 중(적)이면 상승전환가, 상승 중(녹)이면 하락전환가를 표시합니다. 가장 빠른 선이라 추세 진입·이탈의 첫 경계로 씁니다." + ENTRY_TIP_COMMON
entDemaTooltip = "DEMA가 꺾이는(1봉 기울기 부호가 바뀌는) 다음 봉 종가입니다. DEMA가 하락 중(적)이면 상승전환가, 상승 중(녹)이면 하락전환가를 표시합니다. TEMA보다 노이즈가 적어 추세 진입 확인용으로 씁니다." + ENTRY_TIP_COMMON
ENT_ARR_TIP_TAIL = " 셀 색=현재 배열 상태(녹=정배열·적=역배열·회색=중립). 근사: 변동성 스케일 V(ATR14/종가)를 고정하고 기울기 셀 색 컨플루언스·2자리 반올림을 생략한 필요조건이므로 봉 마감 후 셀 색으로 최종 확인하세요. 문턱은 '밴드 배경 필터' 설정을 따릅니다. '미적용'·'기울기 크기 게이트' 모드에서는 셀 색 판정이 기울기를 소수 2자리(%)로 반올림해 비교하므로, 실제 전환가가 표시가보다 더 멀 수 있습니다(리본 길이 20 기준 최대 약 0.15%, 길이에 거의 비례해 커짐 — 예 50이면 약 0.3%)."
entArrBullTooltip = "(근사) 세 이평선 1봉 기울기 정배열(TEMA>DEMA>EMA)이 성립하는 다음 봉 종가입니다. 현재 역배열·중립이면 정배열 진입가를 표시하고, 이미 정배열이면 '-'로 표시합니다(정배열 이탈가는 미제공)." + ENT_ARR_TIP_TAIL + ENTRY_TIP_COMMON
entArrBearTooltip = "(근사) 세 이평선 1봉 기울기 역배열(EMA>DEMA>TEMA)이 성립하는 다음 봉 종가입니다. 현재 정배열·중립이면 역배열 진입가를 표시하고, 이미 역배열이면 '-'로 표시합니다(역배열 이탈가는 미제공)." + ENT_ARR_TIP_TAIL + ENTRY_TIP_COMMON
entTdTooltip = "TEMA와 DEMA가 교차하는 다음 봉 종가입니다. 데드 상태(적)면 골든전환가, 골든 상태(녹)면 데드전환가를 표시합니다. 저채도 색은 현재봉 임계 변화율이 5봉 평균보다 반대쪽(데드 압력 완화 / 골든 되돌림 중)이라는 뜻입니다. 추세 가정의 최종 무효화 레벨로 씁니다." + ENTRY_TIP_COMMON

// ── 상태 테이블 렌더링(우측 상단) — 추세 확인 / 추세 전환가 / 변동성 임계가 / 지지·저항 임계가 ────────────────
//  스타일: 원본과 동일(섹션 헤더 딥 네이비 #1B2A4A·병합, 행 라벨 회색 배경, 값 셀 판정색, 흰 글자, size.small).
//  행 배치(총 19행, 0~18): 추세 확인 헤더 0·데이터 1~3 / 추세 전환가 헤더 4·데이터 5~9 / 변동성 임계가 헤더 10·데이터 11~14 / 지지·저항 임계가 헤더 15·데이터 16~18.
var table statusTable = table.new(position.top_right, 2, 19, border_width=1, border_color=color.new(color.gray, 50))
if showStatusTable and barstate.islast
    // 섹션1: 추세 확인 (VWMA MA 기반 후행(lagging) 지표 — 단기/중기/장기 추세 3행). (CEO 지시: 단기 추세 위에 머지 헤더 신설. 이후 CEO 지시로 헤더 "후행 추세 확인"→"추세 확인" 개명·테이블 최상단으로 이동.)
    table.cell(statusTable, 0, 0, "추세 확인", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.cell(statusTable, 1, 0, "", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.merge_cells(statusTable, 0, 0, 1, 0)
    table.cell(statusTable, 0, 1, "단기추세", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=laggingStTooltip)
    table.cell(statusTable, 1, 1, stCellText, text_color=color.white, bgcolor=stCellColor, text_size=size.small, tooltip=laggingStTooltip)
    table.cell(statusTable, 0, 2, "중기추세", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=laggingMtTooltip)
    table.cell(statusTable, 1, 2, mtCellText, text_color=color.white, bgcolor=mtCellColor, text_size=size.small, tooltip=laggingMtTooltip)
    table.cell(statusTable, 0, 3, "장기추세", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=laggingLtTooltip)
    table.cell(statusTable, 1, 3, ltCellText, text_color=color.white, bgcolor=ltCellColor, text_size=size.small, tooltip=laggingLtTooltip)
    // 섹션1-2: 추세 전환가 (CEO 지시로 헤더 "추세 진입"→"추세 전환가" 개명) (CEO 지시 2026-10-16 — 구 "선행 추세 확인" 6행을 전환가 P* 4행으로 교체: TEMA 전환 / DEMA 전환 / 배열 전환 / T/D 전환 → 이후 CEO 지시로 배열 전환을 정배열 전환·역배열 전환 2행으로 분리해 5행). 기준봉=entryBase(기본 완성봉 — entryOff 0/1).
    table.cell(statusTable, 0, 4, "추세 전환가", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.cell(statusTable, 1, 4, "", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.merge_cells(statusTable, 0, 4, 1, 4)
    table.cell(statusTable, 0, 5, "TEMA 전환", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=entTemaTooltip)
    table.cell(statusTable, 1, 5, entTemaText, text_color=color.white, bgcolor=entTemaColor, text_size=size.small, tooltip=entTemaTooltip)
    table.cell(statusTable, 0, 6, "DEMA 전환", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=entDemaTooltip)
    table.cell(statusTable, 1, 6, entDemaText, text_color=color.white, bgcolor=entDemaColor, text_size=size.small, tooltip=entDemaTooltip)
    table.cell(statusTable, 0, 7, "정배열 전환", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=entArrBullTooltip)
    table.cell(statusTable, 1, 7, entArrBullText, text_color=color.white, bgcolor=entArrColor, text_size=size.small, tooltip=entArrBullTooltip)
    table.cell(statusTable, 0, 8, "역배열 전환", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=entArrBearTooltip)
    table.cell(statusTable, 1, 8, entArrBearText, text_color=color.white, bgcolor=entArrColor, text_size=size.small, tooltip=entArrBearTooltip)
    table.cell(statusTable, 0, 9, "T/D 전환", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=entTdTooltip)
    table.cell(statusTable, 1, 9, entTdText, text_color=color.white, bgcolor=entTdColor, text_size=size.small, tooltip=entTdTooltip)
    // 섹션2: 변동성 임계가 (밴드 상단 → 밴드 하단 → 이격도 → 되돌림). (CEO 지시: 헤더 "가격 구조 및 변동성 확인"→"변동성 확인"→"변동성 임계가", 비정상 매수/매도 행 삭제 — 캔들색으로 이미 표현.)
    table.cell(statusTable, 0, 10, "변동성 임계가", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.cell(statusTable, 1, 10, "", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.merge_cells(statusTable, 0, 10, 1, 10)
    // 밴드 상단/하단 2행(CEO 지시 — 구 vwap 기울기·vwap 구간 행 대체): 주 밴드(Band #2) 가격 (현재가 대비 ±%).
    table.cell(statusTable, 0, 11, "밴드 상단", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=volBandUpperTooltip)
    table.cell(statusTable, 1, 11, bandUpperText, text_color=color.white, bgcolor=bandUpperColor, text_size=size.small, tooltip=volBandUpperTooltip)
    table.cell(statusTable, 0, 12, "밴드 하단", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=volBandLowerTooltip)
    table.cell(statusTable, 1, 12, bandLowerText, text_color=color.white, bgcolor=bandLowerColor, text_size=size.small, tooltip=volBandLowerTooltip)
    table.cell(statusTable, 0, 13, "이격도 (" + str.tostring(disparityMaLen) + ")", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=volDisparityTooltip)
    table.cell(statusTable, 1, 13, disparityCellText, text_color=color.white, bgcolor=disparityCellColor, text_size=size.small, tooltip=volDisparityTooltip)
    table.cell(statusTable, 0, 14, "되돌림 가격", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=volPullbackTooltip)
    table.cell(statusTable, 1, 14, na(disparityPullbackPrice) ? "-" : f_priceStr(disparityPullbackPrice) + " (" + f_pctStr(disparityPullbackPrice) + ")", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small, tooltip=volPullbackTooltip)
    // 섹션3: 지지·저항 임계가 (CEO 지시로 헤더 "지지·저항 확인"→"지지·저항 임계가" 개명) (50선 / 100선 / 200선)
    table.cell(statusTable, 0, 15, "지지·저항 임계가", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.cell(statusTable, 1, 15, "", text_color=color.white, bgcolor=color.new(#1B2A4A, 0), text_size=size.small)
    table.merge_cells(statusTable, 0, 15, 1, 15)
    table.cell(statusTable, 0, 16, "50선", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=srVw50Tooltip)
    table.cell(statusTable, 1, 16, vwSrText, text_color=color.white, bgcolor=vwSrColor, text_size=size.small, tooltip=srVw50Tooltip)
    table.cell(statusTable, 0, 17, "100선", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=srVw100Tooltip)
    table.cell(statusTable, 1, 17, ltM1SrText, text_color=color.white, bgcolor=ltM1SrColor, text_size=size.small, tooltip=srVw100Tooltip)
    table.cell(statusTable, 0, 18, "200선", text_color=color.white, bgcolor=color.new(color.gray, 20), text_size=size.small, tooltip=srVw200Tooltip)
    table.cell(statusTable, 1, 18, ltM2SrText, text_color=color.white, bgcolor=ltM2SrColor, text_size=size.small, tooltip=srVw200Tooltip)
