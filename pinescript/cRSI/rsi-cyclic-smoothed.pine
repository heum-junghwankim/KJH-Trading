//@version=6
//
// Copyright (C) 2017 CC BY, whentotrade / Lars von Thienen
// Source:
// Book: Decoding The Hidden Market Rhythm - Part 1: Dynamic Cycles (2017)
// Chapter 4: "Fine-tuning technical indicators for more details on the cRSI Indicator
//
// Usage:
// You need to derive the dominant cycle as input parameter for the cycle length as described in chapter 4.
//
// License:
// This work is licensed under a Creative Commons Attribution 4.0 International License.
// You are free to share the material in any medium or format and remix, transform, and build upon the material for any purpose,
// even commercially. You must give appropriate credit to the authors book and website, provide a link to the license, and indicate
// if changes were made. You may do so in any reasonable manner, but not in any way that suggests the licensor endorses you or your use.
//
indicator(title="RSI cyclic smoothed", shorttitle="cRSI")

src = close
domcycle = input.int(20, minval=10, title="Dominant Cycle Length")
crsi = 0.0
cyclelen = int(domcycle / 2)
vibration = 10
leveling = 10.0
cyclicmemory = domcycle * 2

// 밴드폭 배경색 옵션
showBandWidthBg = input.bool(true, title="Show Band Width Background")
narrowBandThreshold = input.float(20.0, minval=0.0, title="Narrow Band Width Threshold")
wideBandThreshold = input.float(35.0, minval=0.0, title="Wide Band Width Threshold")
bgOpacity = input.int(15, minval=0, maxval=100, title="밴드 배경 불투명성 (0=투명, 100=진함)")

// 수축 구간 밴드 돌파 원 마커 옵션
oversoldLevel   = input.float(30.0, minval=0.0, maxval=100.0, title="과매도 참고 레벨", group="수축 돌파 마커")
overboughtLevel = input.float(70.0, minval=0.0, maxval=100.0, title="과매수 참고 레벨", group="수축 돌파 마커")
showBreakMarker = input.bool(true, title="수축 돌파 원 마커 표시", group="수축 돌파 마커", tooltip="밴드폭 수축(주황) 구간에서, cRSI가 상단밴드(ub)를 상향 돌파(crossover)하면 상단밴드 위치에 골든(녹색 원), cRSI가 하단밴드(db)를 하향 돌파(crossunder)하면 하단밴드 위치에 데드(빨강 원)를 표시. 돌파가 발생한 봉에만 표시.")

// 선 색상 (사용자 지정 가능, 기본값은 기존 하드코딩 색 유지)
crsiColor = input.color(#E6B800, title="cRSI 선 색", group="선 색상")
lowBandColor = input.color(#4DD0E1, title="하단밴드(LowBand) 색", group="선 색상")
highBandColor = input.color(#4DD0E1, title="상단밴드(HighBand) 색", group="선 색상")

// 밴드 교차 가격 테이블 옵션 (표시 전용 — 매매 신호 아님)
showCrossTable = input.bool(true, title="밴드 교차 가격 테이블 표시", group="밴드 교차 가격 테이블", tooltip="직전봉 확정 데이터만으로, 현재봉이 어느 종가로 마감하면 cRSI가 밴드(상단 ub/하단 db)를 넘나드는지 역산한 '종가 기준 조건 가격' 4행(상단 돌파/상단 이탈/하단 돌파/하단 이탈) 테이블. 현재봉 동안 값이 고정되어 리페인팅이 없습니다. 해당 상태에서 의미 없는 행은 '-', 수학적으로 도달할 수 없는 경우 '도달불가'. 매매 신호가 아닌 참고용입니다.")
crossTablePos  = input.string("우측 상단", title="테이블 위치", options=["우측 상단", "우측 하단", "좌측 상단", "좌측 하단", "중앙 상단", "중앙 하단"], group="밴드 교차 가격 테이블", active=showCrossTable)
crossTableSize = input.string("작게", title="글자 크기", options=["아주 작게", "작게", "보통", "크게"], group="밴드 교차 가격 테이블", active=showCrossTable)

h1 = hline(oversoldLevel, color=color.silver, linestyle=hline.style_dashed)
h2 = hline(overboughtLevel, color=color.silver, linestyle=hline.style_dashed)

torque = 2.0 / (vibration + 1)
phasingLag = int((vibration - 1) / 2)

up = ta.rma(math.max(ta.change(src), 0), cyclelen)
down = ta.rma(-math.min(ta.change(src), 0), cyclelen)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - 100 / (1 + up / down)
crsi := torque * (2 * rsi - rsi[phasingLag]) + (1 - torque) * nz(crsi[1])

lmax = -999999.0
lmin = 999999.0
for i = 0 to cyclicmemory - 1 by 1
    if nz(crsi[i], -999999.0) > lmax
        lmax := nz(crsi[i])
        lmax
    else
        if nz(crsi[i], 999999.0) < lmin
            lmin := nz(crsi[i])
            lmin

mstep = (lmax - lmin) / 100
aperc = leveling / 100

db = 0.0
for steps = 0 to 100 by 1
    testvalue = lmin + mstep * steps
    below = 0
    for m = 0 to cyclicmemory - 1 by 1
        below := below + (crsi[m] < testvalue ? 1 : 0)
        below

    ratio = below / cyclicmemory
    if ratio >= aperc
        db := testvalue
        break
    else
        continue

ub = 0.0
for steps = 0 to 100 by 1
    testvalue = lmax - mstep * steps
    above = 0
    for m = 0 to cyclicmemory - 1 by 1
        above := above + (crsi[m] >= testvalue ? 1 : 0)
        above

    ratio = above / cyclicmemory
    if ratio >= aperc
        ub := testvalue
        break
    else
        continue

// 밴드폭 계산
bandWidth = ub - db
narrowLimit = math.min(narrowBandThreshold, wideBandThreshold)
wideLimit = math.max(narrowBandThreshold, wideBandThreshold)

// 밴드폭이 좁으면 진한 주황색(수축), 넓으면 보라색(확장) 배경
bandBgColor = not showBandWidthBg or bar_index < cyclicmemory ? na :
     bandWidth <= narrowLimit ? #D35400 :
     bandWidth >= wideLimit ? color.purple : na

// 불투명성(opacity) 입력을 v6 방식으로 색상에 baking(0=투명, 100=진함). 투명도(transp) = 100 - opacity.
bgcolor(color.new(bandBgColor, 100 - bgOpacity))

// 밴드 상·하단(ub/db)은 우측 프라이스 스케일 라벨에 값 표시.
lowband = plot(db, "LowBand", lowBandColor, display = display.all)
highband = plot(ub, "HighBand", highBandColor, display = display.all)
plot(crsi, "CRSI", crsiColor, display = display.all)

// 밴드폭 상태 (수축 돌파 원 마커·확장 다이버전스 마커가 공용으로 사용)
narrowBw   = bandWidth <= narrowLimit
wideBw     = bandWidth >= wideLimit

// cRSI 다이버전스 (확장(보라) 구간에서만 신뢰): 상승=롱, 하락=숏
divLbL = 5
divLbR = 5
divRangeMax = 60
divRangeMin = 5
plFound = not na(ta.pivotlow(crsi, divLbL, divLbR))
phFound = not na(ta.pivothigh(crsi, divLbL, divLbR))
inRangeBull = ta.barssince(plFound[1]) >= divRangeMin and ta.barssince(plFound[1]) <= divRangeMax
inRangeBear = ta.barssince(phFound[1]) >= divRangeMin and ta.barssince(phFound[1]) <= divRangeMax
oscHL   = crsi[divLbR] > ta.valuewhen(plFound, crsi[divLbR], 1) and inRangeBull
priceLL = low[divLbR] < ta.valuewhen(plFound, low[divLbR], 1)
bullDiv = plFound and priceLL and oscHL
oscLH   = crsi[divLbR] < ta.valuewhen(phFound, crsi[divLbR], 1) and inRangeBear
priceHH = high[divLbR] > ta.valuewhen(phFound, high[divLbR], 1)
bearDiv = phFound and priceHH and oscLH

plotshape(bullDiv and wideBw ? crsi[divLbR] : na, title="cRSI 상승 다이버전스", style=shape.triangleup, location=location.absolute, color=color.green, size=size.tiny, offset=-divLbR)
plotshape(bearDiv and wideBw ? crsi[divLbR] : na, title="cRSI 하락 다이버전스", style=shape.triangledown, location=location.absolute, color=color.red, size=size.tiny, offset=-divLbR)

// =========================
// 수축(주황) 구간 밴드 돌파 원 마커
// =========================
// 밴드폭 수축(narrowBw, 당봉 주황) 상태에서, cRSI가 밴드를 실제로 돌파하는(crossover/crossunder)
// 시점에 원 마커를 표시한다.
//  - 골든: cRSI가 상단밴드(ub)를 상향 돌파(ta.crossover) → 상단밴드 ub 위치에 녹색 원
//  - 데드: cRSI가 하단밴드(db)를 하향 돌파(ta.crossunder) → 하단밴드 db 위치에 빨강 원
// 위치 무관·마진 없음: 돌파 시점 그 봉에만 표시된다(ta.crossover/crossunder 자체가 1회 이벤트).
// 크로스는 확정봉(barstate.isconfirmed) 기준으로만 확정해 미마감봉 점멸을 방지한다.
//
// [수축 구간당 각 1회 제한 래치]
// 한 수축 구간(narrowBw가 연속 true인 한 구간) 동안 골든은 최초 1회만, 데드도 최초 1회만 표시한다.
// 같은 수축 구간에서 두 번째 이후 크로스는 억제하고, 수축 구간이 새로 시작되면 래치를 리셋한다.
//  - 골든/데드는 서로 독립 래치(goldenFiredNarrow / deadFiredNarrow).
//  - fire·set은 확정봉(barstate.isconfirmed)에서 goldenBreak/deadBreak가 참일 때만 수행한다.
//    → 미마감봉에서 래치가 조기 설정돼 확정 시 어긋나는 리페인팅을 방지한다.
//    (crossover/crossunder는 미마감봉에서 점멸할 수 있으나, 래치 set은 확정봉 게이트를 통과한 뒤에만 일어남)
//  - 구간 시작 판정 newNarrow(narrowBw and not narrowBw[1])은 series 논리라 매 봉 평가되지만,
//    수축 구간의 첫 봉 리셋은 그 구간 내 확정봉 fire보다 시간상 앞서므로 래치 정합성에 문제 없음.
var bool goldenFiredNarrow = false
var bool deadFiredNarrow   = false
bool newNarrow = narrowBw and not narrowBw[1]   // 수축 구간 시작(직전 봉은 수축 아님)
if newNarrow
    goldenFiredNarrow := false
    deadFiredNarrow := false
bool rawGolden = narrowBw and ta.crossover(crsi, ub)  and crsi > crsi[1]
bool rawDead   = narrowBw and ta.crossunder(crsi, db) and crsi < crsi[1]
goldenBreak = showBreakMarker and barstate.isconfirmed and rawGolden and not goldenFiredNarrow
deadBreak   = showBreakMarker and barstate.isconfirmed and rawDead   and not deadFiredNarrow
if goldenBreak
    goldenFiredNarrow := true
if deadBreak
    deadFiredNarrow := true
plot(goldenBreak ? ub : na, title="수축 골든크로스", style=plot.style_circles, color=color.new(color.green, 0), linewidth=4, display=display.pane)
plot(deadBreak ? db : na, title="수축 데드크로스", style=plot.style_circles, color=color.new(color.red, 0), linewidth=4, display=display.pane)

// =========================
// 밴드 교차 가격 테이블 (표시 전용 — 매매 신호 아님)
// =========================
// 직전봉 확정 데이터만으로 "현재봉이 어느 종가로 마감하면 cRSI가 밴드를 넘나드는가"를 역산한다.
//  - close / crsi[0] / ub[0] / db[0] 미사용 → 현재봉 동안 값 고정(리페인팅 없음).
//  - 목표 cRSI 임계값: ub[1]/db[1]이 아니라 crsi[1..cyclicmemory-1] 기반 정확 임계값 U*, D*.
//    (현재봉 cRSI ≥ ub_t ⇔ ≥ U*, ≤ db_t ⇔ ≤ D* — 기존 밴드 루프(lmax/lmin 분기 포함)와 동치, brute-force 검증)
//  - 목표 RSI: crsi 재귀식 crsi = τ·(2·rsi − rsi[phasingLag]) + (1−τ)·crsi[1] 를 rsi에 대해 역산.
//  - 목표 가격: rma 재귀식 up/down 갱신을 Δ(= 종가 − 직전 종가)에 대해 역산.
// 필요한 [1] 기반 값은 전역에서 매 봉 확정 계산해 두고, 무거운 루프(약 2×101×39)는 barstate.islast에서만 돈다.
crUp1    = up[1]
crDown1  = down[1]
crCrsi1  = crsi[1]
crRsiLag = rsi[phasingLag]   // 현재봉 기준 phasingLag봉 전 rsi(확정값) — crsi 재귀식의 rsi[phasingLag]와 동일 인덱스
crClose1 = close[1]
crReady  = bar_index >= cyclicmemory + cyclelen + phasingLag + 1 and not na(crCrsi1) and not na(db[1]) and not na(ub[1])
// 직전봉 확정 상태: -1=하단 아래, 1=상단 위, 2=중간, 0=준비 안 됨
crState  = not crReady ? 0 : crsi[1] <= db[1] ? -1 : crsi[1] >= ub[1] ? 1 : 2

// 목표 cRSI(T) → 목표 종가. 반환 [가격, 상태] — 상태 0='-'(데이터 없음), 1=유효, 2=도달불가
f_crossPrice(float T, float u1, float d1, float c1, float r4, float p1) =>
    float res = na
    int st = 0
    if not (na(T) or na(u1) or na(d1) or na(c1) or na(r4) or na(p1)) and (u1 > 0 or d1 > 0)
        st := 2
        rT = ((T - (1 - torque) * c1) / torque + r4) / 2
        if rT > 0 and rT < 100
            R   = rT / (100 - rT)
            r0  = d1 == 0 ? 100.0 : u1 == 0 ? 0.0 : 100 - 100 / (1 + u1 / d1)
            k   = cyclelen - 1
            dlt = rT >= r0 ? k * (R * d1 - u1) : -k * (u1 / R - d1)
            if p1 + dlt > 0
                res := p1 + dlt
                st := 1
    [res, st]

// 틱 반올림. mode 1=올림(≥ 조건), 2=내림(≤ 조건), 3=엄격 올림(> 조건: 정확히 틱 위면 +1틱), 4=엄격 내림(< 조건: 정확히 틱 위면 −1틱)
f_crossTick(float p, int mode) =>
    mt  = syminfo.mintick
    q   = p / mt
    eps = 1e-9
    n   = mode == 1 ? math.ceil(q - eps) : mode == 2 ? math.floor(q + eps) : mode == 3 ? math.floor(q + eps) + 1 : math.ceil(q - eps) - 1
    n * mt

// 부호 포함 % (소수 2자리). 반올림 후 0이면 "0.00%"(−0.00 방지)
f_crossPct(float v) =>
    math.round(v * 100) == 0 ? "0.00%" : (v > 0 ? "+" : "") + str.tostring(v, "0.00") + "%"

// 가격 포맷: 천 단위 쉼표 + 종목 mintick 소수 자릿수(예: 1,000 / 12,345.6 / 0.25틱 → 12,345.25).
//  auto-vwap priceFmt("#,##0.0…")와 같은 방식이되, 자릿수는 mintick×10^d가 정수가 되는 최소 d로 산출
//  (0.25·0.005 같은 비10진 틱도 자릿수 손실 없음). 최대 8자리.
f_crossFmt() =>
    mt = syminfo.mintick
    int d = 0
    for i = 0 to 8
        d := i
        x = mt * math.pow(10, i)
        if math.abs(x - math.round(x)) < 1e-6
            break
    d == 0 ? "#,##0" : "#,##0." + str.repeat("0", d)

// 셀 텍스트: "가격 (±%)" / "도달불가" / "-"
f_crossCell(float p, int st, int mode, float p1, string fmt) =>
    string s = "-"
    if st == 2
        s := "도달불가"
    else if st == 1
        pr = f_crossTick(p, mode)
        if pr <= 0
            s := "도달불가"
        else
            s := str.tostring(pr, fmt) + " (" + f_crossPct((pr - p1) / p1 * 100) + ")"
    s

// 스타일: 테두리 회색 50·두께 1, 흰 글자(auto-vwap 테이블 컨벤션).
//  행 배경: 돌파 행=녹색 #2E7D32, 이탈 행=적색 #C62828(펀드 공용 팔레트). 라벨 투명도 20·값 투명도 40,
//  값이 '-'인 비활성 행은 라벨 65·값 80으로 흐리게 해 활성 행이 눈에 띄게 한다.
crossPos = crossTablePos == "우측 상단" ? position.top_right : crossTablePos == "좌측 상단" ? position.top_left : crossTablePos == "좌측 하단" ? position.bottom_left : crossTablePos == "중앙 상단" ? position.top_center : crossTablePos == "중앙 하단" ? position.bottom_center : position.bottom_right
crossTxt = crossTableSize == "아주 작게" ? size.tiny : crossTableSize == "보통" ? size.normal : crossTableSize == "크게" ? size.large : size.small
var table crossTable = table.new(crossPos, 2, 4, border_width=1, border_color=color.new(color.gray, 50))
if showCrossTable and barstate.islast
    string sUpBreak = "-"
    string sUpExit  = "-"
    string sDnBreak = "-"
    string sDnExit  = "-"
    fmt = f_crossFmt()
    if crState != 0
        // crsi[1..cyclicmemory-1]의 max/min (현재봉 crsi[0] 제외)
        float cMax = na
        float cMin = na
        for m = 1 to cyclicmemory - 1
            v = crsi[m]
            if not na(v)
                cMax := na(cMax) ? v : math.max(cMax, v)
                cMin := na(cMin) ? v : math.min(cMin, v)
        float uStar = na
        float dStar = na
        if not na(cMax)
            gStep = (cMax - cMin) / 100
            if crState == 2 or crState == 1
                for s = 0 to 100
                    g = cMax - s * gStep
                    float cntA = 0.0
                    for m = 1 to cyclicmemory - 1
                        cntA += crsi[m] >= g ? 1 : 0
                    if cntA / cyclicmemory >= aperc
                        uStar := g
                        break
            if crState == 2 or crState == -1
                for s = 0 to 100
                    g = cMin + s * gStep
                    float cntB = 0.0
                    for m = 1 to cyclicmemory - 1
                        cntB += crsi[m] < g ? 1 : 0
                    if cntB / cyclicmemory >= aperc
                        dStar := g
                        break
        [pU, stU] = f_crossPrice(uStar, crUp1, crDown1, crCrsi1, crRsiLag, crClose1)
        [pD, stD] = f_crossPrice(dStar, crUp1, crDown1, crCrsi1, crRsiLag, crClose1)
        if crState == 2
            sUpBreak := f_crossCell(pU, stU, 1, crClose1, fmt)   // cRSI ≥ U* → 올림
            sDnExit  := f_crossCell(pD, stD, 2, crClose1, fmt)   // cRSI ≤ D* → 내림
        else if crState == 1
            sUpExit  := f_crossCell(pU, stU, 4, crClose1, fmt)   // cRSI < U* → 엄격 내림
        else if crState == -1
            sDnBreak := f_crossCell(pD, stD, 3, crClose1, fmt)   // cRSI > D* → 엄격 올림
    color GRN = #2E7D32
    color RED = #C62828
    upBrkOn = sUpBreak != "-"
    upExtOn = sUpExit  != "-"
    dnBrkOn = sDnBreak != "-"
    dnExtOn = sDnExit  != "-"
    table.cell(crossTable, 0, 0, "상단 돌파", text_color=color.white, bgcolor=color.new(GRN, upBrkOn ? 20 : 65), text_size=crossTxt, tooltip="cRSI가 밴드 안(중간)일 때: 현재봉 종가가 이 가격 이상이면 cRSI ≥ 상단밴드. 직전봉 확정값 기준 종가 조건 가격(매매 신호 아님).")
    table.cell(crossTable, 1, 0, sUpBreak, text_color=color.white, bgcolor=color.new(GRN, upBrkOn ? 40 : 80), text_size=crossTxt)
    table.cell(crossTable, 0, 1, "상단 이탈", text_color=color.white, bgcolor=color.new(RED, upExtOn ? 20 : 65), text_size=crossTxt, tooltip="cRSI가 상단밴드 위일 때: 현재봉 종가가 이 가격 이하이면 cRSI < 상단밴드(밴드 안 복귀). 직전봉 확정값 기준 종가 조건 가격(매매 신호 아님).")
    table.cell(crossTable, 1, 1, sUpExit, text_color=color.white, bgcolor=color.new(RED, upExtOn ? 40 : 80), text_size=crossTxt)
    table.cell(crossTable, 0, 2, "하단 돌파", text_color=color.white, bgcolor=color.new(GRN, dnBrkOn ? 20 : 65), text_size=crossTxt, tooltip="cRSI가 하단밴드 아래일 때: 현재봉 종가가 이 가격 이상이면 cRSI > 하단밴드(밴드 안 복귀). 직전봉 확정값 기준 종가 조건 가격(매매 신호 아님).")
    table.cell(crossTable, 1, 2, sDnBreak, text_color=color.white, bgcolor=color.new(GRN, dnBrkOn ? 40 : 80), text_size=crossTxt)
    table.cell(crossTable, 0, 3, "하단 이탈", text_color=color.white, bgcolor=color.new(RED, dnExtOn ? 20 : 65), text_size=crossTxt, tooltip="cRSI가 밴드 안(중간)일 때: 현재봉 종가가 이 가격 이하이면 cRSI ≤ 하단밴드. 직전봉 확정값 기준 종가 조건 가격(매매 신호 아님).")
    table.cell(crossTable, 1, 3, sDnExit, text_color=color.white, bgcolor=color.new(RED, dnExtOn ? 40 : 80), text_size=crossTxt)
