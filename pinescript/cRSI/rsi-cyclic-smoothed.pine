// Source:
// Book: Decoding The Hidden Market Rhythm - Part 1: Dynamic Cycles (2017)
// Chapter 4: "Fine-tuning technical indicators for more details on the cRSI Indicator
//
// Usage:
// You need to derive the dominant cycle as input parameter for the cycle length as described in chapter 4.
//
// License:
// This work is licensed under a Creative Commons Attribution 4.0 International License.
// You are free to share the material in any medium or format and remix, transform, and build upon the material for any purpose,
// even commercially. You must give appropriate credit to the authors book and website, provide a link to the license, and indicate
// if changes were made. You may do so in any reasonable manner, but not in any way that suggests the licensor endorses you or your use.
//
indicator(title="RSI cyclic smoothed", shorttitle="cRSI")

src = close
domcycle = input.int(20, minval=10, title="Dominant Cycle Length")
crsi = 0.0
cyclelen = int(domcycle / 2)
vibration = 10
leveling = 10.0
cyclicmemory = domcycle * 2

// 밴드폭 배경색 옵션
showBandWidthBg = input.bool(true, title="Show Band Width Background")
narrowBandThreshold = input.float(20.0, minval=0.0, title="Narrow Band Width Threshold")
wideBandThreshold = input.float(35.0, minval=0.0, title="Wide Band Width Threshold")
bgOpacity = input.int(15, minval=0, maxval=100, title="밴드 배경 불투명성 (0=투명, 100=진함)")

// 과매도/과매수 참고 점선 레벨 (표시 전용)
oversoldLevel   = input.float(30.0, minval=0.0, maxval=100.0, title="과매도 참고 레벨", group="참고 레벨")
overboughtLevel = input.float(70.0, minval=0.0, maxval=100.0, title="과매수 참고 레벨", group="참고 레벨")

// 선 색상 (사용자 지정 가능, 기본값은 기존 하드코딩 색 유지)
crsiColor = input.color(#E6B800, title="cRSI 선 색", group="선 색상")
lowBandColor = input.color(#4DD0E1, title="하단밴드(LowBand) 색", group="선 색상")
highBandColor = input.color(#4DD0E1, title="상단밴드(HighBand) 색", group="선 색상")

// 밴드 교차 가격 테이블 옵션 (표시 전용 — 매매 신호 아님)
showCrossTable = input.bool(true, title="밴드 교차 가격 테이블 표시", group="밴드 교차 가격 테이블", tooltip="기준봉('테이블 기준봉' 설정) 데이터로, 그 다음 봉이 어느 종가로 마감하면 cRSI가 밴드(상단 ub/하단 db)를 넘나드는지 역산한 '종가 기준 조건 가격' 4행(상단 돌파/상단 이탈/하단 돌파/하단 이탈) 테이블. 리페인팅 여부는 기준봉 설정에 따릅니다(실시간봉=틱마다 갱신, 완성봉=고정). 해당 상태에서 의미 없는 행은 '-', 수학적으로 도달할 수 없거나 기준 종가 대비 변동률이 ±100% 초과(표시 기준 ±100.0% 초과)인 경우 '도달불가'. 매매 신호가 아닌 참고용입니다.")
crossTableBase = input.string("실시간봉", title="테이블 기준봉", options=["실시간봉", "완성봉"], group="밴드 교차 가격 테이블", active=showCrossTable, tooltip="실시간봉: 현재 형성 중 봉(차트 마지막 봉 [0]) 기준, 틱마다 갱신(의도된 리얼타임 리페인팅). 상태는 차트에 보이는 현재 cRSI 위치와 일치하고, 가격은 '다음 봉 종가가 얼마면 교차하는가', %는 현재 봉 종가 대비. 봉 마감 시점 값은 완성봉 모드와 동일.\n완성봉: 가장 최근 완성봉 기준(형성 중=직전봉, 마감된 마지막 봉·바 리플레이=그 봉), 형성 중 봉의 틱 변동에 값 고정(리페인팅 없음). 가격은 형성 중이거나 다음에 올 봉의 종가 조건.")
crossTablePos  = input.string("우측 상단", title="테이블 위치", options=["우측 상단", "우측 하단", "좌측 상단", "좌측 하단", "중앙 상단", "중앙 하단"], group="밴드 교차 가격 테이블", active=showCrossTable)
crossTableSize = input.string("작게", title="글자 크기", options=["아주 작게", "작게", "보통", "크게"], group="밴드 교차 가격 테이블", active=showCrossTable)

h1 = hline(oversoldLevel, color=color.silver, linestyle=hline.style_dashed)
h2 = hline(overboughtLevel, color=color.silver, linestyle=hline.style_dashed)

torque = 2.0 / (vibration + 1)
phasingLag = int((vibration - 1) / 2)

up = ta.rma(math.max(ta.change(src), 0), cyclelen)
down = ta.rma(-math.min(ta.change(src), 0), cyclelen)
rsi = down == 0 ? 100 : up == 0 ? 0 : 100 - 100 / (1 + up / down)
crsi := torque * (2 * rsi - rsi[phasingLag]) + (1 - torque) * nz(crsi[1])

lmax = -999999.0
lmin = 999999.0
for i = 0 to cyclicmemory - 1 by 1
    if nz(crsi[i], -999999.0) > lmax
        lmax := nz(crsi[i])
        lmax
    else
        if nz(crsi[i], 999999.0) < lmin
            lmin := nz(crsi[i])
            lmin

mstep = (lmax - lmin) / 100
aperc = leveling / 100

db = 0.0
for steps = 0 to 100 by 1
    testvalue = lmin + mstep * steps
    below = 0
    for m = 0 to cyclicmemory - 1 by 1
        below := below + (crsi[m] < testvalue ? 1 : 0)
        below

    ratio = below / cyclicmemory
    if ratio >= aperc
        db := testvalue
        break
    else
        continue

ub = 0.0
for steps = 0 to 100 by 1
    testvalue = lmax - mstep * steps
    above = 0
    for m = 0 to cyclicmemory - 1 by 1
        above := above + (crsi[m] >= testvalue ? 1 : 0)
        above

    ratio = above / cyclicmemory
    if ratio >= aperc
        ub := testvalue
        break
    else
        continue

// 밴드폭 계산
bandWidth = ub - db
narrowLimit = math.min(narrowBandThreshold, wideBandThreshold)
wideLimit = math.max(narrowBandThreshold, wideBandThreshold)

// 밴드폭이 좁으면 진한 주황색(수축), 넓으면 보라색(확장) 배경
bandBgColor = not showBandWidthBg or bar_index < cyclicmemory ? na :
     bandWidth <= narrowLimit ? #D35400 :
     bandWidth >= wideLimit ? color.purple : na

// 불투명성(opacity) 입력을 v6 방식으로 색상에 baking(0=투명, 100=진함). 투명도(transp) = 100 - opacity.
bgcolor(color.new(bandBgColor, 100 - bgOpacity))

// 밴드 상·하단(ub/db)은 우측 프라이스 스케일 라벨에 값 표시.
lowband = plot(db, "LowBand", lowBandColor, display = display.all)
highband = plot(ub, "HighBand", highBandColor, display = display.all)
plot(crsi, "CRSI", crsiColor, display = display.all)

// 밴드폭 상태 (확장 다이버전스 마커 게이트)
wideBw     = bandWidth >= wideLimit

// cRSI 다이버전스 (확장(보라) 구간에서만 신뢰): 상승=롱, 하락=숏
divLbL = 5
divLbR = 5
divRangeMax = 60
divRangeMin = 5
plFound = not na(ta.pivotlow(crsi, divLbL, divLbR))
phFound = not na(ta.pivothigh(crsi, divLbL, divLbR))
inRangeBull = ta.barssince(plFound[1]) >= divRangeMin and ta.barssince(plFound[1]) <= divRangeMax
inRangeBear = ta.barssince(phFound[1]) >= divRangeMin and ta.barssince(phFound[1]) <= divRangeMax
oscHL   = crsi[divLbR] > ta.valuewhen(plFound, crsi[divLbR], 1) and inRangeBull
priceLL = low[divLbR] < ta.valuewhen(plFound, low[divLbR], 1)
bullDiv = plFound and priceLL and oscHL
oscLH   = crsi[divLbR] < ta.valuewhen(phFound, crsi[divLbR], 1) and inRangeBear
priceHH = high[divLbR] > ta.valuewhen(phFound, high[divLbR], 1)
bearDiv = phFound and priceHH and oscLH

plotshape(bullDiv and wideBw ? crsi[divLbR] : na, title="cRSI 상승 다이버전스", style=shape.triangleup, location=location.absolute, color=color.green, size=size.tiny, offset=-divLbR)
plotshape(bearDiv and wideBw ? crsi[divLbR] : na, title="cRSI 하락 다이버전스", style=shape.triangledown, location=location.absolute, color=color.red, size=size.tiny, offset=-divLbR)

// =========================
// 밴드 교차 가격 테이블 (표시 전용 — 매매 신호 아님)
// =========================
// "가장 최근 완성(확정)봉"을 기준봉으로, 그 다음 봉(형성 중이거나 다음에 올 봉)이 어느 종가로 마감하면
// cRSI가 밴드를 넘나드는가를 역산한다.
//  - 기준 오프셋 k(crK): 마지막 봉이 "끝났는가"를 시간 기준으로 판정한다.
//    barClosed = time_close가 있으면 timenow ≥ time_close(봉 마감 시각 경과), 없으면(na) barstate.isconfirmed 폴백.
//    k = (barClosed or barstate.isconfirmed) ? 0 : 1 → 끝난 마지막봉=그 봉이 완성봉(k=0), 형성 중=직전봉이 완성봉(k=1).
//    isconfirmed 단독 판정은 Bar Replay에서 실패한다 — 리플레이로 새로 나타난 마지막봉은 실시간 봉으로 처리되어
//    다음 스텝 전까지 isconfirmed=false이므로 k=1(이미 지나간 직전봉 기준)이 되어 버린다. timenow는 실제 시각이라
//    리플레이 봉의 time_close보다 항상 커서 k=0이 된다.
//    실시간 봉의 마감 틱에서 순간 k=0이 되는 것은 그 순간 해당 봉이 완성봉이므로 정합(다음 봉 개시 시 k=1로 같은 기준).
//  - 목표봉 = 기준봉 + 1 = 현재 인덱스 기준 오프셋 k−1. 모든 참조는 k 기반(k=1이면 기존 [1] 기준과 동일).
//  - 형성 중인 봉 값(k=1일 때 close / crsi[0] / ub[0] / db[0])은 미사용 → 형성 중 틱 변동에 값 고정(리페인팅 없음).
//  - 목표 cRSI 임계값: ub[k]/db[k]이 아니라 목표봉 기준 직전 cyclicmemory−1개 crsi[m+k−1](m=1..cyclicmemory−1) 기반 정확 임계값 U*, D*.
//    (목표봉 cRSI ≥ ub ⇔ ≥ U*, ≤ db ⇔ ≤ D* — 기존 밴드 루프(lmax/lmin 분기 포함)와 동치, brute-force 검증)
//  - 목표 RSI: crsi 재귀식 crsi = τ·(2·rsi − rsi[phasingLag]) + (1−τ)·crsi[1] 를 목표봉 기준으로 옮겨 rsi에 대해 역산
//    (목표봉의 rsi[phasingLag] = 현재 기준 rsi[phasingLag + k − 1], crsi[1] = crsi[k]).
//  - 목표 가격: rma 재귀식 up/down 갱신을 Δ(= 목표 종가 − 기준 종가 close[k])에 대해 역산.
//  - 기준봉 모드('테이블 기준봉'): 위 k 판정은 '완성봉' 모드에만 적용. '실시간봉'(기본) 모드는 항상 k=0 —
//    마지막 봉 [0](형성 중이면 형성 중 봉)을 기준봉으로 삼아 틱마다 갱신(의도된 리얼타임 리페인팅).
//    두 모드는 k만 다르고 역산식·참조 구조는 동일(k=0 경로는 완성봉 모드의 마감봉 경로와 같음 → 봉 마감 시점 값 일치).
// 동적 오프셋 k 참조와 무거운 루프(약 2×101×39)는 barstate.islast 블록에서만 수행한다(전역 series의 series int 오프셋 history 참조).
// 참조 깊이는 최대 crsi[cyclicmemory−1]·rsi[phasingLag]·up/down/ub/db/src[1]로 얕다(crsi·rsi는 전역 루프·재귀식에서 이미 그 깊이를 참조).
crReadyLen = cyclicmemory + cyclelen + phasingLag   // 기준봉 bar_index 하한(기존 bar_index ≥ …+1 은 k=1 기준과 동치)
// islast 블록에서만 쓰는 [k] 참조(최대 [1])의 history 버퍼를 전역에서 명시 확보 — 마지막 봉에서 처음 참조할 때
// "referencing length" 런타임 오류를 예방(up/down/ub/db는 이 테이블 외에 history 참조가 없음). 계산값 영향 없음.
max_bars_back(up, 2)
max_bars_back(down, 2)
max_bars_back(ub, 2)
max_bars_back(db, 2)
max_bars_back(src, 2)

// 목표 cRSI(T) → 목표 종가. 반환 [가격, 상태] — 상태 0='-'(데이터 없음), 1=유효, 2=도달불가
f_crossPrice(float T, float u1, float d1, float c1, float r4, float p1) =>
    float res = na
    int st = 0
    if not (na(T) or na(u1) or na(d1) or na(c1) or na(r4) or na(p1)) and (u1 > 0 or d1 > 0)
        st := 2
        rT = ((T - (1 - torque) * c1) / torque + r4) / 2
        if rT > 0 and rT < 100
            R   = rT / (100 - rT)
            r0  = d1 == 0 ? 100.0 : u1 == 0 ? 0.0 : 100 - 100 / (1 + u1 / d1)
            k   = cyclelen - 1
            dlt = rT >= r0 ? k * (R * d1 - u1) : -k * (u1 / R - d1)
            if p1 + dlt > 0
                res := p1 + dlt
                st := 1
    [res, st]

// 틱 반올림. mode 1=올림(≥ 조건), 2=내림(≤ 조건), 3=엄격 올림(> 조건: 정확히 틱 위면 +1틱), 4=엄격 내림(< 조건: 정확히 틱 위면 −1틱)
f_crossTick(float p, int mode) =>
    mt  = syminfo.mintick
    q   = p / mt
    eps = 1e-9
    n   = mode == 1 ? math.ceil(q - eps) : mode == 2 ? math.floor(q + eps) : mode == 3 ? math.floor(q + eps) + 1 : math.ceil(q - eps) - 1
    n * mt

// 부호 포함 % (소수 1자리). 반올림 정수 n=round(v×10) 하나로 부호·숫자를 모두 만든다 —
//  n=0이면 "0.0%"(−0.0 방지), 아니면 n/10을 표시(문자열 포맷의 반올림 규칙과 어긋날 여지 없음).
f_crossPct(float v) =>
    n = math.round(v * 10)
    n == 0 ? "0.0%" : (n > 0 ? "+" : "") + str.tostring(n / 10.0, "0.0") + "%"

// 가격 포맷: 천 단위 쉼표 + 종목 mintick 소수 자릿수(예: 1,000 / 12,345.6 / 0.25틱 → 12,345.25).
//  auto-vwap priceFmt("#,##0.0…")와 같은 방식이되, 자릿수는 mintick×10^d가 정수가 되는 최소 d로 산출
//  (0.25·0.005 같은 비10진 틱도 자릿수 손실 없음). 최대 8자리.
f_crossFmt() =>
    mt = syminfo.mintick
    int d = 0
    for i = 0 to 8
        d := i
        x = mt * math.pow(10, i)
        if math.abs(x - math.round(x)) < 1e-6
            break
    d == 0 ? "#,##0" : "#,##0." + str.repeat("0", d)

// 셀 텍스트: "가격 (±%)" / "도달불가" / "-" + 부호 sg(1=+, −1=−, 0=해당 없음)
//  sg는 실제 부호(틱 반올림 가격 − 기준 종가)로 정하되, 표시 %가 반올림으로 0.0이면 0 —
//  f_crossPct와 같은 반올림 정수 n=round(pct×10)로 0.0 판정 → 표시 부호와 하이라이트가 항상 일치.
//  '-'·'도달불가'는 sg=0.
//  기준 종가 대비 변동률이 표시상 ±100.0% 초과(n > 1000 or n < −1000, n=round(pct×10))이면 '도달불가' —
//  표시 반올림 정수로 판정해 "+100.0%"로 보이는 값은 항상 표시, "+100.1%" 이상만 도달불가(표시와 판정 일치).
f_crossCell(float p, int st, int mode, float p1, string fmt) =>
    string s = "-"
    int sg = 0
    if st == 2
        s := "도달불가"
    else if st == 1
        pr = f_crossTick(p, mode)
        if pr <= 0
            s := "도달불가"
        else
            pct = (pr - p1) / p1 * 100
            n   = math.round(pct * 10)   // f_crossPct와 같은 반올림 정수 → 표시 부호·±100% 판정과 동일
            if n > 1000 or n < -1000
                s := "도달불가"
            else
                s := str.tostring(pr, fmt) + " (" + f_crossPct(pct) + ")"
                sg := n == 0 ? 0 : pr > p1 ? 1 : -1
    [s, sg]

// 스타일: 테두리 회색 50·두께 1, 흰 글자(auto-vwap 테이블 컨벤션).
//  행 배경(전부 불투명, transp 0): 돌파 행=녹색 #2E7D32, 이탈 행=적색 #C62828(펀드 공용 팔레트) 라벨,
//  값 셀은 한 톤 밝은 동계열 단색(녹 #388E3C / 적 #D32F2F). 값이 '-'인 비활성 행은 어두운 저채도 톤
//  (녹 라벨 #1B3A1E·값 #142B17 / 적 라벨 #3E1A1A·값 #2E1414)에 회색 글자 #9E9E9E로 낮춰 활성 행이 눈에 띄게 한다.
//  테두리는 불투명 회색 #555555.
crossPos = crossTablePos == "우측 상단" ? position.top_right : crossTablePos == "좌측 상단" ? position.top_left : crossTablePos == "좌측 하단" ? position.bottom_left : crossTablePos == "중앙 상단" ? position.top_center : crossTablePos == "중앙 하단" ? position.bottom_center : position.bottom_right
crossTxt = crossTableSize == "아주 작게" ? size.tiny : crossTableSize == "보통" ? size.normal : crossTableSize == "크게" ? size.large : size.small
var table crossTable = table.new(crossPos, 2, 4, border_width=1, border_color=#555555)
if showCrossTable and barstate.islast
    string sUpBreak = "-"
    string sUpExit  = "-"
    string sDnBreak = "-"
    string sDnExit  = "-"
    // 각 행 값의 % 부호(하이라이트 판정용, 1=+ / −1=− / 0=0.0%·'-'·도달불가)
    int gUpBreak = 0   // 행 0 상단 돌파
    int gUpExit  = 0   // 행 1 상단 이탈
    int gDnBreak = 0   // 행 2 하단 돌파
    int gDnExit  = 0   // 행 3 하단 이탈
    fmt = f_crossFmt()
    // 기준 오프셋: 실시간봉 모드 → 항상 0(마지막 봉 [0], 틱마다 갱신)
    //  완성봉 모드 → 끝난 마지막봉(시간 경과 또는 확정) 0, 형성 중(실시간) 1
    //  time_close na(틱·레인지·렌코 등 가격 기반 차트의 열린 실시간 봉) → isconfirmed 폴백(기존 동작)
    bool crBarClosed = not na(time_close) ? timenow >= time_close : barstate.isconfirmed
    int crK = crossTableBase == "실시간봉" ? 0 : (crBarClosed or barstate.isconfirmed) ? 0 : 1
    crUp1    = up[crK]
    crDown1  = down[crK]
    crCrsi1  = crsi[crK]
    crRsiLag = rsi[phasingLag + crK - 1]   // 목표봉 기준 phasingLag봉 전 rsi(확정값) — crsi 재귀식의 rsi[phasingLag]를 목표봉 기준으로 옮긴 인덱스
    crClose1 = src[crK]   // src = close
    crReady  = bar_index - crK >= crReadyLen and not na(crCrsi1) and not na(db[crK]) and not na(ub[crK])
    // 기준봉(모드별: 실시간봉=[0], 완성봉=최근 완성봉) 상태: -1=하단 아래, 1=상단 위, 2=중간, 0=준비 안 됨
    crState  = not crReady ? 0 : crCrsi1 <= db[crK] ? -1 : crCrsi1 >= ub[crK] ? 1 : 2
    if crState != 0
        // 목표봉 기준 직전 cyclicmemory−1개 crsi[m+k−1]의 max/min (목표봉 자신 제외)
        float cMax = na
        float cMin = na
        for m = 1 to cyclicmemory - 1
            v = crsi[m + crK - 1]
            if not na(v)
                cMax := na(cMax) ? v : math.max(cMax, v)
                cMin := na(cMin) ? v : math.min(cMin, v)
        float uStar = na
        float dStar = na
        if not na(cMax)
            gStep = (cMax - cMin) / 100
            if crState == 2 or crState == 1
                for s = 0 to 100
                    g = cMax - s * gStep
                    float cntA = 0.0
                    for m = 1 to cyclicmemory - 1
                        cntA += crsi[m + crK - 1] >= g ? 1 : 0
                    if cntA / cyclicmemory >= aperc
                        uStar := g
                        break
            if crState == 2 or crState == -1
                for s = 0 to 100
                    g = cMin + s * gStep
                    float cntB = 0.0
                    for m = 1 to cyclicmemory - 1
                        cntB += crsi[m + crK - 1] < g ? 1 : 0
                    if cntB / cyclicmemory >= aperc
                        dStar := g
                        break
        [pU, stU] = f_crossPrice(uStar, crUp1, crDown1, crCrsi1, crRsiLag, crClose1)
        [pD, stD] = f_crossPrice(dStar, crUp1, crDown1, crCrsi1, crRsiLag, crClose1)
        if crState == 2
            [s1, g1] = f_crossCell(pU, stU, 1, crClose1, fmt)   // cRSI ≥ U* → 올림
            [s2, g2] = f_crossCell(pD, stD, 2, crClose1, fmt)   // cRSI ≤ D* → 내림
            sUpBreak := s1
            gUpBreak := g1
            sDnExit  := s2
            gDnExit  := g2
        else if crState == 1
            [s3, g3] = f_crossCell(pU, stU, 4, crClose1, fmt)   // cRSI < U* → 엄격 내림
            sUpExit  := s3
            gUpExit  := g3
        else if crState == -1
            [s4, g4] = f_crossCell(pD, stD, 3, crClose1, fmt)   // cRSI > D* → 엄격 올림
            sDnBreak := s4
            gDnBreak := g4
    color GRN       = #2E7D32   // 녹 라벨(활성)
    color GRN_V     = #388E3C   // 녹 값(활성) — 한 톤 밝게
    color GRN_OFF   = #1B3A1E   // 녹 라벨(비활성) — 어두운 저채도
    color GRN_OFF_V = #142B17   // 녹 값(비활성)
    color RED       = #C62828   // 적 라벨(활성)
    color RED_V     = #D32F2F   // 적 값(활성) — 한 톤 밝게
    color RED_OFF   = #3E1A1A   // 적 라벨(비활성) — 어두운 저채도
    color RED_OFF_V = #2E1414   // 적 값(비활성)
    color TXT_OFF   = #9E9E9E   // 비활성 행 글자(회색)
    color TXT_HL    = #FFFF00   // 특수 상황 값 글자(순수 노랑, 굵게) — 대비비 #388E3C 위 3.83:1 / #D32F2F 위 4.64:1
    upBrkOn = sUpBreak != "-"
    upExtOn = sUpExit  != "-"
    dnBrkOn = sDnBreak != "-"
    dnExtOn = sDnExit  != "-"
    // 특수 상황(행 종류 기준 일반 규칙): 돌파 행이 −% / 이탈 행이 +% → 보합·역방향 소폭 움직임에도
    //  다음 봉 교차 → 값 글자 순수 노랑 + 굵게. 0.0%(sg=0)·'-'·도달불가는 미강조.
    upBrkHL = upBrkOn and gUpBreak < 0   // 돌파 행: −%
    upExtHL = upExtOn and gUpExit  > 0   // 이탈 행: +%
    dnBrkHL = dnBrkOn and gDnBreak < 0   // 돌파 행: −%
    dnExtHL = dnExtOn and gDnExit  > 0   // 이탈 행: +%
    table.cell(crossTable, 0, 0, "상단 돌파", text_color=upBrkOn ? color.white : TXT_OFF, bgcolor=upBrkOn ? GRN : GRN_OFF, text_size=crossTxt, tooltip="cRSI가 밴드 안(중간)일 때: 다음 봉 종가가 이 가격 이상이면 cRSI ≥ 상단밴드. 기준봉('테이블 기준봉' 설정) 값 기준 종가 조건 가격(매매 신호 아님). 값이 노란 굵은 글자(−%)면 보합·소폭 하락에도 다음 봉 돌파.")
    table.cell(crossTable, 1, 0, sUpBreak, text_color=upBrkHL ? TXT_HL : upBrkOn ? color.white : TXT_OFF, bgcolor=upBrkOn ? GRN_V : GRN_OFF_V, text_size=crossTxt, text_formatting=upBrkHL ? text.format_bold : text.format_none)
    table.cell(crossTable, 0, 1, "상단 이탈", text_color=upExtOn ? color.white : TXT_OFF, bgcolor=upExtOn ? RED : RED_OFF, text_size=crossTxt, tooltip="cRSI가 상단밴드 위일 때: 다음 봉 종가가 이 가격 이하이면 cRSI < 상단밴드(밴드 안 복귀). 기준봉('테이블 기준봉' 설정) 값 기준 종가 조건 가격(매매 신호 아님). 값이 노란 굵은 글자(+%)면 보합·소폭 상승에도 다음 봉 이탈.")
    table.cell(crossTable, 1, 1, sUpExit, text_color=upExtHL ? TXT_HL : upExtOn ? color.white : TXT_OFF, bgcolor=upExtOn ? RED_V : RED_OFF_V, text_size=crossTxt, text_formatting=upExtHL ? text.format_bold : text.format_none)
    table.cell(crossTable, 0, 2, "하단 돌파", text_color=dnBrkOn ? color.white : TXT_OFF, bgcolor=dnBrkOn ? GRN : GRN_OFF, text_size=crossTxt, tooltip="cRSI가 하단밴드 아래일 때: 다음 봉 종가가 이 가격 이상이면 cRSI > 하단밴드(밴드 안 복귀). 기준봉('테이블 기준봉' 설정) 값 기준 종가 조건 가격(매매 신호 아님). 값이 노란 굵은 글자(−%)면 보합·소폭 하락에도 다음 봉 돌파.")
    table.cell(crossTable, 1, 2, sDnBreak, text_color=dnBrkHL ? TXT_HL : dnBrkOn ? color.white : TXT_OFF, bgcolor=dnBrkOn ? GRN_V : GRN_OFF_V, text_size=crossTxt, text_formatting=dnBrkHL ? text.format_bold : text.format_none)
    table.cell(crossTable, 0, 3, "하단 이탈", text_color=dnExtOn ? color.white : TXT_OFF, bgcolor=dnExtOn ? RED : RED_OFF, text_size=crossTxt, tooltip="cRSI가 밴드 안(중간)일 때: 다음 봉 종가가 이 가격 이하이면 cRSI ≤ 하단밴드. 기준봉('테이블 기준봉' 설정) 값 기준 종가 조건 가격(매매 신호 아님). 값이 노란 굵은 글자(+%)면 보합·소폭 상승에도 다음 봉 이탈.")
    table.cell(crossTable, 1, 3, sDnExit, text_color=dnExtHL ? TXT_HL : dnExtOn ? color.white : TXT_OFF, bgcolor=dnExtOn ? RED_V : RED_OFF_V, text_size=crossTxt, text_formatting=dnExtHL ? text.format_bold : text.format_none)
