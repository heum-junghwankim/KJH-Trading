//@version=6
indicator(title="Triple-Stochastic-Wave", shorttitle="Triple-Stoch-Wave", format=format.price, precision=2)

stoch_pair(length, smooth_k, smooth_d) =>
    highest_high = ta.highest(high, length)
    lowest_low = ta.lowest(low, length)
    price_range = math.max(highest_high - lowest_low, syminfo.mintick)
    raw_k = 100.0 * (close - lowest_low) / price_range
    k = ta.sma(raw_k, smooth_k)
    d = ta.sma(k, smooth_d)
    [k, d, raw_k]

// 서열 전환 가격 테이블용 직전 이력(표시 전용). 매 봉 전역에서 호출해 [0]/[1] 두 기준을 모두 정적 참조로 확보한다.
//  hh/ll = 최근 (length−1)봉 고가/저가 극값(length=1이면 na), rs = 최근 (smooth_k−1)개 raw 합, ks = 최근 (smooth_d−1)개 %K 합(길이 1이면 0).
//  *0 = 현재 봉 [0]에서 끝나는 창(다음 봉이 목표일 때), *1 = 직전 봉 [1]에서 끝나는 창(현재 봉이 목표일 때).
stoch_hist(length, smooth_k, smooth_d, raw_k, k) =>
    hh_all = ta.highest(high, math.max(length - 1, 1))
    ll_all = ta.lowest(low, math.max(length - 1, 1))
    rs_all = math.sum(raw_k, math.max(smooth_k - 1, 1))
    ks_all = math.sum(k, math.max(smooth_d - 1, 1))
    hh0 = length > 1 ? hh_all : na
    ll0 = length > 1 ? ll_all : na
    rs0 = smooth_k > 1 ? rs_all : 0.0
    ks0 = smooth_d > 1 ? ks_all : 0.0
    [hh0, ll0, rs0, ks0, hh0[1], ll0[1], rs0[1], ks0[1]]

fast_length = input.int(5, "Fast Length", minval=1, group="Fast Stochastic (5/3/3)", inline="fast1")
fast_smooth_k = input.int(3, "Smooth K", minval=1, group="Fast Stochastic (5/3/3)", inline="fast1")
fast_smooth_d = input.int(3, "Smooth D", minval=1, group="Fast Stochastic (5/3/3)", inline="fast1")

mid_length = input.int(10, "Mid Length", minval=1, group="Mid Stochastic (10/6/6)", inline="mid1")
mid_smooth_k = input.int(6, "Smooth K", minval=1, group="Mid Stochastic (10/6/6)", inline="mid1")
mid_smooth_d = input.int(6, "Smooth D", minval=1, group="Mid Stochastic (10/6/6)", inline="mid1")

slow_length = input.int(20, "Slow Length", minval=1, group="Slow Stochastic (20/9/9)", inline="slow1")
slow_smooth_k = input.int(9, "Smooth K", minval=1, group="Slow Stochastic (20/9/9)", inline="slow1")
slow_smooth_d = input.int(9, "Smooth D", minval=1, group="Slow Stochastic (20/9/9)", inline="slow1")

oversold = input.int(20, "Oversold", minval=0, maxval=50, group="Wave Rules", inline="rule1")
overbought = input.int(80, "Overbought", minval=50, maxval=100, group="Wave Rules", inline="rule1")
trend_midline = input.int(50, "Trend Midline", minval=0, maxval=100, group="Wave Rules", inline="rule1")
// 기준선(Basis): 배경 서열 판정·선 표기·서열 전환 가격 테이블 계산을 하나의 옵션으로 함께 결정. 기본 K선(CEO 확정).
basis = input.string("K선", "Basis", options=["K선", "D선"], group="Wave Rules", inline="rule2", tooltip="배경 서열 판정과 선 표기를 함께 결정하는 기준선입니다(서열 전환 가격 테이블의 계산 기준도 같음).\nK선(기본): Slow/Mid/Fast 각각의 %K를 그리고, fast %K > mid %K > slow %K = 정배열(녹), 역순 = 역배열(적) (빠르고 민감).\nD선: Slow/Mid/Fast 각각의 %D를 그리고, fast %D > mid %D > slow %D = 정배열, 역순 = 역배열 (매끄럽고 늦음).\n화면의 선과 배경 서열은 항상 같은 기준선입니다. 3중 정렬 alert(%K vs 자기 %D)는 이 옵션과 무관합니다.")
basis_use_d = basis == "D선"

// 서열 전환 가격 테이블 옵션 (표시 전용 — 매매 신호 아님). 기준봉·위치·글자 크기 옵션은 cRSI 밴드 교차 가격 테이블과 같은 방식.
show_order_table = input.bool(true, "Show Order Table", group="Order Table", tooltip="Basis 기준 서열(정배열/중립/역배열) 3행 테이블. 각 행 = 그 서열이 되려면 목표봉 종가가 기준 종가 대비 몇 % 움직여야 하는가(틱 반올림 가격 기준, 소수 1자리·부호·천 단위 쉼표, 예 +2.3% / -0.8%). 닫힌형 해(구간별 선형)로 모든 가격을 확인해 기준 종가에 가장 가까운 해 하나만 표시합니다. 이미 그 서열이면 '현재', 이번 봉 종가만으로는 어떤 가격에서도 그 서열이 될 수 없으면 '1봉 내 불가'. 현재 행 라벨의 '(확정)' = 기준봉이 확정(마감)봉. 매매 신호가 아닌 참고용입니다.")
order_table_base = input.string("실시간봉", "Table Base Bar", options=["실시간봉", "완성봉"], group="Order Table", active=show_order_table, tooltip="실시간봉: 현재 형성 중 봉(차트 마지막 봉 [0])의 종가가 바뀐다고 가정해 그 봉의 스토캐스틱을 재계산(그 봉의 고가/저가 포함). 틱마다 갱신(의도된 리얼타임 리페인팅). '현재' 행은 차트 배경 서열과 일치.\n완성봉: 가장 최근 완성봉(형성 중=직전봉, 마감된 마지막 봉·바 리플레이=그 봉)이 기준. 다음 봉 종가 조건이며, 다음 봉의 고가/저가는 미지이므로 종가 하나로만 범위가 확장된다고 가정. 형성 중 봉의 틱 변동에 값 고정(리페인팅 없음).")
order_table_pos = input.string("우측 상단", "Table Position", options=["우측 상단", "우측 하단", "좌측 상단", "좌측 하단", "중앙 상단", "중앙 하단"], group="Order Table", active=show_order_table)
order_table_size = input.string("작게", "Text Size", options=["아주 작게", "작게", "보통", "크게"], group="Order Table", active=show_order_table)

[fast_k, fast_d, fast_raw] = stoch_pair(fast_length, fast_smooth_k, fast_smooth_d)
[mid_k, mid_d, mid_raw] = stoch_pair(mid_length, mid_smooth_k, mid_smooth_d)
[slow_k, slow_d, slow_raw] = stoch_pair(slow_length, slow_smooth_k, slow_smooth_d)

// 3중 시그널 정렬: 세 스토캐스틱 각각 %K vs 자기 %D가 같은 방향(alert 전용). 스토캐스틱 간 서열(stoch_*_order)과는 다른 개념.
all_bull_aligned = slow_k > slow_d and mid_k > mid_d and fast_k > fast_d
all_bear_aligned = slow_k < slow_d and mid_k < mid_d and fast_k < fast_d

// 스토캐스틱 간 서열(정배열/역배열): fast가 mid 위, mid가 slow 위이면 정배열(상승 서열).
// 대표값 = Basis 선택(기본 %K, 옵션 %D). 엄격 부등호.
stoch_bull_order = basis_use_d ? (fast_d > mid_d and mid_d > slow_d) : (fast_k > mid_k and mid_k > slow_k)
stoch_bear_order = basis_use_d ? (fast_d < mid_d and mid_d < slow_d) : (fast_k < mid_k and mid_k < slow_k)

// 웨이브 배경 = 스토캐스틱이 정확히 정배열/역배열일 때만.
bgcolor(stoch_bull_order ? color.new(#2E7D32, 80) : na, title="Bull Wave Background", editable=true)
bgcolor(stoch_bear_order ? color.new(#C62828, 80) : na, title="Bear Wave Background", editable=true)

// hline·bgcolor는 우측 프라이스 스케일 라벨을 만들지 않는다.
hline(overbought, "Overbought", color=color.new(color.gray, 0))
hline(trend_midline, "Trend Midline", color=color.new(color.gray, 65))
hline(oversold, "Oversold", color=color.new(color.gray, 0))

// 선 표기 = Basis로 선택한 한 종류(K선 또는 D선)만 3개 plot. display 기본(all) → 우측 프라이스 스케일 라벨은 Slow/Mid/Fast 3개뿐.
// 선택되지 않은 선은 plot하지 않는다(데이터 창에도 없음). 스타일은 K/D 공통(기존 %D 스타일: 투명도 0, 굵기 Slow 2·Mid 1·Fast 1).
plot(basis_use_d ? slow_d : slow_k, title="Slow", color=color.new(#1565C0, 0), linewidth=2)
plot(basis_use_d ? mid_d : mid_k, title="Mid", color=color.new(#00897B, 0), linewidth=1)
plot(basis_use_d ? fast_d : fast_k, title="Fast", color=color.new(#FB8C00, 0), linewidth=1)

alertcondition(all_bull_aligned, title="Triple Stochastic Bull Alignment", message="Triple Stochastic bullish alignment: fast, mid, slow are all above their signal lines")
alertcondition(all_bear_aligned, title="Triple Stochastic Bear Alignment", message="Triple Stochastic bearish alignment: fast, mid, slow are all below their signal lines")


// =========================
// 서열 전환 가격 테이블 (표시 전용 — 매매 신호 아님)
// =========================
// 질문: "목표봉 종가가 c로 마감하면 세 스토캐스틱 서열(Basis 기준)이 정배열/중립/역배열 중 무엇이 되는가?"
//  가상 종가 c는 목표봉의 raw 하나만 바꾼다(직전 이력은 확정값 그대로) → 각 선은 raw에 대해 affine:
//    line_j(c) = A_j + w_j·raw_j(c),  w_j = 1/(sK·sD)(D선) 또는 1/sK(K선)
//    raw_j(c)  = clamp(100·(c − ll_j) / R_j, 0, 100),  R_j = max(hh_j − ll_j, mintick)
//    (c가 hh 위면 고가가 c로 확장 → raw=100, ll 아래면 0 — "범위 확장" 정의와 동치)
//  - 실시간봉 모드: 목표봉 = 현재 봉 [0]. hh/ll = 현재 봉 포함 창(= ta.highest/lowest(length)),
//    A_j = line0_j − w_j·raw0_j (현재 값 기준 증분식) → c = close이면 현재 값과 정확히 일치.
//  - 완성봉 모드(cRSI 관례): 기준봉 = 가장 최근 완성봉(오프셋 k, 시간 기준 판정), 목표봉 = 그 다음 봉.
//    hh/ll = 기준봉에서 끝나는 직전 (length−1)봉 창(다음 봉 고가/저가는 미지 → c만 범위 확장),
//    A_j = (직전 sD−1개 %K 합 + 직전 sK−1개 raw 합/sK)/sD (K선: raw 합/sK). 형성 중 봉 값 미사용 → 리페인팅 없음.
//  닫힌형 해: f = fast − mid, g = mid − slow는 c에 대해 구간별 선형, 꺾이는 점 = {ll_j, ll_j + R_j}(최대 6개).
//    꺾이는 점으로 나눈 모든 구간에서 양 끝 f/g 값으로 부호 조건 부분구간을 선형 보간해 구하고,
//    그중 기준 종가에 가장 가까운 점을 틱으로 반올림(엄격 부등호 → 성립 쪽으로 1틱, 직접 재평가로 확인).
//    정배열 (f>0, g>0) / 역배열 (f<0, g<0) / 중립 (f>0, g<0) ∪ (f<0, g>0). 격자 탐색 없음, 계산은 barstate.islast에서만.
type StochLine
    float a    // 상수항 A
    float w    // raw 계수
    float ll   // 창 최저가(na = 창 없음 → raw 0 상수)
    float r    // 창 범위 R = max(hh − ll, mintick)

f_lineAt(StochLine s, float c) =>
    raw = na(s.ll) ? 0.0 : math.max(0.0, math.min(100.0, 100.0 * (c - s.ll) / s.r))
    s.a + s.w * raw

// 가상 종가 c에서 서열: 1=정배열, -1=역배열, 0=중립 (stoch_*_order와 같은 엄격 부등호)
f_orderAt(StochLine f, StochLine m, StochLine s, float c) =>
    fv = f_lineAt(f, c)
    mv = f_lineAt(m, c)
    sv = f_lineAt(s, c)
    fv > mv and mv > sv ? 1 : fv < mv and mv < sv ? -1 : 0

// 선형 h(a)=ha, h(b)=hb에서 sg·h > 0인 [a, b] 부분구간 → [lo, hi] (없으면 na)
f_posPart(float ha, float hb, float a, float b, float sg) =>
    pa = sg * ha
    pb = sg * hb
    float lo = na
    float hi = na
    if pa > 0 and pb > 0
        lo := a
        hi := b
    else if pa > 0 or pb > 0
        rt = a + (b - a) * pa / (pa - pb)
        lo := pa > 0 ? a : rt
        hi := pa > 0 ? rt : b
    [lo, hi]

// 부분구간 [lo, hi] 안에서 기준 틱 n0에 가장 가까운, 서열 T가 실제 성립하는 틱(없으면 na)
f_nearTick(StochLine f, StochLine m, StochLine s, float lo, float hi, float n0, int T) =>
    mt = syminfo.mintick
    float res = na
    if not na(lo) and hi >= lo
        float t = na
        if n0 * mt < lo
            t := math.ceil(lo / mt - 1e-9)
            if f_orderAt(f, m, s, t * mt) != T
                t += 1
            if t * mt > hi + mt
                t := na
        else if n0 * mt > hi
            t := math.floor(hi / mt + 1e-9)
            if f_orderAt(f, m, s, t * mt) != T
                t -= 1
            if t * mt < lo - mt
                t := na
        else
            t := f_orderAt(f, m, s, (n0 + 1) * mt) == T ? n0 + 1 : n0 - 1
        if not na(t) and t > 0 and f_orderAt(f, m, s, t * mt) == T
            res := t
    res

// 부호 포함 % (cRSI f_crossPct와 동일: 소수 1자리, 천 단위 쉼표, 0이면 "0.0%")
f_orderPct(float v) =>
    n = math.round(v * 10)
    n == 0 ? "0.0%" : (n > 0 ? "+" : "") + str.tostring(n / 10.0, "#,##0.0") + "%"

// 완성봉 모드용 이력 창: [0] 끝(마지막 봉이 끝났을 때) / [1] 끝(형성 중) — 전역에서 매 봉 계산(정적 [1] 참조)
[f_hh0, f_ll0, f_rs0, f_ks0, f_hh1, f_ll1, f_rs1, f_ks1] = stoch_hist(fast_length, fast_smooth_k, fast_smooth_d, fast_raw, fast_k)
[m_hh0, m_ll0, m_rs0, m_ks0, m_hh1, m_ll1, m_rs1, m_ks1] = stoch_hist(mid_length, mid_smooth_k, mid_smooth_d, mid_raw, mid_k)
[s_hh0, s_ll0, s_rs0, s_ks0, s_hh1, s_ll1, s_rs1, s_ks1] = stoch_hist(slow_length, slow_smooth_k, slow_smooth_d, slow_raw, slow_k)
// 실시간봉 모드용 현재 봉 포함 창(= stoch_pair 내부와 같은 ta.highest/lowest)
f_hhC = ta.highest(high, fast_length)
f_llC = ta.lowest(low, fast_length)
m_hhC = ta.highest(high, mid_length)
m_llC = ta.lowest(low, mid_length)
s_hhC = ta.highest(high, slow_length)
s_llC = ta.lowest(low, slow_length)
// 서열·종가의 직전 봉 값(완성봉 모드 형성 중 기준봉 = [1]) — 전역 정적 참조
order_state = stoch_bull_order ? 1 : stoch_bear_order ? -1 : 0
order_state1 = order_state[1]
close1 = close[1]
order_ready_len = math.max(fast_length + fast_smooth_k + fast_smooth_d, mid_length + mid_smooth_k + mid_smooth_d, slow_length + slow_smooth_k + slow_smooth_d)

// 완성봉 모드 선 계수: 직전 이력 합 → A, 창 극값 → ll/R
f_histLine(float hh, float ll, float rs, float ks, int sk, int sd, bool useD) =>
    a = useD ? (ks + rs / sk) / sd : rs / sk
    w = useD ? 1.0 / (sk * sd) : 1.0 / sk
    StochLine.new(a, w, ll, na(ll) ? na : math.max(hh - ll, syminfo.mintick))

// 실시간봉 모드 선 계수: 현재 값 기준 증분식 A = line0 − w·raw0
f_liveLine(float line0, float raw0, float hh, float ll, int sk, int sd, bool useD) =>
    w = useD ? 1.0 / (sk * sd) : 1.0 / sk
    StochLine.new(line0 - w * raw0, w, ll, math.max(hh - ll, syminfo.mintick))

// 스타일: cRSI 밴드 교차 가격 테이블과 동일 — 헤더 없음, 2열(라벨/값), 테두리 #555555·두께 1, 전 셀 불투명 단색, 흰 글자.
//  라벨 셀 = 기본색, 값 셀 = 한 톤 밝은 동계열. 정배열=녹 #2E7D32/#388E3C, 중립=검정 #000000/#1C1C1C, 역배열=적 #C62828/#D32F2F.
//  '1봉 내 불가'·'-'(준비 안 됨) 행은 어두운 저채도 톤 + 회색 글자 #9E9E9E. 현재 서열 행은 라벨 "▶ " 접두 + 굵게.
orderPos = order_table_pos == "우측 상단" ? position.top_right : order_table_pos == "좌측 상단" ? position.top_left : order_table_pos == "좌측 하단" ? position.bottom_left : order_table_pos == "중앙 상단" ? position.top_center : order_table_pos == "중앙 하단" ? position.bottom_center : position.bottom_right
orderTxt = order_table_size == "아주 작게" ? size.tiny : order_table_size == "보통" ? size.normal : order_table_size == "크게" ? size.large : size.small
var table orderTable = table.new(orderPos, 2, 3, border_width=1, border_color=#555555)
if show_order_table and barstate.islast
    bool isRealtime = order_table_base == "실시간봉"
    // 기준 오프셋 k: cRSI와 동일(실시간봉=0 / 완성봉=끝난 마지막봉 0, 형성 중 1, time_close na면 isconfirmed 폴백)
    bool obBarClosed = not na(time_close) ? timenow >= time_close : barstate.isconfirmed
    int obK = isRealtime ? 0 : (obBarClosed or barstate.isconfirmed) ? 0 : 1
    // 기준봉이 확정봉인가(완성봉 모드는 항상, 실시간봉 모드는 마지막 봉이 끝났을 때) → 현재 행 라벨에 "(확정)"
    bool baseConfirmed = not isRealtime or obBarClosed or barstate.isconfirmed
    float base = obK == 1 ? close1 : close
    int refState = obK == 1 ? order_state1 : order_state
    bool h1 = obK == 1
    StochLine fL = na
    StochLine mL = na
    StochLine sL = na
    if isRealtime
        fL := f_liveLine(basis_use_d ? fast_d : fast_k, fast_raw, f_hhC, f_llC, fast_smooth_k, fast_smooth_d, basis_use_d)
        mL := f_liveLine(basis_use_d ? mid_d : mid_k, mid_raw, m_hhC, m_llC, mid_smooth_k, mid_smooth_d, basis_use_d)
        sL := f_liveLine(basis_use_d ? slow_d : slow_k, slow_raw, s_hhC, s_llC, slow_smooth_k, slow_smooth_d, basis_use_d)
    else
        fL := f_histLine(h1 ? f_hh1 : f_hh0, h1 ? f_ll1 : f_ll0, h1 ? f_rs1 : f_rs0, h1 ? f_ks1 : f_ks0, fast_smooth_k, fast_smooth_d, basis_use_d)
        mL := f_histLine(h1 ? m_hh1 : m_hh0, h1 ? m_ll1 : m_ll0, h1 ? m_rs1 : m_rs0, h1 ? m_ks1 : m_ks0, mid_smooth_k, mid_smooth_d, basis_use_d)
        sL := f_histLine(h1 ? s_hh1 : s_hh0, h1 ? s_ll1 : s_ll0, h1 ? s_rs1 : s_rs0, h1 ? s_ks1 : s_ks0, slow_smooth_k, slow_smooth_d, basis_use_d)
    bool ready = bar_index - obK >= order_ready_len and not na(base) and base > 0 and not na(fL.a) and not na(mL.a) and not na(sL.a)
    // 행 텍스트: 인덱스 0=정배열(T=1), 1=중립(T=0), 2=역배열(T=-1)
    array<string> vals = array.from("-", "-", "-")
    if ready
        mt = syminfo.mintick
        float n0 = math.round(base / mt)
        // 보합(c = 기준 종가) 서열: 실시간봉은 현재 서열(증분식이 c=close에서 정확히 일치하므로 실제 시리즈 값 사용)
        int flatState = isRealtime ? refState : f_orderAt(fL, mL, sL, n0 * mt)
        // 꺾이는 점(ll, ll+R) 정렬 + 바깥 상수 구간을 덮는 양 끝(최소 1틱 / 최대점 + 기준 종가)
        array<float> pts = array.new_float(0)
        for L in array.from(fL, mL, sL)
            if not na(L.ll)
                array.push(pts, L.ll)
                array.push(pts, L.ll + L.r)
        array.push(pts, base)
        pMax = array.max(pts)
        array.push(pts, mt)
        array.push(pts, pMax + base)
        array.sort(pts, order.ascending)
        array<float> best = array.new_float(3, na)
        for i = 0 to array.size(pts) - 2
            a = array.get(pts, i)
            b = array.get(pts, i + 1)
            if b > a and b > 0
                fa = f_lineAt(fL, a) - f_lineAt(mL, a)
                fb = f_lineAt(fL, b) - f_lineAt(mL, b)
                ga = f_lineAt(mL, a) - f_lineAt(sL, a)
                gb = f_lineAt(mL, b) - f_lineAt(sL, b)
                // 조합 0: (f>0,g>0)=정배열, 1: (f<0,g<0)=역배열, 2: (f>0,g<0)=중립, 3: (f<0,g>0)=중립
                for cmb = 0 to 3
                    sf = cmb == 0 or cmb == 2 ? 1.0 : -1.0
                    sgg = cmb == 0 or cmb == 3 ? 1.0 : -1.0
                    int T = cmb == 0 ? 1 : cmb == 1 ? -1 : 0
                    if T != flatState
                        [flo, fhi] = f_posPart(fa, fb, a, b, sf)
                        [glo, ghi] = f_posPart(ga, gb, a, b, sgg)
                        if not na(flo) and not na(glo)
                            lo = math.max(flo, glo)
                            hi = math.min(fhi, ghi)
                            t = f_nearTick(fL, mL, sL, lo, hi, n0, T)
                            idx = 1 - T
                            cb = array.get(best, idx)
                            // 가장 가까운 해(동거리면 상승 쪽)
                            if not na(t) and (na(cb) or math.abs(t - n0) < math.abs(cb - n0) or (math.abs(t - n0) == math.abs(cb - n0) and t > cb))
                                array.set(best, idx, t)
        for idx = 0 to 2
            int T = 1 - idx
            if T == flatState
                // 보합으로 성립: 기준봉 서열과 같으면 '현재', 아니면(완성봉 모드에서 다음 봉 보합 시 서열이 바뀌는 경우) 0.0%
                array.set(vals, idx, T == refState ? "현재" : "0.0%")
            else
                nb = array.get(best, idx)
                array.set(vals, idx, na(nb) ? "1봉 내 불가" : f_orderPct((nb * mt - base) / base * 100))
    color GRN       = #2E7D32   // 녹 라벨
    color GRN_V     = #388E3C   // 녹 값 — 한 톤 밝게
    color GRN_OFF   = #1B3A1E   // 녹 라벨(비활성)
    color GRN_OFF_V = #142B17   // 녹 값(비활성)
    color BLK       = #000000   // 중립 라벨(검정)
    color BLK_V     = #1C1C1C   // 중립 값 — 한 톤 밝게
    color BLK_OFF   = #000000   // 중립 라벨(비활성) — 배경 유지, 회색 글자로 구분
    color BLK_OFF_V = #0E0E0E   // 중립 값(비활성)
    color RED       = #C62828   // 적 라벨
    color RED_V     = #D32F2F   // 적 값 — 한 톤 밝게
    color RED_OFF   = #3E1A1A   // 적 라벨(비활성)
    color RED_OFF_V = #2E1414   // 적 값(비활성)
    color TXT_OFF   = #9E9E9E   // 비활성 행 글자(회색)
    array<string> names = array.from("정배열", "중립", "역배열")
    array<string> tips = array.from("정배열(fast > mid > slow, Basis 기준선). 값 = 목표봉 종가가 기준 종가 대비 이 %로 마감하면 정배열이 되는 가장 가까운 지점(틱 반올림 가격, 닫힌형 해). '현재' = 이미 정배열, '1봉 내 불가' = 이번 봉 종가만으로는 어떤 가격에서도 불가. 종가 기준 참고값(매매 신호 아님).", "중립(정배열도 역배열도 아닌 서열). 현재가 정배열/역배열이면 그 서열을 벗어나는 가장 가까운 지점. 값 = 기준 종가 대비 %(틱 반올림 가격, 닫힌형 해). '현재' = 이미 중립, '1봉 내 불가' = 이번 봉 종가만으로는 불가. 종가 기준 참고값(매매 신호 아님).", "역배열(fast < mid < slow, Basis 기준선). 값 = 목표봉 종가가 기준 종가 대비 이 %로 마감하면 역배열이 되는 가장 가까운 지점(틱 반올림 가격, 닫힌형 해). '현재' = 이미 역배열, '1봉 내 불가' = 이번 봉 종가만으로는 어떤 가격에서도 불가. 종가 기준 참고값(매매 신호 아님).")
    for idx = 0 to 2
        int T = 1 - idx
        string v = array.get(vals, idx)
        bool on = v != "-" and v != "1봉 내 불가"
        bool cur = T == refState and v != "-"
        color cL = idx == 0 ? (on ? GRN : GRN_OFF) : idx == 1 ? (on ? BLK : BLK_OFF) : (on ? RED : RED_OFF)
        color cV = idx == 0 ? (on ? GRN_V : GRN_OFF_V) : idx == 1 ? (on ? BLK_V : BLK_OFF_V) : (on ? RED_V : RED_OFF_V)
        color tc = on ? color.white : TXT_OFF
        fmt = cur ? text.format_bold : text.format_none
        string lbl = (cur ? "▶ " : "") + array.get(names, idx) + (cur and baseConfirmed ? " (확정)" : "")
        table.cell(orderTable, 0, idx, lbl, text_color=tc, bgcolor=cL, text_size=orderTxt, text_formatting=fmt, tooltip=array.get(tips, idx))
        table.cell(orderTable, 1, idx, v, text_color=tc, bgcolor=cV, text_size=orderTxt, text_formatting=fmt)
